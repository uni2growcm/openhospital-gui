    SELECT
        COUNT(*) 
    FROM
        OH_PATIENT as p 
    LEFT JOIN
        (SELECT
            * 
        FROM
            OH_ADMISSION 
        WHERE
            ADM_IN = 1   
            AND ((ADM_DELETED='N') 
            OR (ADM_DELETED IS NULL))) as a   
            ON p.PAT_ID = a.ADM_PAT_ID 
    LEFT JOIN
        OH_COUNTRY as c   
            ON p.PAT_COUNTRY_ID = c.CNT_ID 
    WHERE
        (
            (
                p.PAT_DELETED='N'
            ) 
            OR (
                p.PAT_DELETED IS NULL
            )
        ) 
        AND (
            lower(concat_ws(' ', p.PAT_ID, p.PAT_SNAME, p.PAT_FNAME, p.PAT_NAME, p.PAT_NOTE, p.PAT_TAXCODE, p.PAT_CITY, p.PAT_ADDR, p.PAT_TELE)) LIKE ?
        ) (org.hibernate.engine.jdbc.spi.SqlStatementLogger.logStatement(SqlStatementLogger.java:135))
[03/Jul/2026 10:59:00] [admin:admin] TRACE - binding parameter (1:VARCHAR) <- [%] (org.hibernate.type.descriptor.JdbcBindingLogging.logBinding(JdbcBindingLogging.java:24))
[03/Jul/2026 10:59:00] [admin:admin] DEBUG - 
    SELECT
        * 
    FROM
        OH_PATIENT as p 
    LEFT JOIN
        (SELECT
            * 
        FROM
            OH_ADMISSION 
        WHERE
            ADM_IN = 1   
            AND ((ADM_DELETED='N') 
            OR (ADM_DELETED IS NULL))) as a   
            ON p.PAT_ID = a.ADM_PAT_ID 
    LEFT JOIN
        OH_COUNTRY as c   
            ON p.PAT_COUNTRY_ID = c.CNT_ID 
    WHERE
        (
            (
                p.PAT_DELETED='N'
            ) 
            OR (
                p.PAT_DELETED IS NULL
            )
        ) 
        AND (
            lower(concat_ws(' ', p.PAT_ID, p.PAT_SNAME, p.PAT_FNAME, p.PAT_NAME, p.PAT_NOTE, p.PAT_TAXCODE, p.PAT_CITY, p.PAT_ADDR, p.PAT_TELE)) LIKE ?
        ) 
    ORDER BY
        p.PAT_ID DESC 
    limit
        ? (org.hibernate.engine.jdbc.spi.SqlStatementLogger.logStatement(SqlStatementLogger.java:135))
