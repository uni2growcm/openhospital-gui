	<parameter name="state2" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT	BLI_ITEM_GROUP,
	BLI_ITEM_DESC,
	SUM(IF(b.BLL_PARENT_ID IS NULL, BLI_QTY, 0)) AS QTY,
	SUM(IF(b.BLL_PARENT_ID IS NOT NULL, BLI_QTY, 0)) AS REFUNDED_QTY,
	SUM(IF(b.BLL_PARENT_ID IS NULL, (BLI_QTY * BLI_ITEM_AMOUNT), 0)) AS AMOUNT,
	SUM(IF(b.BLL_PARENT_ID IS NOT NULL, (BLI_QTY * BLI_ITEM_AMOUNT), 0)) AS REFUNDED_AMOUNT,
	CASE
		WHEN bli.BLI_ITEM_GROUP = "MED"
		THEN (SELECT MEDT.MDSRT_DESC FROM OH_MEDICALDSR MED JOIN OH_MEDICALDSRTYPE MEDT ON MEDT.MDSRT_ID_A = MED.MDSR_MDSRT_ID_A WHERE MED.MDSR_ID = bli.BLI_ITEM_ID)
		WHEN bli.BLI_ITEM_GROUP = "EXA"
		THEN (SELECT EXAT.EXC_DESC FROM OH_EXAM EXA JOIN OH_EXAMTYPE EXAT ON EXAT.EXC_ID_A = EXA.EXA_EXC_ID_A WHERE EXA.EXA_ID_A = bli.BLI_ITEM_ID)
		WHEN bli.BLI_ITEM_GROUP = "OPE"
		THEN (SELECT OPET.OCL_DESC FROM OH_OPERATION OPE JOIN OH_OPERATIONTYPE OPET ON OPET.OCL_ID_A = OPE.OPE_OCL_ID_A WHERE OPE.OPE_ID_A = bli.BLI_ITEM_ID)
		ELSE "AUTRES"
	END AS BLI_ITEM_TYPE
FROM OH_BILLITEMS bli
JOIN OH_BILLS b ON BLI_ID_BILL = b.BLL_ID
WHERE (b.BLL_STATUS = $P{state} OR b.BLL_STATUS = $P{state2})
AND DATE(b.BLL_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
GROUP BY BLI_ITEM_DESC
ORDER BY BLI_ITEM_GROUP, BLI_ITEM_TYPE, BLI_ITEM_DESC ASC]]>
	</queryString>
