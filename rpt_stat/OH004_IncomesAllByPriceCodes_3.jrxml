		<defaultValueExpression><![CDATA["ALL"]]></defaultValueExpression>
	</parameter>
	<parameter name="year" class="java.lang.Integer" isForPrompting="true"/>
	<parameter name="ward_id" class="java.lang.String" isForPrompting="true">
		<defaultValueExpression><![CDATA["ALL"]]></defaultValueExpression>
	</parameter>

	<queryString>
		<![CDATA[SELECT 
    bli.BLI_ITEM_GROUP,
    bli.BLI_ITEM_DESC,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 1 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_JANUARY,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 1 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_JANUARY,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 2 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_FEBRUARY,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 2 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_FEBRUARY,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 3 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_MARCH,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 3 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_MARCH,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 4 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_APRIL,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 4 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_APRIL,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 5 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_MAY,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 5 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_MAY,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 6 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_JUNE,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 6 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_JUNE,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 7 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_JULY,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 7 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_JULY,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 8 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_AUGUST,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 8 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_AUGUST,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 9 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_SEPTEMBER,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 9 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_SEPTEMBER,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 10 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_OCTOBER,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 10 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_OCTOBER,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 11 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_NOVEMBER,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 11 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_NOVEMBER,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 12 THEN IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY) ELSE 0 END) AS COUNT_DECEMBER,
    SUM(CASE WHEN MONTH(b.BLL_DATE) = 12 THEN IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT)) ELSE 0 END) AS AMOUNT_DECEMBER,
    SUM(IF(b.BLL_PARENT_ID IS NULL, bli.BLI_QTY, -bli.BLI_QTY)) AS TOTAL_YEAR_COUNT,
    SUM(IF(b.BLL_PARENT_ID IS NULL, (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT), -(bli.BLI_QTY * bli.BLI_ITEM_AMOUNT))) AS TOTAL_YEAR_AMOUNT
FROM OH_BILLITEMS bli
JOIN OH_BILLS b ON bli.BLI_ID_BILL = b.BLL_ID
LEFT JOIN OH_ADMISSION adm ON b.BLL_ADM_ID = adm.ADM_ID
WHERE YEAR(b.BLL_DATE) = $P{year}
  AND b.BLL_STATUS <> 'D' AND b.BLL_STATUS <> 'X'
  AND ($P{ward_id} = 'ALL' OR COALESCE(b.BLL_WARD_ID, adm.ADM_WRD_ID_A) = $P{ward_id})
GROUP BY bli.BLI_ITEM_GROUP, bli.BLI_ITEM_DESC
ORDER BY bli.BLI_ITEM_GROUP, bli.BLI_ITEM_DESC ASC]]>
	</queryString>

