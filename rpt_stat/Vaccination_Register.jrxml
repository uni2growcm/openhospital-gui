<?xml version="1.0" encoding="UTF-8"?>
<!-- Created for Open Hospital - Vaccination Register -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Vaccination_Register" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" resourceBundle="Vaccination_Register" whenResourceMissingType="Key" isSummaryWithPageHeaderAndFooter="true" uuid="b1100001-0001-0001-0001-000000000001">
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="java.text.SimpleDateFormat"/>
	<import value="java.util.Date"/>
	<subDataset name="VaccineBreakdownDataset" uuid="b1100001-0001-0001-0001-000000000002">
		<parameter name="fromdate" class="java.util.Date"/>
		<parameter name="todate" class="java.util.Date"/>
		<parameter name="TOTAL_COUNT" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[SELECT
				COALESCE(vt.VACT_DESC, v.VAC_VACT_ID_A, '-') AS VACCINE_TYPE_NAME,
				v.VAC_ID_A AS VACCINE_CODE,
				v.VAC_DESC AS VACCINE_NAME,
				COUNT(pv.PAV_ID) AS DOSE_COUNT
			FROM OH_PATIENTVACCINE pv
			JOIN OH_VACCINE v ON v.VAC_ID_A = pv.PAV_VAC_ID_A
			LEFT JOIN OH_VACCINETYPE vt ON vt.VACT_ID_A = v.VAC_VACT_ID_A
			WHERE DATE(pv.PAV_DATE) >= DATE($P{fromdate})
				AND DATE(pv.PAV_DATE) <= DATE($P{todate})
			GROUP BY v.VAC_ID_A, v.VAC_DESC, vt.VACT_DESC, v.VAC_VACT_ID_A
			ORDER BY VACCINE_TYPE_NAME ASC, DOSE_COUNT DESC, VACCINE_NAME ASC]]>
		</queryString>
		<field name="VACCINE_TYPE_NAME" class="java.lang.String"/>
		<field name="VACCINE_CODE" class="java.lang.String"/>
		<field name="VACCINE_NAME" class="java.lang.String"/>
		<field name="DOSE_COUNT" class="java.lang.Long"/>
	</subDataset>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="Hospital" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Currency" class="java.lang.String" isForPrompting="false"/>
	<parameter name="PeriodLabel" class="java.lang.String" isForPrompting="false"/>
	<parameter name="HOSPITAL_LOGO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./rsc/images/logo_hospital.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="OH_LOGO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./rsc/images/logo_report.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="HEADER_BUNDLE" class="java.util.ResourceBundle" isForPrompting="false">
		<defaultValueExpression><![CDATA[java.util.ResourceBundle.getBundle("ReportHeader", $P{REPORT_LOCALE} != null ? $P{REPORT_LOCALE} : java.util.Locale.getDefault())]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
			pv.PAV_ID AS VACCINE_ID,
			pv.PAV_YPROG AS DOSE_NUMBER,
			DATE_FORMAT(pv.PAV_DATE, '%d/%m/%Y') AS VACCINE_DATE_STR,
			COALESCE(pv.PAV_VILLAGE, '') AS VILLAGE,
			p.PAT_ID AS PATIENT_ID,
			p.PAT_NAME AS PATIENT_NAME,
			p.PAT_SEX AS PATIENT_SEX,
			IF(p.PAT_BDATE IS NOT NULL, TIMESTAMPDIFF(YEAR, p.PAT_BDATE, pv.PAV_DATE), p.PAT_AGE) AS PATIENT_AGE,
			COALESCE(p.PAT_NEXT_KIN, '') AS PATIENT_NEXT_KIN,
			COALESCE(p.PAT_TELE, '') AS PATIENT_TELE,
			COALESCE(vt.VACT_DESC, '-') AS VACCINE_TYPE,
			v.VAC_ID_A AS VACCINE_CODE,
			v.VAC_DESC AS VACCINE_NAME
		FROM OH_PATIENTVACCINE pv
		JOIN OH_PATIENT p ON p.PAT_ID = pv.PAV_PAT_ID
		JOIN OH_VACCINE v ON v.VAC_ID_A = pv.PAV_VAC_ID_A
		LEFT JOIN OH_VACCINETYPE vt ON vt.VACT_ID_A = v.VAC_VACT_ID_A
		WHERE DATE(pv.PAV_DATE) >= DATE($P{fromdate})
			AND DATE(pv.PAV_DATE) <= DATE($P{todate})
		ORDER BY pv.PAV_DATE ASC, pv.PAV_ID ASC]]>
	</queryString>
	<field name="VACCINE_ID" class="java.lang.Integer"/>
	<field name="DOSE_NUMBER" class="java.lang.Integer"/>
	<field name="VACCINE_DATE_STR" class="java.lang.String"/>
	<field name="VILLAGE" class="java.lang.String"/>
	<field name="PATIENT_ID" class="java.lang.Integer"/>
	<field name="PATIENT_NAME" class="java.lang.String"/>
	<field name="PATIENT_SEX" class="java.lang.String"/>
	<field name="PATIENT_AGE" class="java.lang.Integer"/>
	<field name="PATIENT_NEXT_KIN" class="java.lang.String"/>
	<field name="PATIENT_TELE" class="java.lang.String"/>
	<field name="VACCINE_TYPE" class="java.lang.String"/>
	<field name="VACCINE_CODE" class="java.lang.String"/>
	<field name="VACCINE_NAME" class="java.lang.String"/>
	<variable name="TOTAL_COUNT" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{VACCINE_ID}]]></variableExpression>
	</variable>
