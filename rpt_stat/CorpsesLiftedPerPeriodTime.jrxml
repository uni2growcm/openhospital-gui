	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="Hospital" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="IMAGE_PATH" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT	1 AS DEATH_COUNT,
	DATE_FORMAT(D.DTH_DISCHARGE_DATE, '%T') AS TIME, 
	P.PAT_FNAME, 
	P.PAT_SNAME,  
	D.DTH_ADMISSION_DATE AS DECES_DATE_ENTREE,
	DATE(D.DTH_DISCHARGE_DATE) AS DECES_DATE_SORTIE,
	D.DTH_DECLARING_NAME AS DECES_NOM_DECLARANT,
	D.DTH_FAMILY_NAME AS DECES_NOM_FAMILLE
FROM OH_DEATH D
LEFT JOIN OH_PATIENT P ON D.DTH_PAT_ID = P.PAT_ID
LEFT JOIN OH_DEATHREASON M ON D.DTH_DTHR_ID = M.DTHR_ID
WHERE D.DTH_DELETED = 0
  AND DATE(D.DTH_DISCHARGE_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
ORDER BY D.DTH_DISCHARGE_DATE ASC]]>
	</queryString>
	<field name="DEATH_COUNT" class="java.lang.Integer"/>
	<field name="TIME" class="java.lang.String"/>
	<field name="PAT_FNAME" class="java.lang.String"/>
	<field name="PAT_SNAME" class="java.lang.String"/>
	<field name="DECES_DATE_ENTREE" class="java.sql.Timestamp"/>
	<field name="DECES_DATE_SORTIE" class="java.util.Date"/>
	<field name="DECES_NOM_DECLARANT" class="java.lang.String"/>
	<field name="DECES_NOM_FAMILLE" class="java.lang.String"/>
	<variable name="DEATH_COUNT_TOTAL" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{DEATH_COUNT}]]></variableExpression>
	</variable>
	<variable name="GRP_TOTAL" class="java.lang.Integer" resetType="Group" resetGroup="BELIFTED_GROUP" calculation="Sum">
