	<parameter name="HEADER_BUNDLE" class="java.util.ResourceBundle" isForPrompting="false">
		<defaultValueExpression><![CDATA[java.util.ResourceBundle.getBundle("ReportHeader", $P{REPORT_LOCALE} != null ? $P{REPORT_LOCALE} : java.util.Locale.getDefault())]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT	1 AS DEATH_COUNT,
	DATE_FORMAT(D.DTH_DISCHARGE_DATE, '%T') AS TIME, 
	P.PAT_FNAME, 
	P.PAT_SNAME,  
	D.DTH_ADMISSION_DATE AS DECES_DATE_ENTREE,
	DATE(D.DTH_DISCHARGE_DATE) AS DECES_DATE_SORTIE,
	D.DTH_DECLARING_NAME AS DECES_NOM_DECLARANT,
	D.DTH_FAMILY_NAME AS DECES_NOM_FAMILLE
FROM OH_DEATH D
LEFT JOIN OH_PATIENT P ON D.DTH_PAT_ID = P.PAT_ID
LEFT JOIN OH_DEATHREASON M ON D.DTH_DTHR_ID = M.DTHR_ID
WHERE D.DTH_DELETED = 0
  AND (
    ($P{state} = 'LIFTED' AND D.DTH_DISCHARGE_DATE IS NOT NULL AND DATE(D.DTH_DISCHARGE_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate}))
    OR
    ($P{state} = 'NOT_LIFTED' AND D.DTH_DISCHARGE_DATE IS NULL AND DATE(D.DTH_ADMISSION_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate}))
    OR
    (($P{state} = 'ALL' OR $P{state} IS NULL) AND (
      (D.DTH_DISCHARGE_DATE IS NOT NULL AND DATE(D.DTH_DISCHARGE_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate}))
      OR
      (D.DTH_DISCHARGE_DATE IS NULL AND DATE(D.DTH_ADMISSION_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate}))
    ))
  )
ORDER BY D.DTH_DISCHARGE_DATE ASC, D.DTH_ADMISSION_DATE ASC]]>
	</queryString>
