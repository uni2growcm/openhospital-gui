	<queryString>
		<![CDATA[SELECT DATE(PAT_TIMESTAMP) DATE, COUNT(*) NUMBER
FROM OH_PATIENT
WHERE DATE(PAT_TIMESTAMP) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
AND PAT_DELETED = 'N'
GROUP BY DATE(PAT_TIMESTAMP)]]>
	</queryString>
