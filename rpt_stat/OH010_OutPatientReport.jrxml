	<variable name="DAY_UNDER_FIVE" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{OPD_DATE}.getHours() < 17 && $F{OPD_DATE}.getHours() >= 8) &&
$F{PAT_AGE}.intValue() <= 5 ? new Integer(1) : new Integer(0)]]></variableExpression>
	</variable>
	<variable name="DAY_OVER_TEN" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{OPD_DATE}.getHours() < 17 && $F{OPD_DATE}.getHours() >= 8) &&
$F{PAT_AGE}.intValue() > 10 ? new Integer(1) : new Integer(0)]]></variableExpression>
	</variable>
	<variable name="DAY_SIX_TO_TEN" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{OPD_DATE}.getHours() < 17 && $F{OPD_DATE}.getHours() >= 8) &&
($F{PAT_AGE}.intValue() >= 6 && $F{PAT_AGE}.intValue() <= 10) ?
new Integer(1) : new Integer(0)]]></variableExpression>
	</variable>
	<variable name="NIGHT_UNDER_FIVE" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{OPD_DATE}.getHours() >= 17 || $F{OPD_DATE}.getHours() < 8) &&
$F{PAT_AGE}.intValue() <= 5 ? new Integer(1) : new Integer(0)]]></variableExpression>
	</variable>
	<variable name="NIGHT_SIX_TO_TEN" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{OPD_DATE}.getHours() >= 17 || $F{OPD_DATE}.getHours() < 8) &&
($F{PAT_AGE}.intValue() >= 6 && $F{PAT_AGE}.intValue() <= 10) ?
new Integer(1) : new Integer(0)]]></variableExpression>
	</variable>
	<variable name="NIGHT_OVER_TEN" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{OPD_DATE}.getHours() >= 17 || $F{OPD_DATE}.getHours() < 8) &&
$F{PAT_AGE}.intValue() > 10 ? new Integer(1) : new Integer(0)]]></variableExpression>
	</variable>
	<variable name="TOTAL_NIGHT" class="java.lang.Integer">
		<variableExpression><![CDATA[new Integer($V{NIGHT_UNDER_FIVE}.intValue()+$V{NIGHT_OVER_TEN}.intValue()+$V{NIGHT_SIX_TO_TEN}.intValue())]]></variableExpression>
	</variable>
	<variable name="TOTAL_DAY" class="java.lang.Integer">
		<variableExpression><![CDATA[new Integer($V{DAY_UNDER_FIVE}.intValue()+$V{DAY_OVER_TEN}.intValue()+$V{DAY_SIX_TO_TEN}.intValue())]]></variableExpression>
	</variable>
	<variable name="TOTAL" class="java.lang.Integer">
		<variableExpression><![CDATA[new Integer($V{TOTAL_NIGHT}.intValue()+$V{TOTAL_DAY}.intValue())]]></variableExpression>
	</variable>
	<variable name="DAY_NEW_ATTENDANCE" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{OPD_DATE}.getHours() < 17 && $F{OPD_DATE}.getHours() >= 8) &&
$F{ATTENDANCE}.equals( "New" ) ? new Integer(1) : new Integer(0)]]></variableExpression>
	</variable>
	<variable name="DAY_RE_ATTENDANCE" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{OPD_DATE}.getHours() < 17 && $F{OPD_DATE}.getHours() >= 8) &&
$F{ATTENDANCE}.equals( "Re" ) ? new Integer(1) : new Integer(0)]]></variableExpression>
	</variable>
	<variable name="NIGHT_NEW_ATTENDANCE" class="java.lang.Integer" calculation="Sum">
