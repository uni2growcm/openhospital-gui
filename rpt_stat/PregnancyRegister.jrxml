	<property name="ireport.encoding" value="UTF-8"/>
	<import value="java.text.SimpleDateFormat"/>
	<import value="java.util.Date"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="Hospital" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Currency" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
	pr.PRG_ID,
	pr.PRG_DATE,
	DATE_FORMAT(pr.PRG_DATE, '%d/%m/%Y') AS PRG_DATE_STR,
	pat.PAT_ID,
	pat.PAT_NAME,
	IF(pat.PAT_BDATE IS NOT NULL, TIMESTAMPDIFF(YEAR, pat.PAT_BDATE, CURDATE()), pat.PAT_AGE) AS PAT_AGE,
	CONCAT(COALESCE(pat.PAT_TELE, '-'), IF(pat.PAT_CITY IS NOT NULL AND pat.PAT_CITY != '', CONCAT(' (', pat.PAT_CITY, ')'), '')) AS PAT_CONTACT,
	DATE_FORMAT(pr.PRG_LMP, '%d/%m/%Y') AS PRG_LMP_STR,
	DATE_FORMAT(COALESCE(pr.PRG_EDD_LMP, pr.PRG_EDD_SCAN), '%d/%m/%Y') AS PRG_EDD_STR,
	CONCAT('G', COALESCE(pr.PRG_GRAVIDITY, 0), ' P', COALESCE(pr.PRG_PARITY, 0), ' A', COALESCE(pr.PRG_MISSCARRIAGES, 0), ' EV', COALESCE(pr.PRG_LIVING_CHILDREN, 0)) AS OBS_FORMULA,
	COALESCE(pr.PRG_RISK_LEVEL, 'LOW') AS PRG_RISK_LEVEL,
	(SELECT COUNT(*) FROM OH_PREGNANCYVISIT pv WHERE pv.PRGV_PRG_ID = pr.PRG_ID AND pv.PRGV_ACTIVE = 1) AS NB_VISITS,
	DATE_FORMAT((SELECT MAX(pv.PRGV_DATE) FROM OH_PREGNANCYVISIT pv WHERE pv.PRGV_PRG_ID = pr.PRG_ID AND pv.PRGV_ACTIVE = 1), '%d/%m/%Y') AS LAST_VISIT_STR,
	DATE_FORMAT((SELECT pv.PRGV_NEXT_APPOINTMENT_DATE FROM OH_PREGNANCYVISIT pv WHERE pv.PRGV_PRG_ID = pr.PRG_ID AND pv.PRGV_ACTIVE = 1 ORDER BY pv.PRGV_DATE DESC LIMIT 1), '%d/%m/%Y') AS NEXT_APP_STR,
	COALESCE(pr.PRG_STATUS, 'ONGOING') AS PRG_STATUS,
	IF(dlv.PRGDLV_DATE IS NOT NULL, CONCAT(DATE_FORMAT(dlv.PRGDLV_DATE, '%d/%m/%Y'), IF(dlv.PRGDLV_DELIVERYMODE IS NOT NULL, CONCAT(' - ', dlv.PRGDLV_DELIVERYMODE), '')), '-') AS OUTCOME_STR
FROM OH_PREGNANCY pr
JOIN OH_PATIENT pat ON pat.PAT_ID = pr.PRG_PAT_ID
LEFT JOIN OH_PREGNANCYDELIVERY dlv ON dlv.PRGDLV_PRG_ID = pr.PRG_ID
WHERE (pr.PRG_ACTIVE = 1 OR pr.PRG_ACTIVE IS TRUE)
	AND DATE(pr.PRG_DATE) >= DATE($P{fromdate})
	AND DATE(pr.PRG_DATE) <= DATE($P{todate})
ORDER BY pr.PRG_DATE ASC, pr.PRG_ID ASC]]>
	</queryString>
	<field name="PRG_ID" class="java.lang.Integer"/>
	<field name="PRG_DATE" class="java.sql.Timestamp"/>
	<field name="PRG_DATE_STR" class="java.lang.String"/>
	<field name="PAT_ID" class="java.lang.Integer"/>
	<field name="PAT_NAME" class="java.lang.String"/>
	<field name="PAT_AGE" class="java.lang.Integer"/>
	<field name="PAT_CONTACT" class="java.lang.String"/>
	<field name="PRG_LMP_STR" class="java.lang.String"/>
	<field name="PRG_EDD_STR" class="java.lang.String"/>
	<field name="OBS_FORMULA" class="java.lang.String"/>
	<field name="PRG_RISK_LEVEL" class="java.lang.String"/>
	<field name="NB_VISITS" class="java.lang.Long"/>
	<field name="LAST_VISIT_STR" class="java.lang.String"/>
	<field name="NEXT_APP_STR" class="java.lang.String"/>
	<field name="PRG_STATUS" class="java.lang.String"/>
	<field name="OUTCOME_STR" class="java.lang.String"/>
	<variable name="TOTAL_COUNT" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{PRG_ID}]]></variableExpression>
	</variable>
	<variable name="COUNT_ONGOING" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["ONGOING".equalsIgnoreCase($F{PRG_STATUS}) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="COUNT_COMPLETED" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["COMPLETED".equalsIgnoreCase($F{PRG_STATUS}) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="COUNT_TERMINATED" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["TERMINATED".equalsIgnoreCase($F{PRG_STATUS}) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="COUNT_RISK_LOW" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["LOW".equalsIgnoreCase($F{PRG_RISK_LEVEL}) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="COUNT_RISK_MEDIUM" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["MEDIUM".equalsIgnoreCase($F{PRG_RISK_LEVEL}) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="COUNT_RISK_HIGH" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["HIGH".equalsIgnoreCase($F{PRG_RISK_LEVEL}) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="SUM_VISITS" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{NB_VISITS} != null ? $F{NB_VISITS} : 0L]]></variableExpression>
	</variable>
