	<variable name="TOTAL_COUNT" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{VISIT_ID}]]></variableExpression>
	</variable>
	<variable name="DISTINCT_PATIENTS" class="java.lang.Integer" calculation="DistinctCount">
		<variableExpression><![CDATA[$F{PATIENT_ID}]]></variableExpression>
	</variable>
	<variable name="COUNT_CPN1" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{VISIT_TYPE} != null && ($F{VISIT_TYPE}.contains("1") || $F{VISIT_TYPE}.equalsIgnoreCase("CPN1") || $F{VISIT_TYPE}.equalsIgnoreCase("ANC1"))) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="COUNT_CPN2" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{VISIT_TYPE} != null && ($F{VISIT_TYPE}.contains("2") || $F{VISIT_TYPE}.equalsIgnoreCase("CPN2") || $F{VISIT_TYPE}.equalsIgnoreCase("ANC2"))) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="COUNT_CPN3" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{VISIT_TYPE} != null && ($F{VISIT_TYPE}.contains("3") || $F{VISIT_TYPE}.equalsIgnoreCase("CPN3") || $F{VISIT_TYPE}.equalsIgnoreCase("ANC3"))) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="COUNT_CPN4_PLUS" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{VISIT_TYPE} != null && ($F{VISIT_TYPE}.contains("4") || $F{VISIT_TYPE}.contains("5") || $F{VISIT_TYPE}.contains("6") || $F{VISIT_TYPE}.contains("7") || $F{VISIT_TYPE}.contains("8") || $F{VISIT_TYPE}.equalsIgnoreCase("CPN4") || $F{VISIT_TYPE}.equalsIgnoreCase("ANC4"))) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="COUNT_HTA" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[(($F{PRGV_SYSTOLIC_BP} != null && $F{PRGV_SYSTOLIC_BP} >= 140) || ($F{PRGV_DIASTOLIC_BP} != null && $F{PRGV_DIASTOLIC_BP} >= 90)) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="COUNT_PROTEINURIA" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{PRGV_URINE_PROTEIN} != null && !$F{PRGV_URINE_PROTEIN}.trim().isEmpty() && !$F{PRGV_URINE_PROTEIN}.equalsIgnoreCase("Négatif") && !$F{PRGV_URINE_PROTEIN}.equalsIgnoreCase("Negative") && !$F{PRGV_URINE_PROTEIN}.equalsIgnoreCase("Negatif") && !$F{PRGV_URINE_PROTEIN}.equalsIgnoreCase("Norm") && !$F{PRGV_URINE_PROTEIN}.equals("-")) ? 1 : 0]]></variableExpression>
	</variable>
