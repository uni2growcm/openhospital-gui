	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT '1/PRENATAL VISITS' AS METRIC, '' AS DES, '' AS COUNT, '' AS PERC 

UNION ALL

SELECT 
    'Number of first prenatal visits' AS METRIC,
    '' AS DES, 
    COUNT(DISTINCT PRGV_PRG_ID) AS COUNT, 
    ROUND(
        (
            COUNT(DISTINCT PRGV_PRG_ID) * 100.0
        ) / 
        (
            SELECT COUNT(DISTINCT PAT)
            FROM (
                SELECT ADM_PAT_ID AS PAT
                FROM OH_ADMISSION
                WHERE ADM_PRG_DATE_DEL IS NOT NULL

                UNION

                SELECT PRG_PAT_ID
                FROM OH_PREGNANCY
            ) AS T
        ),
        2
    ) AS PERC
FROM OH_PREGNANCYVISIT
JOIN OH_PREGNANCY
    ON PRG_ID = PRGV_PRG_ID
JOIN OH_PREGNANCYDELIVERY
    ON PRG_ID = PRGDLV_PRG_ID 
WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate}
AND PRGV_DATE <= PRGDLV_DATE

UNION ALL

SELECT 
    'Number of second prenatal visits' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT, 
    ROUND(
        (
            COUNT(*) * 100.0
        ) /
        (
            SELECT COUNT(DISTINCT PAT)
            FROM (
                SELECT ADM_PAT_ID AS PAT
                FROM OH_ADMISSION
                WHERE ADM_PRG_DATE_DEL IS NOT NULL

                UNION

                SELECT PRG_PAT_ID
                FROM OH_PREGNANCY
            ) AS T
        ),
        2
    ) AS PERC 
FROM (
    SELECT PRGV_PRG_ID
    FROM OH_PREGNANCYVISIT
    JOIN OH_PREGNANCY
        ON PRG_ID = PRGV_PRG_ID
    JOIN OH_PREGNANCYDELIVERY
        ON PRG_ID = PRGDLV_PRG_ID  
    WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate}
    AND PRGV_DATE <= PRGDLV_DATE
    GROUP BY PRGV_PRG_ID 
    HAVING COUNT(*) > 1 
) AS C

UNION ALL

SELECT 
    'Number of third prenatal visits' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT, 
    ROUND(
        (
            COUNT(*) * 100.0
        ) /
        (
            SELECT COUNT(DISTINCT PAT)
            FROM (
                SELECT ADM_PAT_ID AS PAT
                FROM OH_ADMISSION
                WHERE ADM_PRG_DATE_DEL IS NOT NULL

                UNION

                SELECT PRG_PAT_ID
                FROM OH_PREGNANCY
            ) AS T
        ),
        2
    ) AS PERC 
FROM (
    SELECT PRGV_PRG_ID
    FROM OH_PREGNANCYVISIT 
    JOIN OH_PREGNANCY
        ON PRG_ID = PRGV_PRG_ID
    JOIN OH_PREGNANCYDELIVERY
        ON PRG_ID = PRGDLV_PRG_ID 
    WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate}
    AND PRGV_DATE <= PRGDLV_DATE
    GROUP BY PRGV_PRG_ID 
    HAVING COUNT(*) > 2 
) AS C

UNION ALL

SELECT 
    'Number of forth prenatal visits' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT, 
    ROUND(
        (
            COUNT(*) * 100.0
        ) /
        (
            SELECT COUNT(DISTINCT PAT)
            FROM (
                SELECT ADM_PAT_ID AS PAT
                FROM OH_ADMISSION
                WHERE ADM_PRG_DATE_DEL IS NOT NULL

                UNION

                SELECT PRG_PAT_ID
                FROM OH_PREGNANCY
            ) AS T
        ),
        2
    ) AS PERC 
FROM (
    SELECT PRGV_PRG_ID
    FROM OH_PREGNANCYVISIT 
    JOIN OH_PREGNANCY
        ON PRG_ID = PRGV_PRG_ID
    JOIN OH_PREGNANCYDELIVERY
        ON PRG_ID = PRGDLV_PRG_ID 
    WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate}
    AND PRGV_DATE <= PRGDLV_DATE
    GROUP BY PRGV_PRG_ID 
    HAVING COUNT(*) > 3 
) AS C

UNION ALL

SELECT '2/DELIVERIES' AS METRIC, '' AS DES, '' AS COUNT, '' AS PERC

UNION ALL

SELECT  
    DLT_DESC AS METRIC,
    DRT_DESC AS DES,
    COUNT(*) AS COUNT,
    '' AS PERC
FROM OH_ADMISSION 
JOIN OH_DELIVERYTYPE
    ON ADM_PRG_DLT_ID_A = DLT_ID_A 
JOIN OH_DELIVERYRESULTTYPE
    ON ADM_PRG_DRT_ID_A = DRT_ID_A 
JOIN OH_PATIENT
    ON ADM_PAT_ID = PAT_ID 
JOIN OH_PREGNANCY
    ON PRG_PAT_ID = PAT_ID 
JOIN OH_PREGNANCYDELIVERY
    ON PRGDLV_PRG_ID = PRG_ID     
WHERE PRGDLV_DATE BETWEEN $P{fromdate} AND $P{todate}
GROUP BY DLT_ID_A, DRT_DESC, DLT_DESC

UNION ALL

SELECT '', '', '', ''

UNION ALL

SELECT '3/POSTNATAL VISITS', '', '', ''

UNION ALL

SELECT 
    'Postnatal visits ' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT,  
    ROUND(
        (
            COUNT(*) * 100.0
        ) /
        (
            SELECT COUNT(DISTINCT PAT)
            FROM (
                SELECT ADM_PAT_ID AS PAT
                FROM OH_ADMISSION
                WHERE ADM_PRG_DATE_DEL IS NOT NULL

                UNION

                SELECT PRG_PAT_ID
                FROM OH_PREGNANCY
            ) AS T
        ),
        2
    ) AS PERC
FROM OH_PREGNANCYVISIT 
JOIN OH_PREGNANCY
    ON PRG_ID = PRGV_PRG_ID
JOIN OH_PREGNANCYDELIVERY
    ON PRG_ID = PRGDLV_PRG_ID 
WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate}
AND PRGV_DATE <= PRGDLV_DATE

UNION ALL

SELECT '', '', '', ''

UNION ALL

SELECT '4/TOTAL', '', '', ''

UNION ALL 

SELECT 
    'Number of deliveries' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT,
    '' AS PERC
FROM OH_PREGNANCYDELIVERY 
WHERE PRGDLV_DATE BETWEEN $P{fromdate} AND $P{todate}

UNION ALL

SELECT 
    'Total number of pregnancy visits' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT,
    '' AS PERC 
FROM OH_PREGNANCYVISIT
WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate};]]>
	</queryString>
