	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter2.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT '1/PRENATAL VISITS' AS METRIC, '' AS DES, '' AS COUNT, '' AS PERC 

UNION ALL
(
    SELECT 'Number of first prenatal visits' AS METRIC, '' AS DES, 
    COUNT(DISTINCT PRGV_PRG_ID) AS COUNT, 
    (COUNT(DISTINCT PRGV_PRG_ID) / (SELECT COUNT(DISTINCT PAT) FROM (SELECT ADM_PAT_ID AS PAT FROM OH_ADMISSION WHERE ADM_PRG_DATE_DEL IS NOT NULL UNION ALL SELECT PRG_PAT_ID FROM OH_PREGNANCY) AS T) * 100) AS PERC
    FROM OH_PREGNANCYVISIT
    JOIN OH_PREGNANCY ON PRG_ID = PRGV_PRG_ID
    JOIN OH_PREGNANCYDELIVERY ON PRG_ID = PRGDLV_PRG_ID 
    WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate} AND PRGV_DATE <= PRGDLV_DATE
)

UNION ALL
(
    SELECT 'Number of second prenatal visits' AS METRIC, '' AS DES, COUNT(*) AS COUNT, 
    (COUNT(*) / (SELECT COUNT(DISTINCT PAT) FROM (SELECT ADM_PAT_ID AS PAT FROM OH_ADMISSION WHERE ADM_PRG_DATE_DEL IS NOT NULL UNION ALL SELECT PRG_PAT_ID FROM OH_PREGNANCY) AS T) * 100) AS PERC 
    FROM (
        SELECT PRGV_PRG_ID
        FROM OH_PREGNANCYVISIT
    JOIN OH_PREGNANCY ON PRG_ID = PRGV_PRG_ID
    JOIN OH_PREGNANCYDELIVERY ON PRG_ID = PRGDLV_PRG_ID  
        WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate} AND PRGV_DATE <= PRGDLV_DATE
        GROUP BY PRGV_PRG_ID 
        HAVING COUNT(*) > 1 
    ) AS C
)

UNION ALL
(
    SELECT 'Number of third prenatal visits' AS METRIC, '' AS DES, COUNT(*) AS COUNT, 
    (COUNT(*) / (SELECT COUNT(DISTINCT PAT) FROM (SELECT ADM_PAT_ID AS PAT FROM OH_ADMISSION WHERE ADM_PRG_DATE_DEL IS NOT NULL UNION ALL SELECT PRG_PAT_ID FROM OH_PREGNANCY) AS T) * 100) AS PERC 
    FROM (
        SELECT PRGV_PRG_ID
        FROM OH_PREGNANCYVISIT 
    JOIN OH_PREGNANCY ON PRG_ID = PRGV_PRG_ID
    JOIN OH_PREGNANCYDELIVERY ON PRG_ID = PRGDLV_PRG_ID 
        WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate} AND PRGV_DATE <= PRGDLV_DATE
        GROUP BY PRGV_PRG_ID 
        HAVING COUNT(*) > 2 
    ) AS C
)

UNION ALL
(
    SELECT 'Number of forth prenatal visits' AS METRIC, '' AS DES, COUNT(*) AS COUNT, 
    (COUNT(*) / (SELECT COUNT(DISTINCT PAT) FROM (SELECT ADM_PAT_ID AS PAT FROM OH_ADMISSION WHERE ADM_PRG_DATE_DEL IS NOT NULL UNION ALL SELECT PRG_PAT_ID FROM OH_PREGNANCY) AS T) * 100) AS PERC 
    FROM (
        SELECT PRGV_PRG_ID
        FROM OH_PREGNANCYVISIT 
    JOIN OH_PREGNANCY ON PRG_ID = PRGV_PRG_ID
    JOIN OH_PREGNANCYDELIVERY ON PRG_ID = PRGDLV_PRG_ID 
        WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate} AND PRGV_DATE <= PRGDLV_DATE
        GROUP BY PRGV_PRG_ID 
        HAVING COUNT(*) > 3 
    ) AS C
)

UNION ALL SELECT '' , '', '', ''
UNION ALL SELECT '3/POSTNATAL VISITS', '', '', ''

UNION ALL
(
    SELECT 'Postnatal visits ' AS METRIC, '' AS DES, COUNT(*) AS COUNT,  
    (COUNT(*) / (SELECT COUNT(DISTINCT PAT) FROM (SELECT ADM_PAT_ID AS PAT FROM OH_ADMISSION WHERE ADM_PRG_DATE_DEL IS NOT NULL UNION ALL SELECT PRG_PAT_ID FROM OH_PREGNANCY) AS T) * 100) AS PERC
    FROM OH_PREGNANCYVISIT 
    JOIN OH_PREGNANCY ON PRG_ID = PRGV_PRG_ID
    JOIN OH_PREGNANCYDELIVERY ON PRG_ID = PRGDLV_PRG_ID 
    WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate} AND PRGV_DATE <= PRGDLV_DATE
)

UNION ALL SELECT '' , '', '', ''
UNION ALL SELECT '4/TOTAL', '', '', ''

UNION ALL 
(
    SELECT 'Number of deliveries' AS METRIC, '' AS DES, COUNT(*) AS COUNT, '' AS PERC
    FROM OH_PREGNANCYDELIVERY 
    WHERE PRGDLV_DATE BETWEEN $P{fromdate} AND $P{todate}
)
UNION ALL
(
    SELECT 'Total number of pregnancy visits' AS METRIC, '' AS DES, COUNT(*) AS COUNT, '' AS PERC 
    FROM OH_PREGNANCYVISIT
    WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate}
);]]>
	</queryString>
