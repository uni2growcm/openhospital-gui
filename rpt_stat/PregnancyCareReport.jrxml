	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="Hospital" class="java.lang.String"/>
	<parameter name="City" class="java.lang.String"/>
	<parameter name="Address" class="java.lang.String"/>
	<parameter name="Email" class="java.lang.String"/>
	<parameter name="Telephone" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 'metric.prenatal_visits' AS METRIC, '' AS DES, '' AS COUNT, '' AS PERC 

UNION ALL

SELECT 
    'metric.first_prenatal_visit' AS METRIC,
    '' AS DES, 
    COUNT(DISTINCT PRGV_PRG_ID) AS COUNT, 
    ROUND(
        (
            COUNT(DISTINCT PRGV_PRG_ID) * 100.0
        ) / 
        NULLIF(
            (
                SELECT COUNT(DISTINCT PAT)
                FROM (
                    SELECT ADM_PAT_ID AS PAT
                    FROM OH_ADMISSION
                    WHERE ADM_PRG_DATE_DEL IS NOT NULL

                    UNION

                    SELECT PRG_PAT_ID
                    FROM OH_PREGNANCY
                ) AS T
            ),
            0
        ),
        2
    ) AS PERC
FROM OH_PREGNANCYVISIT
JOIN OH_PREGNANCY
    ON PRG_ID = PRGV_PRG_ID
LEFT JOIN OH_PREGNANCYDELIVERY
    ON PRG_ID = PRGDLV_PRG_ID 
WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate}
AND (PRGDLV_DATE IS NULL OR PRGV_DATE <= PRGDLV_DATE)

UNION ALL

SELECT 
    'metric.second_prenatal_visit' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT, 
    ROUND(
        (
            COUNT(*) * 100.0
        ) /
        NULLIF(
            (
                SELECT COUNT(DISTINCT PAT)
                FROM (
                    SELECT ADM_PAT_ID AS PAT
                    FROM OH_ADMISSION
                    WHERE ADM_PRG_DATE_DEL IS NOT NULL

                    UNION

                    SELECT PRG_PAT_ID
                    FROM OH_PREGNANCY
                ) AS T
            ),
            0
        ),
        2
    ) AS PERC 
FROM (
    SELECT PRGV_PRG_ID
    FROM OH_PREGNANCYVISIT
    JOIN OH_PREGNANCY
        ON PRG_ID = PRGV_PRG_ID
    LEFT JOIN OH_PREGNANCYDELIVERY
        ON PRG_ID = PRGDLV_PRG_ID  
    WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate}
    AND (PRGDLV_DATE IS NULL OR PRGV_DATE <= PRGDLV_DATE)
    GROUP BY PRGV_PRG_ID 
    HAVING COUNT(*) > 1 
) AS C

UNION ALL

SELECT 
    'metric.third_prenatal_visit' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT, 
    ROUND(
        (
            COUNT(*) * 100.0
        ) /
        NULLIF(
            (
                SELECT COUNT(DISTINCT PAT)
                FROM (
                    SELECT ADM_PAT_ID AS PAT
                    FROM OH_ADMISSION
                    WHERE ADM_PRG_DATE_DEL IS NOT NULL

                    UNION

                    SELECT PRG_PAT_ID
                    FROM OH_PREGNANCY
                ) AS T
            ),
            0
        ),
        2
    ) AS PERC 
FROM (
    SELECT PRGV_PRG_ID
    FROM OH_PREGNANCYVISIT 
    JOIN OH_PREGNANCY
        ON PRG_ID = PRGV_PRG_ID
    LEFT JOIN OH_PREGNANCYDELIVERY
        ON PRG_ID = PRGDLV_PRG_ID 
    WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate}
    AND (PRGDLV_DATE IS NULL OR PRGV_DATE <= PRGDLV_DATE)
    GROUP BY PRGV_PRG_ID 
    HAVING COUNT(*) > 2 
) AS C

UNION ALL

SELECT 
    'metric.fourth_prenatal_visit' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT, 
    ROUND(
        (
            COUNT(*) * 100.0
        ) /
        NULLIF(
            (
                SELECT COUNT(DISTINCT PAT)
                FROM (
                    SELECT ADM_PAT_ID AS PAT
                    FROM OH_ADMISSION
                    WHERE ADM_PRG_DATE_DEL IS NOT NULL

                    UNION

                    SELECT PRG_PAT_ID
                    FROM OH_PREGNANCY
                ) AS T
            ),
            0
        ),
        2
    ) AS PERC 
FROM (
    SELECT PRGV_PRG_ID
    FROM OH_PREGNANCYVISIT 
    JOIN OH_PREGNANCY
        ON PRG_ID = PRGV_PRG_ID
    LEFT JOIN OH_PREGNANCYDELIVERY
        ON PRG_ID = PRGDLV_PRG_ID 
    WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate}
    AND (PRGDLV_DATE IS NULL OR PRGV_DATE <= PRGDLV_DATE)
    GROUP BY PRGV_PRG_ID 
    HAVING COUNT(*) > 3 
) AS C

UNION ALL

SELECT 'metric.deliveries' AS METRIC, '' AS DES, '' AS COUNT, '' AS PERC

UNION ALL

SELECT  
    COALESCE(TYPO_DESCRIPTION, PRGDLV_TYPE_ID, 'metric.delivery') AS METRIC,
    COALESCE(PRGDLV_DELIVERYMODE, '') AS DES,
    COUNT(*) AS COUNT,
    ROUND(
        (
            COUNT(*) * 100.0
        ) /
        NULLIF(
            (
                SELECT COUNT(DISTINCT PAT)
                FROM (
                    SELECT ADM_PAT_ID AS PAT
                    FROM OH_ADMISSION
                    WHERE ADM_PRG_DATE_DEL IS NOT NULL

                    UNION

                    SELECT PRG_PAT_ID
                    FROM OH_PREGNANCY
                ) AS T
            ),
            0
        ),
        2
    ) AS PERC
FROM OH_PREGNANCYDELIVERY
LEFT JOIN OH_TYPOLOGIES
    ON PRGDLV_TYPE_ID = TYPO_CODE
WHERE PRGDLV_DATE BETWEEN $P{fromdate} AND $P{todate}
GROUP BY PRGDLV_TYPE_ID, TYPO_DESCRIPTION, PRGDLV_DELIVERYMODE

UNION ALL

SELECT '', '', '', ''

UNION ALL

SELECT 'metric.postnatal_visits', '', '', ''

UNION ALL

SELECT 
    'metric.postnatal_visits_count' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT,  
    ROUND(
        (
            COUNT(*) * 100.0
        ) /
        NULLIF(
            (
                SELECT COUNT(DISTINCT PAT)
                FROM (
                    SELECT ADM_PAT_ID AS PAT
                    FROM OH_ADMISSION
                    WHERE ADM_PRG_DATE_DEL IS NOT NULL

                    UNION

                    SELECT PRG_PAT_ID
                    FROM OH_PREGNANCY
                ) AS T
            ),
            0
        ),
        2
    ) AS PERC
FROM OH_PREGNANCYVISIT 
JOIN OH_PREGNANCY
    ON PRG_ID = PRGV_PRG_ID
JOIN OH_PREGNANCYDELIVERY
    ON PRG_ID = PRGDLV_PRG_ID 
WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate}
AND PRGV_DATE > PRGDLV_DATE

UNION ALL

SELECT '', '', '', ''

UNION ALL

SELECT 'metric.total', '', '', ''

UNION ALL 

SELECT 
    'metric.number_of_deliveries' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT,
    ROUND(
        (
            COUNT(*) * 100.0
        ) /
        NULLIF(
            (
                SELECT COUNT(DISTINCT PAT)
                FROM (
                    SELECT ADM_PAT_ID AS PAT
                    FROM OH_ADMISSION
                    WHERE ADM_PRG_DATE_DEL IS NOT NULL

                    UNION

                    SELECT PRG_PAT_ID
                    FROM OH_PREGNANCY
                ) AS T
            ),
            0
        ),
        2
    ) AS PERC
FROM OH_PREGNANCYDELIVERY 
WHERE PRGDLV_DATE BETWEEN $P{fromdate} AND $P{todate}

UNION ALL

SELECT 
    'metric.total_pregnancy_visits' AS METRIC,
    '' AS DES,
    COUNT(*) AS COUNT, 
    ROUND(
        (
            COUNT(*) * 100.0
        ) /
        NULLIF(
            (
                SELECT COUNT(DISTINCT PAT)
                FROM (
                    SELECT ADM_PAT_ID AS PAT
                    FROM OH_ADMISSION
                    WHERE ADM_PRG_DATE_DEL IS NOT NULL

                    UNION

                    SELECT PRG_PAT_ID
                    FROM OH_PREGNANCY
                ) AS T
            ),
            0
        ),
        2
    ) AS PERC 
FROM OH_PREGNANCYVISIT
WHERE PRGV_DATE BETWEEN $P{fromdate} AND $P{todate};]]>
	</queryString>
