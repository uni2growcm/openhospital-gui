					<box/>
					<textElement textAlignment="Center" verticalAlignment="Bottom">
						<font size="9" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{REPORT_RESOURCE_BUNDLE}.getString("angal.command.report.status")]]></textFieldExpression>
				</textField>
				<line>
					<reportElement key="line-th" x="0" y="43" width="535" height="1"/>
					<graphicElement>
						<pen lineWidth="0.5" lineColor="#CCCCCC"/>
					</graphicElement>
				</line>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="24" splitType="Prevent">
				<line>
					<reportElement key="line-gf" x="0" y="1" width="535" height="1"/>
					<graphicElement>
						<pen lineWidth="0.5" lineColor="#CCCCCC"/>
					</graphicElement>
				</line>
				<textField isBlankWhenNull="true">
					<reportElement key="textField-gfLabel" x="0" y="3" width="370" height="18"/>
					<box leftPadding="4"/>
					<textElement verticalAlignment="Middle">
						<font size="9" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{REPORT_RESOURCE_BUNDLE}.getString("angal.command.report.totalsupplier") + " (" + java.util.Objects.toString($V{GRP_COUNT}, "0") + " " + $P{REPORT_RESOURCE_BUNDLE}.getString("angal.command.report.items") + ") :"]]></textFieldExpression>
				</textField>
				<textField pattern="#,##0" evaluationTime="Group" evaluationGroup="SUPPLIER_GROUP">
					<reportElement key="textField-gfTotalQty" x="370" y="3" width="55" height="18"/>
					<box rightPadding="2"/>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font size="9" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA[$V{GRP_ORDER_QTY_TOTAL} != null ? $V{GRP_ORDER_QTY_TOTAL} : 0d]]></textFieldExpression>
				</textField>
			</band>
		</groupFooter>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
