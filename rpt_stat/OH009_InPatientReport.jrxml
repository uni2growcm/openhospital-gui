	<parameter name="HEADER_BUNDLE" class="java.util.ResourceBundle" isForPrompting="false">
		<defaultValueExpression><![CDATA[java.util.ResourceBundle.getBundle("ReportHeader", $P{REPORT_LOCALE} != null ? $P{REPORT_LOCALE} : java.util.Locale.getDefault())]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT ADM_ID, ADM_YPROG, PAT_ID, PAT_NAME, PAT_CITY, PAT_ADDR, PAT_SEX, PAT_AGE, 
			DATEDIFF(ADM_DATE_ADM, PAT_BDATE) AS DAYS,
	        DATE(ADM_DATE_ADM) AS DATE_ADM,
	        (SELECT WRD_NAME FROM OH_WARD WHERE WRD_ID_A = ADM_WRD_ID_A) AS WARD,
	        DATE(ADM_DATE_DIS) AS DATE_DIS,
	        ADM_OUT_DIS_ID_A,
	        (SELECT DIS_DESC FROM OH_DISEASE WHERE DIS_ID_A = ADM_OUT_DIS_ID_A) AS DISEASE,
	        ADM_OUT_DIS_ID_A_2,
	        ADM_OUT_DIS_ID_A_3,
			ADM_NOTE,
	        (SELECT DIST_DESC FROM OH_DISCHARGETYPE WHERE DIST_ID_A = ADM_DIST_ID_A) AS OUTCOME,
	        IF(DATEDIFF(ADM_DATE_DIS, ADM_DATE_ADM) = 0, 1, DATEDIFF(ADM_DATE_DIS, ADM_DATE_ADM)) AS LOS
		FROM OH_ADMISSION JOIN OH_PATIENT ON PAT_ID = ADM_PAT_ID
		WHERE ADM_DELETED = 'N'
			AND ADM_DATE_DIS IS NOT NULL
			AND DATE(ADM_DATE_DIS) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
		ORDER BY ADM_DATE_DIS]]>
	</queryString>
