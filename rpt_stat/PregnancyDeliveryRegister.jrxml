<?xml version="1.0" encoding="UTF-8"  ?>
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="PregnancyDeliveryRegister"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="782"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="AllSectionsNoDetail"
		 isFloatColumnFooter="true"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="Hospital" isForPrompting="true" class="java.lang.String"/>
	<parameter name="Address" isForPrompting="true" class="java.lang.String"/>
	<parameter name="City" isForPrompting="true" class="java.lang.String"/>
	<parameter name="Email" isForPrompting="true" class="java.lang.String"/>
	<parameter name="Telephone" isForPrompting="true" class="java.lang.String"/>
	<parameter name="fromdate" isForPrompting="true" class="java.util.Date"/>
	<parameter name="todate" isForPrompting="true" class="java.util.Date"/>
	<parameter name="SUBREPORT_DIR" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["./rpt_stat/"]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGO_PATH" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["./rsc/images/"]]></defaultValueExpression>
	</parameter>

	<queryString><![CDATA[SELECT
	PD.PDEL_ID AS PDEL_ID,
	PD.PDEL_DATE_DEL AS PDEL_DATE_DEL,
	PAT.PAT_NAME AS PAT_NAME,
	IF(PAT.PAT_BDATE is not null, ROUND(DATEDIFF(CURDATE(), DATE(PAT.PAT_BDATE)) / 365,0), PAT.PAT_AGE) AS PAT_AGE,
	PNB.PNB_CHILD_NUMBER AS PNB_CHILD_NUMBER,
	PNB.PNB_SEX AS PNB_SEX,
	DLT.DLT_DESC AS DLT_DESC,
	DRT.DRT_DESC AS DRT_DESC,
	PNB.PNB_WEIGHT AS PNB_WEIGHT,
	PNB.PNB_HEIGHT AS PNB_HEIGHT,
	PNB.PNB_COMPLICATIONS AS PNB_COMPLICATIONS,
	PNB.PNB_MALFORMATION AS PNB_MALFORMATION,
	PNB.PNB_HIV_EXPOSED AS PNB_HIV_EXPOSED,
	CONCAT_WS(' / ', PD.PDEL_LOCHIES, PD.PDEL_COUNSELING, PD.PDEL_FP_METHOD) AS PDEL_NOTE
FROM OH_PREGNANCYDELIVERY PD
	JOIN OH_PREGNANCYNEWBORN PNB ON ( PNB.PNB_PDEL_ID = PD.PDEL_ID )
	LEFT JOIN OH_ADMISSION ADM ON ( ADM.ADM_ID = PD.PDEL_ADM_ID )
	LEFT JOIN OH_PREGNANCY PREG ON ( PREG.PREG_ID = PD.PDEL_PREG_ID )
	JOIN OH_PATIENT PAT ON ( PAT.PAT_ID = COALESCE(ADM.ADM_PAT_ID, PREG.PREG_PAT_ID) )
	LEFT JOIN OH_DELIVERYTYPE DLT ON ( DLT.DLT_ID_A = PNB.PNB_DLT_ID_A )
	LEFT JOIN OH_DELIVERYRESULTTYPE DRT ON ( DRT.DRT_ID_A = PNB.PNB_DRT_ID_A )
WHERE DATE(PD.PDEL_DATE_DEL) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
ORDER BY PD.PDEL_DATE_DEL ASC, PNB.PNB_CHILD_NUMBER ASC]]></queryString>

	<field name="PDEL_ID" class="java.lang.Integer"/>
	<field name="PDEL_DATE_DEL" class="java.sql.Timestamp"/>
	<field name="PAT_NAME" class="java.lang.String"/>
	<field name="PAT_AGE" class="java.math.BigDecimal"/>
	<field name="PNB_CHILD_NUMBER" class="java.lang.Integer"/>
	<field name="PNB_SEX" class="java.lang.String"/>
	<field name="DLT_DESC" class="java.lang.String"/>
	<field name="DRT_DESC" class="java.lang.String"/>
	<field name="PNB_WEIGHT" class="java.lang.Float"/>
	<field name="PNB_HEIGHT" class="java.lang.Float"/>
	<field name="PNB_COMPLICATIONS" class="java.lang.String"/>
	<field name="PNB_MALFORMATION" class="java.lang.String"/>
	<field name="PNB_HIV_EXPOSED" class="java.lang.Boolean"/>
	<field name="PDEL_NOTE" class="java.lang.String"/>

