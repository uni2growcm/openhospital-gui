<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Outpatient_Register" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="NoPages" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" resourceBundle="Outpatient_Register" uuid="a1b2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="Hospital" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="phone_lenght" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[9]]></defaultValueExpression>
	</parameter>
	<parameter name="historyFamily" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyFamily}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyPast" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyPast}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyCurrent" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyCurrent}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyNothing" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyNothing}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyHypertension" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyHypertension}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyDrugAddiction" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyDrugAddiction}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyCardiovascular" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyCardiovascular}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyInfective" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyInfective}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyEndocrine" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyEndocrine}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyRespiratory" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyRespiratory}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyCancer" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyCancer}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyOrthopedic" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyOrthopedic}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyGynecological" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyGynecological}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyOther" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyOther}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyRemark" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyRemark}]]></defaultValueExpression>
	</parameter>
	<parameter name="historySurgery" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historySurgery}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyAllergy" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyAllergy}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyTherapy" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyTherapy}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyMedicine" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyMedicine}]]></defaultValueExpression>
	</parameter>
	<parameter name="historyNotes" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$R{historyNotes}]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	o.OPD_ID,
	ROW_NUMBER() OVER (PARTITION BY YEAR(o.OPD_DATE), MONTH(o.OPD_DATE) ORDER BY o.OPD_DATE, o.OPD_ID) AS OPD_PROG_MONTH,
	o.OPD_NEW_PAT,
	o.OPD_AGE,
	o.OPD_SEX,
	o.OPD_NOTE,
	IF(o.OPD_REFERRAL_TO = 'R', 'yes', 'non') AS OPD_REFERRAL_TO_HOSPITAL,
	DATE_FORMAT(o.OPD_DATE, '%d/%m/%Y') AS OPD_DATE,
	p.PAT_ID,
	p.PAT_NAME,
	p.PAT_MAR_STAT AS PAT_STATUS,
	p.PAT_NEXT_KIN,
	p.PAT_BLAMA,
	p.PAT_CITY,
	p.PAT_ADDR,
	p.PAT_GEO_POS,
	(SELECT IF(COUNT(*) > 0, 'yes', 'no')
	 FROM OH_PREGNANCY pr
	 WHERE pr.PRG_PAT_ID = p.PAT_ID
	   AND pr.PRG_ACTIVE = 1
	   AND COALESCE(pr.PRG_DATE, pr.PRG_CREATED_DATE) <= o.OPD_DATE
	   AND (pr.PRG_STATUS = 'ONGOING'
	        OR EXISTS (SELECT 1
	                   FROM OH_PREGNANCYDELIVERY pd
	                   WHERE pd.PRGDLV_PRG_ID = pr.PRG_ID
	                     AND pd.PRGDLV_DATE > o.OPD_DATE))
	) AS PAT_PREGNANT,
	(SELECT CONCAT_WS('; ',
		IF(ph.PAH_FAM_NOTHING = 1, CONCAT($P{historyFamily}, ': ', $P{historyNothing}), NULL),
		IF(ph.PAH_FAM_HYPER = 1, CONCAT($P{historyFamily}, ': ', $P{historyHypertension}), NULL),
		IF(ph.PAH_FAM_DRUGADD = 1, CONCAT($P{historyFamily}, ': ', $P{historyDrugAddiction}), NULL),
		IF(ph.PAH_FAM_CARDIO = 1, CONCAT($P{historyFamily}, ': ', $P{historyCardiovascular}), NULL),
		IF(ph.PAH_FAM_INFECT = 1, CONCAT($P{historyFamily}, ': ', $P{historyInfective}), NULL),
		IF(ph.PAH_FAM_ENDO = 1, CONCAT($P{historyFamily}, ': ', $P{historyEndocrine}), NULL),
		IF(ph.PAH_FAM_RESP = 1, CONCAT($P{historyFamily}, ': ', $P{historyRespiratory}), NULL),
		IF(ph.PAH_FAM_CANCER = 1, CONCAT($P{historyFamily}, ': ', $P{historyCancer}), NULL),
		IF(ph.PAH_FAM_ORTO = 1, CONCAT($P{historyFamily}, ': ', $P{historyOrthopedic}), NULL),
		IF(ph.PAH_FAM_GYNO = 1, CONCAT($P{historyFamily}, ': ', $P{historyGynecological}), NULL),
		IF(ph.PAH_FAM_OTHER = 1, CONCAT($P{historyFamily}, ': ', $P{historyOther}), NULL),
		IF(ph.PAH_PAT_CLO_NOTHING = 1, CONCAT($P{historyPast}, ': ', $P{historyNothing}), NULL),
		IF(ph.PAH_PAT_CLO_HYPER = 1, CONCAT($P{historyPast}, ': ', $P{historyHypertension}), NULL),
		IF(ph.PAH_PAT_CLO_DRUGADD = 1, CONCAT($P{historyPast}, ': ', $P{historyDrugAddiction}), NULL),
		IF(ph.PAH_PAT_CLO_CARDIO = 1, CONCAT($P{historyPast}, ': ', $P{historyCardiovascular}), NULL),
		IF(ph.PAH_PAT_CLO_INFECT = 1, CONCAT($P{historyPast}, ': ', $P{historyInfective}), NULL),
		IF(ph.PAH_PAT_CLO_ENDO = 1, CONCAT($P{historyPast}, ': ', $P{historyEndocrine}), NULL),
		IF(ph.PAH_PAT_CLO_RESP = 1, CONCAT($P{historyPast}, ': ', $P{historyRespiratory}), NULL),
		IF(ph.PAH_PAT_CLO_CANCER = 1, CONCAT($P{historyPast}, ': ', $P{historyCancer}), NULL),
		IF(ph.PAH_PAT_CLO_ORTO = 1, CONCAT($P{historyPast}, ': ', $P{historyOrthopedic}), NULL),
		IF(ph.PAH_PAT_CLO_GYNO = 1, CONCAT($P{historyPast}, ': ', $P{historyGynecological}), NULL),
		IF(ph.PAH_PAT_CLO_OTHER = 1, CONCAT($P{historyPast}, ': ', $P{historyOther}), NULL),
		IF(ph.PAH_PAT_OPN_NOTHING = 1, CONCAT($P{historyCurrent}, ': ', $P{historyNothing}), NULL),
		IF(ph.PAH_PAT_OPN_HYPER = 1, CONCAT($P{historyCurrent}, ': ', $P{historyHypertension}), NULL),
		IF(ph.PAH_PAT_OPN_DRUGADD = 1, CONCAT($P{historyCurrent}, ': ', $P{historyDrugAddiction}), NULL),
		IF(ph.PAH_PAT_OPN_CARDIO = 1, CONCAT($P{historyCurrent}, ': ', $P{historyCardiovascular}), NULL),
		IF(ph.PAH_PAT_OPN_INFECT = 1, CONCAT($P{historyCurrent}, ': ', $P{historyInfective}), NULL),
		IF(ph.PAH_PAT_OPN_ENDO = 1, CONCAT($P{historyCurrent}, ': ', $P{historyEndocrine}), NULL),
		IF(ph.PAH_PAT_OPN_RESP = 1, CONCAT($P{historyCurrent}, ': ', $P{historyRespiratory}), NULL),
		IF(ph.PAH_PAT_OPN_CANCER = 1, CONCAT($P{historyCurrent}, ': ', $P{historyCancer}), NULL),
		IF(ph.PAH_PAT_OPN_ORTO = 1, CONCAT($P{historyCurrent}, ': ', $P{historyOrthopedic}), NULL),
		IF(ph.PAH_PAT_OPN_GYNO = 1, CONCAT($P{historyCurrent}, ': ', $P{historyGynecological}), NULL),
		IF(ph.PAH_PAT_OPN_OTHER = 1, CONCAT($P{historyCurrent}, ': ', $P{historyOther}), NULL),
		IF(NULLIF(ph.PAH_FAM_NOTE, '') IS NOT NULL, CONCAT($P{historyFamily}, ' - ', $P{historyRemark}, ': ', ph.PAH_FAM_NOTE), NULL),
		IF(NULLIF(ph.PAH_PAT_CLO_NOTE, '') IS NOT NULL, CONCAT($P{historyPast}, ' - ', $P{historyRemark}, ': ', ph.PAH_PAT_CLO_NOTE), NULL),
		IF(NULLIF(ph.PAH_PAT_OPN_NOTE, '') IS NOT NULL, CONCAT($P{historyCurrent}, ' - ', $P{historyRemark}, ': ', ph.PAH_PAT_OPN_NOTE), NULL),
		IF(NULLIF(ph.PAH_PAT_SURGERY, '') IS NOT NULL, CONCAT($P{historySurgery}, ': ', ph.PAH_PAT_SURGERY), NULL),
		IF(NULLIF(ph.PAH_PAT_ALLERGY, '') IS NOT NULL, CONCAT($P{historyAllergy}, ': ', ph.PAH_PAT_ALLERGY), NULL),
		IF(NULLIF(ph.PAH_PAT_THERAPY, '') IS NOT NULL, CONCAT($P{historyTherapy}, ': ', ph.PAH_PAT_THERAPY), NULL),
		IF(NULLIF(ph.PAH_PAT_MEDICINE, '') IS NOT NULL, CONCAT($P{historyMedicine}, ': ', ph.PAH_PAT_MEDICINE), NULL),
		IF(NULLIF(ph.PAH_PAT_NOTE, '') IS NOT NULL, CONCAT($P{historyNotes}, ': ', ph.PAH_PAT_NOTE), NULL)
	)
	 FROM OH_PATIENTHISTORY ph
	 WHERE ph.PAH_PAT_ID = p.PAT_ID AND ph.PAH_ACTIVE = 1
	 ORDER BY ph.PAH_LAST_MODIFIED_DATE DESC, ph.PAH_ID DESC
	 LIMIT 1
	) AS PAT_ANTECEDENTS,
	p.PAT_PROFESSION AS PAT_OCCUPATION,
	IF(LENGTH(p.PAT_TELE) >= $P{phone_lenght}, RIGHT(p.PAT_TELE, $P{phone_lenght}), p.PAT_TELE) AS PAT_TELE,
	COALESCE(
	 (SELECT GROUP_CONCAT(DISTINCT d.DIS_DESC SEPARATOR ', ')
	 FROM OH_OPD_DIAGNOSIS od
	 JOIN oh_disease d ON d.DIS_ID_A = od.OPDD_DIS_ID_A
	 WHERE od.OPDD_OPD_ID = o.OPD_ID AND od.OPDD_ACTIVE = 1),
	 (SELECT GROUP_CONCAT(DISTINCT d.DIS_DESC SEPARATOR ', ')
	 FROM oh_disease d
	 WHERE d.DIS_ID_A IN (o.OPD_DIS_ID_A, o.OPD_DIS_ID_A_2, o.OPD_DIS_ID_A_3)
	)) AS OPD_DIAGNOSTIC,
	(SELECT GROUP_CONCAT(DISTINCT l.LAB_EXA_ID_A SEPARATOR ', ')
	 FROM oh_laboratory l
	 WHERE l.LAB_PAT_ID = o.OPD_PAT_ID AND DATE(l.LAB_DATE) = DATE(o.OPD_DATE)
	) AS OPD_EXAMS,
	(SELECT GROUP_CONCAT(DISTINCT
			CASE WHEN e.EXA_PROC = 1 AND l.LAB_RES IS NOT NULL THEN CONCAT(l.LAB_EXA_ID_A, ' :[', l.LAB_RES, ' - ', IFNULL(l.LAB_NOTE, ''), ']')
			     WHEN e.EXA_PROC = 2 AND lr.LABR_RES_VALUE IS NOT NULL THEN CONCAT(l.LAB_EXA_ID_A, '->', lr.LABR_DESC, ' :[', lr.LABR_RES_VALUE, ']')
			     ELSE NULL END
			SEPARATOR '; ')
	 FROM oh_laboratory l
	 LEFT JOIN oh_laboratoryrow lr ON lr.LABR_LAB_ID = l.LAB_ID
	 LEFT JOIN oh_exam e ON e.EXA_ID_A = l.LAB_EXA_ID_A
	 WHERE l.LAB_PAT_ID = o.OPD_PAT_ID AND DATE(l.LAB_DATE) = DATE(o.OPD_DATE)
	) AS OPD_RESULTS,
	(SELECT GROUP_CONCAT(DISTINCT m.MDSR_DESC SEPARATOR ', ')
	 FROM oh_therapies t
	 JOIN oh_medicaldsr m ON m.MDSR_ID = t.THR_MDSR_ID
	 WHERE t.THR_PAT_ID = o.OPD_PAT_ID AND DATE(t.THR_CREATED_DATE) = DATE(o.OPD_DATE)
	) AS OPD_TREATMENT,
	(SELECT IF(COUNT(a.ADM_ID) > 0, 'yes', 'no')
	 FROM oh_admission a
	 WHERE a.ADM_PAT_ID = o.OPD_PAT_ID AND DATE(a.ADM_DATE_ADM) = DATE(o.OPD_DATE)
	) AS OPD_HOSPITALIZATION
FROM oh_opd o
JOIN oh_patient p ON p.PAT_ID = o.OPD_PAT_ID
WHERE DATE(o.OPD_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
ORDER BY o.OPD_ID]]>
	</queryString>
	<field name="OPD_ID" class="java.lang.Integer"/>
	<field name="OPD_PROG_MONTH" class="java.lang.Long"/>
	<field name="OPD_NEW_PAT" class="java.lang.String"/>
	<field name="OPD_AGE" class="java.lang.Integer"/>
	<field name="OPD_SEX" class="java.lang.String"/>
	<field name="OPD_NOTE" class="java.lang.String"/>
	<field name="OPD_REFERRAL_TO_HOSPITAL" class="java.lang.String"/>
	<field name="OPD_DATE" class="java.lang.String"/>
	<field name="PAT_ID" class="java.lang.Integer"/>
	<field name="PAT_NAME" class="java.lang.String"/>
	<field name="PAT_STATUS" class="java.lang.String"/>
	<field name="PAT_NEXT_KIN" class="java.lang.String"/>
	<field name="PAT_BLAMA" class="java.lang.String"/>
	<field name="PAT_CITY" class="java.lang.String"/>
	<field name="PAT_ADDR" class="java.lang.String"/>
	<field name="PAT_GEO_POS" class="java.lang.String"/>
	<field name="PAT_PREGNANT" class="java.lang.String"/>
	<field name="PAT_ANTECEDENTS" class="java.lang.String"/>
	<field name="PAT_OCCUPATION" class="java.lang.String"/>
	<field name="PAT_TELE" class="java.lang.String"/>
	<field name="OPD_DIAGNOSTIC" class="java.lang.String"/>
	<field name="OPD_EXAMS" class="java.lang.String"/>
	<field name="OPD_RESULTS" class="java.lang.String"/>
	<field name="OPD_TREATMENT" class="java.lang.String"/>
	<field name="OPD_HOSPITALIZATION" class="java.lang.String"/>
	<variable name="TOTAL" class="java.lang.Long" calculation="Count">
		<variableExpression><![CDATA[$F{OPD_ID}]]></variableExpression>
	</variable>
