	<columnHeader>
		<band height="100" splitType="Stretch">
			<textField isBlankWhenNull="false">
				<reportElement x="0" y="0" width="26" height="100" uuid="d6e7f890-0112-4324-3546-576879800112" mode="Opaque" backcolor="#EAF0F6" forecolor="#1E3A8A"/>
				<box><pen lineWidth="0.5" lineColor="#B0C4DE"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$R{colDate}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement x="26" y="0" width="14" height="100" uuid="e7f89001-0213-4435-4657-687980011223" mode="Opaque" backcolor="#EAF0F6" forecolor="#1E3A8A"/>
