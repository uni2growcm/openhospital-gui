	<field name="REFUNDED_AMOUNT_FRIDAY" class="java.lang.Double"/>
	<field name="COUNT_SATURDAY" class="java.lang.Double"/>
	<field name="REFUNDED_COUNT_SATURDAY" class="java.lang.Double"/>
	<field name="AMOUNT_SATURDAY" class="java.lang.Double"/>
	<field name="REFUNDED_AMOUNT_SATURDAY" class="java.lang.Double"/>
	<field name="COUNT_SUNDAY" class="java.lang.Double"/>
