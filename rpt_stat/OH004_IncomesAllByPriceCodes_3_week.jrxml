	<field name="TOTAL_WEEK_COUNT" class="java.lang.Double"/>
	<field name="REFUNDED_TOTAL_WEEK_COUNT" class="java.lang.Double"/>
	<field name="TOTAL_WEEK_AMOUNT" class="java.lang.Double"/>
	<field name="REFUNDED_TOTAL_WEEK_AMOUNT" class="java.lang.Double"/>

	<variable name="TOTAL" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[($F{TOTAL_WEEK_AMOUNT} != null ? $F{TOTAL_WEEK_AMOUNT} : 0) - ($F{REFUNDED_TOTAL_WEEK_AMOUNT} != null ? $F{REFUNDED_TOTAL_WEEK_AMOUNT} : 0)]]></variableExpression>
	</variable>


