	</parameter>

	<queryString>
		<![CDATA[SELECT 
    bli.BLI_ITEM_GROUP,
    bli.BLI_ITEM_DESC,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 0 AND b.BLL_PARENT_ID IS NULL THEN bli.BLI_QTY ELSE 0 END) AS COUNT_MONDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 0 AND b.BLL_PARENT_ID IS NOT NULL THEN bli.BLI_QTY ELSE 0 END) AS REFUNDED_COUNT_MONDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 0 AND b.BLL_PARENT_ID IS NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS AMOUNT_MONDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 0 AND b.BLL_PARENT_ID IS NOT NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS REFUNDED_AMOUNT_MONDAY,

    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 1 AND b.BLL_PARENT_ID IS NULL THEN bli.BLI_QTY ELSE 0 END) AS COUNT_TUESDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 1 AND b.BLL_PARENT_ID IS NOT NULL THEN bli.BLI_QTY ELSE 0 END) AS REFUNDED_COUNT_TUESDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 1 AND b.BLL_PARENT_ID IS NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS AMOUNT_TUESDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 1 AND b.BLL_PARENT_ID IS NOT NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS REFUNDED_AMOUNT_TUESDAY,

    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 2 AND b.BLL_PARENT_ID IS NULL THEN bli.BLI_QTY ELSE 0 END) AS COUNT_WEDNESDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 2 AND b.BLL_PARENT_ID IS NOT NULL THEN bli.BLI_QTY ELSE 0 END) AS REFUNDED_COUNT_WEDNESDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 2 AND b.BLL_PARENT_ID IS NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS AMOUNT_WEDNESDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 2 AND b.BLL_PARENT_ID IS NOT NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS REFUNDED_AMOUNT_WEDNESDAY,

    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 3 AND b.BLL_PARENT_ID IS NULL THEN bli.BLI_QTY ELSE 0 END) AS COUNT_THURSDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 3 AND b.BLL_PARENT_ID IS NOT NULL THEN bli.BLI_QTY ELSE 0 END) AS REFUNDED_COUNT_THURSDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 3 AND b.BLL_PARENT_ID IS NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS AMOUNT_THURSDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 3 AND b.BLL_PARENT_ID IS NOT NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS REFUNDED_AMOUNT_THURSDAY,

    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 4 AND b.BLL_PARENT_ID IS NULL THEN bli.BLI_QTY ELSE 0 END) AS COUNT_FRIDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 4 AND b.BLL_PARENT_ID IS NOT NULL THEN bli.BLI_QTY ELSE 0 END) AS REFUNDED_COUNT_FRIDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 4 AND b.BLL_PARENT_ID IS NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS AMOUNT_FRIDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 4 AND b.BLL_PARENT_ID IS NOT NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS REFUNDED_AMOUNT_FRIDAY,

    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 5 AND b.BLL_PARENT_ID IS NULL THEN bli.BLI_QTY ELSE 0 END) AS COUNT_SATURDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 5 AND b.BLL_PARENT_ID IS NOT NULL THEN bli.BLI_QTY ELSE 0 END) AS REFUNDED_COUNT_SATURDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 5 AND b.BLL_PARENT_ID IS NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS AMOUNT_SATURDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 5 AND b.BLL_PARENT_ID IS NOT NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS REFUNDED_AMOUNT_SATURDAY,

    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 6 AND b.BLL_PARENT_ID IS NULL THEN bli.BLI_QTY ELSE 0 END) AS COUNT_SUNDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 6 AND b.BLL_PARENT_ID IS NOT NULL THEN bli.BLI_QTY ELSE 0 END) AS REFUNDED_COUNT_SUNDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 6 AND b.BLL_PARENT_ID IS NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS AMOUNT_SUNDAY,
    SUM(CASE WHEN WEEKDAY(b.BLL_DATE) = 6 AND b.BLL_PARENT_ID IS NOT NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS REFUNDED_AMOUNT_SUNDAY,

    SUM(CASE WHEN b.BLL_PARENT_ID IS NULL THEN bli.BLI_QTY ELSE 0 END) AS TOTAL_WEEK_COUNT,
    SUM(CASE WHEN b.BLL_PARENT_ID IS NOT NULL THEN bli.BLI_QTY ELSE 0 END) AS REFUNDED_TOTAL_WEEK_COUNT,
    SUM(CASE WHEN b.BLL_PARENT_ID IS NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS TOTAL_WEEK_AMOUNT,
    SUM(CASE WHEN b.BLL_PARENT_ID IS NOT NULL THEN (bli.BLI_QTY * bli.BLI_ITEM_AMOUNT) ELSE 0 END) AS REFUNDED_TOTAL_WEEK_AMOUNT
FROM OH_BILLITEMS bli
JOIN OH_BILLS b ON bli.BLI_ID_BILL = b.BLL_ID
LEFT JOIN OH_ADMISSION adm ON b.BLL_ADM_ID = adm.ADM_ID
WHERE DATE(b.BLL_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
  AND (
      ($P{status} = 'ALL' AND b.BLL_STATUS <> 'D' AND b.BLL_STATUS <> 'X')
      OR ($P{status} = 'O' AND b.BLL_STATUS = 'O')
      OR ($P{status} = 'C' AND b.BLL_STATUS = 'C')
  )
  AND ($P{ward_id} = 'ALL' OR COALESCE(b.BLL_WARD_ID, adm.ADM_WRD_ID_A) = $P{ward_id})
GROUP BY bli.BLI_ITEM_GROUP, bli.BLI_ITEM_DESC
ORDER BY bli.BLI_ITEM_GROUP, bli.BLI_ITEM_DESC ASC]]>
	</queryString>

	<field name="BLI_ITEM_GROUP" class="java.lang.String"/>
