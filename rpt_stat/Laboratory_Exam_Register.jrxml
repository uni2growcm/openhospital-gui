	<queryString>
		<![CDATA[SELECT
	lab.LAB_DATE as LAB_DATE,
	lab.LAB_PAT_NAME as PAT_NAME,
	exa.EXA_DESC as EXAM_DESC,
	afm.AFM_DESC as MATERIAL,
	lab.LAB_RES as RESULT,
	lab.LAB_PRESCRIBER as PRESCRIBER,
	bll.BLL_STATUS as PAID_STATUS
FROM OH_LABORATORY lab
	JOIN OH_EXAM exa ON lab.LAB_EXA_ID_A = exa.EXA_ID_A
	LEFT JOIN OH_ARTICLE_FAMILIES afm ON exa.EXA_AFM_ID = afm.AFM_ID
	LEFT JOIN OH_BILLS bll ON lab.LAB_BILL_ID = bll.BLL_ID
WHERE DATE(lab.LAB_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
ORDER BY lab.LAB_DATE]]>
	</queryString>
	<field name="LAB_DATE" class="java.sql.Timestamp"/>
	<field name="PAT_NAME" class="java.lang.String"/>
	<field name="EXAM_DESC" class="java.lang.String"/>
	<field name="MATERIAL" class="java.lang.String"/>
	<field name="RESULT" class="java.lang.String"/>
	<field name="PRESCRIBER" class="java.lang.String"/>
	<field name="PAID_STATUS" class="java.lang.String"/>
