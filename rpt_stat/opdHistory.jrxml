	<queryString>
		<![CDATA[SELECT o.OPD_AGE, o.OPD_SEX, o.OPD_NOTE, o.OPD_DIS_ID_A, o.OPD_DIS_ID_A_2, o.OPD_DIS_ID_A_3,
	DATE_FORMAT(v.VST_DATE, '%d/%m/%Y') AS OPD_DATE_NEXT_VIS, DATE_FORMAT(o.OPD_DATE, '%d/%m/%Y') as OPD_DATE,  o.OPD_ID,
	v.VST_DATE as dateTo, o.OPD_DATE as dateFrom,
       p. PAT_ID, p.PAT_NAME,
	pe.PEX_TEMP,pe.PEX_WEIGHT,pe.PEX_HEIGHT,pe.PEX_AP_MAX  
FROM oh_opd o
JOIN oh_patient p ON p.PAT_ID = o.OPD_PAT_ID
JOIN oh_visits v ON v.VST_PAT_ID = p.PAT_ID
LEFT JOIN oh_patientexamination pe 
    ON o.OPD_PAT_ID = pe.PEX_PAT_ID 
    AND o.OPD_DATE = pe.PEX_DATE
    AND pe.PEX_ID = (
        SELECT MAX(pe2.PEX_ID)
        FROM oh_patientexamination pe2
        WHERE pe2.PEX_PAT_ID = o.OPD_PAT_ID
        AND pe2.PEX_DATE = o.OPD_DATE
    )
WHERE DATE(o.OPD_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})]]>
	</queryString>
