<?xml version="1.0" encoding="UTF-8"  ?>
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="FamilyPlanningRegister"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="782"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="AllSectionsNoDetail"
		 isFloatColumnFooter="true"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="Hospital" isForPrompting="true" class="java.lang.String"/>
	<parameter name="Address" isForPrompting="true" class="java.lang.String"/>
	<parameter name="City" isForPrompting="true" class="java.lang.String"/>
	<parameter name="Email" isForPrompting="true" class="java.lang.String"/>
	<parameter name="Telephone" isForPrompting="true" class="java.lang.String"/>
	<parameter name="fromdate" isForPrompting="true" class="java.util.Date"/>
	<parameter name="todate" isForPrompting="true" class="java.util.Date"/>
	<parameter name="SUBREPORT_DIR" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["./rpt_stat/"]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGO_PATH" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["./rsc/images/"]]></defaultValueExpression>
	</parameter>

	<queryString><![CDATA[SELECT
	FPL.FPL_ID AS FPL_ID,
	FPL.FPL_DATE AS FPL_DATE,
	PAT.PAT_NAME AS PAT_NAME,
	IF(PAT.PAT_BDATE is not null, ROUND(DATEDIFF(CURDATE(), DATE(PAT.PAT_BDATE)) / 365,0), PAT.PAT_AGE) AS PAT_AGE,
	FPL.FPL_METHOD AS FPL_METHOD,
	FPL.FPL_REASON AS FPL_REASON,
	FPL.FPL_PREVIOUS_METHOD AS FPL_PREVIOUS_METHOD,
	FPL.FPL_PARITY AS FPL_PARITY,
	FPL.FPL_COUNSELING AS FPL_COUNSELING,
	FPL.FPL_NEXT_APPOINTMENT AS FPL_NEXT_APPOINTMENT
FROM OH_FAMILYPLANNING FPL
	JOIN OH_PATIENT PAT ON ( PAT.PAT_ID = FPL.FPL_PAT_ID )
WHERE FPL.FPL_DATE BETWEEN $P{fromdate} AND $P{todate}
ORDER BY FPL.FPL_DATE ASC]]></queryString>

	<field name="FPL_ID" class="java.lang.Integer"/>
	<field name="FPL_DATE" class="java.sql.Date"/>
	<field name="PAT_NAME" class="java.lang.String"/>
	<field name="PAT_AGE" class="java.math.BigDecimal"/>
	<field name="FPL_METHOD" class="java.lang.String"/>
	<field name="FPL_REASON" class="java.lang.String"/>
	<field name="FPL_PREVIOUS_METHOD" class="java.lang.String"/>
	<field name="FPL_PARITY" class="java.lang.Integer"/>
	<field name="FPL_COUNSELING" class="java.lang.Boolean"/>
	<field name="FPL_NEXT_APPOINTMENT" class="java.sql.Date"/>

		<background>
			<band height="0" isSplitAllowed="true" >
			</band>
		</background>
		<title>
			<band height="0" isSplitAllowed="true" >
			</band>
		</title>
		<pageHeader>
			<band height="46" isSplitAllowed="true" >
				<staticText>
					<reportElement
						x="0"
						y="0"
						width="782"
						height="24"
						key="staticText-1"/>
					<textElement textAlignment="Center">
						<font size="16" isBold="true"/>
					</textElement>
					<text><![CDATA[REGISTRE DE PLANIFICATION FAMILIALE]]></text>
				</staticText>
				<textField isStretchWithOverflow="false" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self" >
					<reportElement
						x="0"
						y="26"
						width="782"
						height="16"
						key="textField-1"/>
					<textElement textAlignment="Center">
						<font size="10"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$P{Hospital}+" - "+$P{Address}+", "+$P{City}+" — Période du " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fromdate}) + " au " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{todate})]]></textFieldExpression>
				</textField>
			</band>
		</pageHeader>
		<columnHeader>
			<band height="20" isSplitAllowed="true" >
				<staticText>
					<reportElement x="0" y="0" width="70" height="20" key="staticText-2"/>
					<box><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[Date]]></text>
				</staticText>
				<staticText>
					<reportElement x="70" y="0" width="180" height="20" key="staticText-3"/>
					<box><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[Patiente]]></text>
				</staticText>
				<staticText>
					<reportElement x="250" y="0" width="40" height="20" key="staticText-4"/>
					<box><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[Âge]]></text>
				</staticText>
				<staticText>
					<reportElement x="290" y="0" width="30" height="20" key="staticText-4b"/>
					<box><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[Parité]]></text>
				</staticText>
				<staticText>
					<reportElement x="320" y="0" width="120" height="20" key="staticText-5"/>
					<box><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[Motif]]></text>
				</staticText>
				<staticText>
					<reportElement x="440" y="0" width="120" height="20" key="staticText-6"/>
					<box><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[Méthode précédente]]></text>
				</staticText>
				<staticText>
					<reportElement x="560" y="0" width="120" height="20" key="staticText-7"/>
					<box><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[Méthode retenue]]></text>
				</staticText>
				<staticText>
					<reportElement x="680" y="0" width="40" height="20" key="staticText-8"/>
					<box><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[Counsel.]]></text>
				</staticText>
				<staticText>
					<reportElement x="720" y="0" width="62" height="20" key="staticText-9"/>
					<box><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[Prochain RDV]]></text>
				</staticText>
			</band>
		</columnHeader>
		<detail>
			<band height="16" isSplitAllowed="true" >
				<textField isStretchWithOverflow="false" isBlankWhenNull="true" evaluationTime="Now" pattern="dd/MM/yyyy" hyperlinkType="None" hyperlinkTarget="Self" >
					<reportElement x="0" y="0" width="70" height="16" key="textField-3"/>
					<box><pen lineWidth="0.25"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{FPL_DATE}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self" >
					<reportElement x="70" y="0" width="180" height="16" key="textField-4"/>
					<box><pen lineWidth="0.25"/></box>
					<textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{PAT_NAME}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self" >
					<reportElement x="250" y="0" width="40" height="16" key="textField-5"/>
					<box><pen lineWidth="0.25"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{PAT_AGE}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self" >
					<reportElement x="290" y="0" width="30" height="16" key="textField-5b"/>
					<box><pen lineWidth="0.25"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{FPL_PARITY}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self" >
					<reportElement x="320" y="0" width="120" height="16" key="textField-6"/>
					<box><pen lineWidth="0.25"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{FPL_REASON}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self" >
					<reportElement x="440" y="0" width="120" height="16" key="textField-7"/>
					<box><pen lineWidth="0.25"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{FPL_PREVIOUS_METHOD}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self" >
					<reportElement x="560" y="0" width="120" height="16" key="textField-8"/>
					<box><pen lineWidth="0.25"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{FPL_METHOD}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self" >
					<reportElement x="680" y="0" width="40" height="16" key="textField-9"/>
					<box><pen lineWidth="0.25"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{FPL_COUNSELING} != null && $F{FPL_COUNSELING} ? "Oui" : "Non"]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" isBlankWhenNull="true" evaluationTime="Now" pattern="dd/MM/yyyy" hyperlinkType="None" hyperlinkTarget="Self" >
					<reportElement x="720" y="0" width="62" height="16" key="textField-10"/>
					<box><pen lineWidth="0.25"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{FPL_NEXT_APPOINTMENT}]]></textFieldExpression>
				</textField>
			</band>
		</detail>
		<columnFooter>
			<band height="0" isSplitAllowed="true" >
			</band>
		</columnFooter>
		<pageFooter>
			<band height="0" isSplitAllowed="true" >
			</band>
		</pageFooter>
		<summary>
			<band height="0" isSplitAllowed="true" >
			</band>
		</summary>
</jasperReport>
