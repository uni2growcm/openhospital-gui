	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["./rpt/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
	DATE_FORMAT(LAB_DATE, '%d/%m/%Y') as LAB_DATE,
	PAT_ID, 
	PAT_NAME,      
	PAT_SEX,
	PAT_BDATE,
	lab.LAB_EXA_ID_A as CODE_EXA,
	IF(PAT_BDATE is not null,DATEDIFF(CURDATE(),DATE(PAT_BDATE))/365,PAT_AGE) as age,	
	IF((LAB_RES is not null) and (exa.EXA_PROC="1"),LAB_RES,"") as RESULTS1,
	IF((LAB_RES is not null) and (exa.EXA_PROC="1"),IF(LAB_RES="PERSONNALISE", LAB_RES, ""),"") as RESULTS,
	IF(LAB_NOTE is null,"",LAB_NOTE) as LAB_NOTE,
	IF(lab.LAB_EXA_ID_A="PCV", (select LW.LABR_RES_VALUE from oh_laboratoryrow LW where (LW.LABR_DESC="GRAM - CLUS-CELLS" and LW.LABR_LAB_ID=lab.LAB_ID) ),"") as CLUE_CELLS,
	IF(lab.LAB_EXA_ID_A="PCV", (select LW.LABR_RES_VALUE from oh_laboratoryrow LW where (LW.LABR_DESC="GRAM - CELLULES ÉPITHÉLIALES" and LW.LABR_LAB_ID=lab.LAB_ID) ),"") as CELL_EPITHE,
	IF(lab.LAB_EXA_ID_A="PCV", (select LW.LABR_RES_VALUE from oh_laboratoryrow LW where (LW.LABR_DESC="GRAM - BACILLES" and LW.LABR_LAB_ID=lab.LAB_ID) ),"") as GRAM_BACILLE,
	IF(lab.LAB_EXA_ID_A="PCV", (select LW.LABR_RES_VALUE from oh_laboratoryrow LW where (LW.LABR_DESC="GRAM - COCCI" and LW.LABR_LAB_ID=lab.LAB_ID) ),"") as GRAM_COCCI,

	IF(lab.LAB_EXA_ID_A="PU", (select LW.LABR_RES_VALUE from oh_laboratoryrow LW where (LW.LABR_DESC="GRAM - CELLULES ÉPITHÉLIALES" and LW.LABR_LAB_ID=lab.LAB_ID) ),"") as CELL_EPITHE_PU,
	IF(lab.LAB_EXA_ID_A="PU", (select LW.LABR_RES_VALUE from oh_laboratoryrow LW where (LW.LABR_DESC="GRAM - DIPLOCOQUES DE NEISSER" and LW.LABR_LAB_ID=lab.LAB_ID) ),"") as DIPLO_NEISSER_PU,
	IF(lab.LAB_EXA_ID_A="PU", (select LW.LABR_RES_VALUE from oh_laboratoryrow LW where (LW.LABR_DESC="GRAM - BACILLES" and LW.LABR_LAB_ID=lab.LAB_ID) ),"") as GRAM_BACILLE_PU,
      
    IF(lab.LAB_EXA_ID_A="GE", (select LW.LABR_RES_VALUE from oh_laboratoryrow LW where (LW.LABR_DESC="PLASMODIUM MALARIA" and LW.LABR_LAB_ID=lab.LAB_ID) ),"") as GE_MALARIA,
	IF(lab.LAB_EXA_ID_A="GE", (select LW.LABR_RES_VALUE from oh_laboratoryrow LW where (LW.LABR_DESC="P. VIVAX" and LW.LABR_LAB_ID=lab.LAB_ID) ),"") as GE_VIVAX,
	IF(lab.LAB_EXA_ID_A="GE", (select LW.LABR_RES_VALUE from oh_laboratoryrow LW where (LW.LABR_DESC="P. OVALE" and LW.LABR_LAB_ID=lab.LAB_ID) ),"") as GE_OVALE,
	IF(lab.LAB_EXA_ID_A="GE", (select LW.LABR_RES_VALUE from oh_laboratoryrow LW where (LW.LABR_DESC="P. FALCIPARUM" and LW.LABR_LAB_ID=lab.LAB_ID) ),"") as GE_FALCIPARUM


From oh_laboratory lab 
       join oh_exam exa on (lab.LAB_EXA_ID_A = exa.EXA_ID_A) 
       join oh_patient pat on (pat.PAT_ID = lab.LAB_PAT_ID )

WHERE DATE(LAB_DATE) BETWEEN DATE($P{fromdate}) and DATE($P{todate})

Order by LAB_ID]]>
	</queryString>
