[07/May/2026 09:19:20] [admin:admin] DEBUG - Query SELECT OPD_PROG_YEAR, PAT_ID, OPD_DATE, PAT_CITY, PAT_ADDR, COALESCE(PAT_SEX, OPD_SEX) AS PAT_SEX, 
		COALESCE(PAT_AGE, OPD_AGE) AS PAT_AGE, DATEDIFF(OPD_DATE,PAT_BDATE) AS DAYS,
		(SELECT DCL_ID_A FROM OH_DISEASE JOIN OH_DISEASETYPE ON DIS_DCL_ID_A = DCL_ID_A WHERE DIS_ID_A = OPD_DIS_ID_A) AS TYPE1,
        (SELECT DIS_DESC FROM OH_DISEASE WHERE DIS_ID_A = OPD_DIS_ID_A) AS DISEASE1,
		(SELECT DIS_DESC FROM OH_DISEASE WHERE DIS_ID_A = OPD_DIS_ID_A_2) AS DISEASE2,
		(SELECT DIS_DESC FROM OH_DISEASE WHERE DIS_ID_A = OPD_DIS_ID_A_3) AS DISEASE3,
       	IF(OPD_NEW_PAT=\'N\',\'New\',\'Re\') AS ATTENDANCE
FROM OH_OPD LEFT JOIN OH_PATIENT ON PAT_ID = OPD_PAT_ID
LEFT JOIN OH_WARD ON OPD_WRD_ID_A = WRD_ID_A
WHERE DATE(OPD_DATE) BETWEEN DATE(\'2026-04-29\') AND DATE(\'2026-05-06\')
ORDER BY OPD_DATE ASC (org.isf.utils.db.DbQueryLogger.getData(DbQueryLogger.java:52))
