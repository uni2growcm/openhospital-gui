        _newborn.NBN_PAT_ID,
        _newborn.NBN_BIRTH_WEIGHT,
        _newborn.NBN_NEONATAL_STATUS,
        _newborn.NBN_APGAR_SCORE_1MIN,
        _newborn.NBN_APGAR_SCORE_5MIN,
        _delivery.PRGDLV_DELIVERYMODE,
        _delivery.PRGDLV_DATE,
        _delivery.PRGDLV_ROM_DATETIME,
        _delivery.PRGDLV_PERINEAL_INTEGRITY,
        _delivery.PRGDLV_PLACENTA_COMPLETE,
        _delivery.PRGDLV_ESTIMATED_BLD_LOSS,
        _newborn.NBN_CRY_TIME,
        _newborn.NBN_HIV_STATUS,
        _newborn.NBN_CONGENITAL_ANOMALIES,
        _newborn.NBN_RESUSCITATION_REQUIRED,
        _delivery.PRGDLV_TYPE_ID 
    FROM
        oh_patient _mother 
    INNER JOIN
        oh_pregnancy _pregnancy 
            ON _mother.PAT_ID = _pregnancy.PRG_PAT_ID 
    INNER JOIN
        oh_pregnancydelivery _delivery 
            ON _delivery.PRGDLV_PRG_ID = _pregnancy.PRG_ID 
    INNER JOIN
        oh_newborn _newborn 
            ON _newborn.NBN_DLV_ID = _delivery.PRGDLV_ID 
    WHERE
        (
            _mother.PAT_DELETED = 'N' 
            OR _mother.PAT_DELETED IS NULL
        ) 
        AND DATE(_delivery.PRGDLV_DATE) >= ? 
        AND DATE(_delivery.PRGDLV_DATE) <= ? 
    limit
        ? (org.hibernate.engine.jdbc.spi.SqlStatementLogger.logStatement(SqlStatementLogger.java:135))
