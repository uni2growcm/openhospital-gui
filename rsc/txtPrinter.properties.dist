# This file contains text printing information
# MODE = TXT, PDF or ZPL
USE_DEFAULT_PRINTER=yes
PRINT_AS_PAID=no
PRINT_WITHOUT_ASK=no
MODE=PDF
#TXT_CHAR_HEIGHT=10
#TXT_CHAR_WIDTH=10
ZPL_FONT_TYPE=0
ZPL_ROW_HEIGHT=25

# CHARSET: encoding sent to printer (ISO-8859-1, Cp850, Cp1252...)
# Use ISO-8859-1 for most modern ESC/POS thermal printers
CHARSET=Cp850