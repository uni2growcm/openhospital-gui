	<parameter name="idPatient" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="opdDate" class="java.util.Date" isForPrompting="false"/>
	<parameter name="idOpd" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[select  GROUP_CONCAT(DIS_DESC) 
from    oh_disease
where   DIS_ID_A IN (
		      select OPD_DIS_ID_A
		      from oh_opd
                      where  OPD_ID = $P{idOpd}
		     ) or 
        DIS_ID_A IN (
		      select OPD_DIS_ID_A_2
		      from oh_opd
                      where  OPD_ID = $P{idOpd}
		     ) or
	DIS_ID_A IN (
		      select OPD_DIS_ID_A_3
		      from oh_opd
                      where  OPD_ID = $P{idOpd}
		     )]]>
	</queryString>
	<field name="GROUP_CONCAT(DIS_DESC)" class="java.lang.String">
