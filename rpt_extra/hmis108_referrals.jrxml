	<queryString>
		<![CDATA[select 'TotalAdmissions' as Description,count(*) as Number from OH_ADMISSION
where year(ADM_DATE_ADM) = $P{year}
and month(ADM_DATE_ADM) = $P{month}
and ADM_DELETED = 'N'
union
select 'InpatientsReferredTo',count(*) from OH_ADMISSION
where year(ADM_DATE_ADM) = $P{year}
and month(ADM_DATE_ADM) = $P{month}
and ADM_DELETED = 'N'
and ADM_ADMT_ID_A_ADM = 'R'
union
select 'InpatientsReferredFrom',count(*) from OH_ADMISSION
where year(ADM_DATE_DIS) = $P{year}
and month(ADM_DATE_DIS) = $P{month}
and ADM_DELETED = 'N'
and ADM_DIST_ID_A = 'B']]>
	</queryString>
