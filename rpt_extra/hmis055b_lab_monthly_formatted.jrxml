	</variable>
	<variable name="swabs_positive" class="java.lang.Long">
		<variableExpression><![CDATA[new Long($F{swabs_done}.longValue() - $F{swabs_negative}.longValue())]]></variableExpression>
	</variable>
	<variable name="tissues_positive" class="java.lang.Long">
		<variableExpression><![CDATA[new Long($F{tissues_done}.longValue() - $F{tissues_negative}.longValue())]]></variableExpression>
	</variable>
	<variable name="csf_positive" class="java.lang.Long">
		<variableExpression><![CDATA[new Long($F{csf_done}.longValue() - $F{csf_negative}.longValue())]]></variableExpression>
	</variable>
