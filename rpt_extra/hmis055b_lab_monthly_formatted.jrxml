	<parameter name="HEADER_BUNDLE" class="java.util.ResourceBundle" isForPrompting="false">
		<defaultValueExpression><![CDATA[java.util.ResourceBundle.getBundle("ReportHeader", $P{REPORT_LOCALE} != null ? $P{REPORT_LOCALE} : java.util.Locale.getDefault())]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select   
        nullif(blood_done,0) blood_done,
        nullif(blood_negative,0) blood_negative,
        nullif(urine_done,0) urine_done,
        nullif(urine_negative,0) urine_negative,
        nullif(stool_done,0) stool_done,
        nullif(stool_negative,0) stool_negative,
        nullif(sputum_done,0) sputum_done,
        nullif(sputum_negative,0) sputum_negative,
        nullif(csf_done,0) csf_done,
        nullif(csf_negative,0) csf_negative,
        nullif(swabs_done,0) swabs_done,
        nullif(swabs_negative,0) swabs_negative,
        nullif(tissues_done,0) tissues_done,
        nullif(tissues_negative,0) tissues_negative,
        nullif(row_total,0) row_total,
        nullif(other_total,0) other_total,
        EXC_DESC, 
        EXA_DESC
from (
        select et.EXC_DESC, ex.EXA_DESC,
           (select 
               count(*) 
            from 
               OH_LABORATORY l
            where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(l.LAB_DATE)=$P{month} and year(l.LAB_DATE)=$P{year}
               and l.LAB_MATERIAL = 'Blood'
            ) blood_done,
        
           (select 
               count(*) 
           from 
               OH_LABORATORY l
           where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(LAB_DATE)=$P{month} and year(LAB_DATE)=$P{year}
               and l.LAB_RES=ex.EXA_DEFAULT
               and l.LAB_MATERIAL = 'Blood'
           ) blood_negative, 
        
           (select 
               count(*) 
            from 
               OH_LABORATORY l
            where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(l.LAB_DATE)=$P{month} and year(l.LAB_DATE)=$P{year}
               and l.LAB_MATERIAL = 'Urine'
           ) urine_done,
        
           ( select 
               count(*) 
           from 
               OH_LABORATORY l
           where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(LAB_DATE)=$P{month} and year(LAB_DATE)=$P{year}
               and l.LAB_RES=ex.EXA_DEFAULT
               and l.LAB_MATERIAL = 'Urine'
           ) urine_negative, 
        
           (select 
               count(*) 
            from 
               OH_LABORATORY l
            where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(l.LAB_DATE)=$P{month} and year(l.LAB_DATE)=$P{year}
               and l.LAB_MATERIAL = 'Stool'   
            ) stool_done,
        
           ( select 
               count(*) 
           from 
               OH_LABORATORY l
           where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(LAB_DATE)=$P{month} and year(LAB_DATE)=$P{year}
               and l.LAB_RES=ex.EXA_DEFAULT
               and l.LAB_MATERIAL = 'Stool'
           ) stool_negative, 
        
           (select 
               count(*) 
            from 
               OH_LABORATORY l
            where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(l.LAB_DATE)=$P{month} and year(l.LAB_DATE)=$P{year}
               and l.LAB_MATERIAL = 'Sputum'
            ) sputum_done,
        
           ( select 
               count(*) 
           from 
               OH_LABORATORY l
           where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(LAB_DATE)=$P{month} and year(LAB_DATE)=$P{year}
               and l.LAB_RES=ex.EXA_DEFAULT
               and l.LAB_MATERIAL = 'Sputum'   
           ) sputum_negative, 
        
          (select 
               count(*) 
           from 
               OH_LABORATORY l
           where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(l.LAB_DATE)=$P{month} and year(l.LAB_DATE)=$P{year}
               and l.LAB_MATERIAL = 'CSF'
           ) csf_done, 
        
           ( select 
               count(*) 
           from 
               OH_LABORATORY l
           where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(LAB_DATE)=$P{month} and year(LAB_DATE)=$P{year}
               and l.LAB_RES=ex.EXA_DEFAULT
               and l.LAB_MATERIAL = 'CSF'
           ) csf_negative, 
        
           (select 
               count(*) 
            from 
               OH_LABORATORY l
            where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(l.LAB_DATE)=$P{month} and year(l.LAB_DATE)=$P{year}
               and l.LAB_MATERIAL = 'Swabs'
           ) swabs_done,
        
           ( select 
               count(*) 
           from 
               OH_LABORATORY l
           where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(LAB_DATE)=$P{month} and year(LAB_DATE)=$P{year}
               and l.LAB_RES=ex.EXA_DEFAULT
               and l.LAB_MATERIAL = 'Swabs'   
           ) swabs_negative, 
        
           (select 
               count(*) 
            from 
               OH_LABORATORY l
             where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(l.LAB_DATE)=$P{month} and year(l.LAB_DATE)=$P{year}
               and l.LAB_MATERIAL = 'Tissues'
           ) tissues_done,
        
           ( select 
               count(*) 
             from 
               OH_LABORATORY l
             where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(LAB_DATE)=$P{month} and year(LAB_DATE)=$P{year}
               and l.LAB_RES=ex.EXA_DEFAULT
               and l.LAB_MATERIAL = 'Tissues'
           ) tissues_negative, 
        
           (select 
               count(*)  
           from 
               OH_LABORATORY l
           where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(LAB_DATE)=$P{month} 
               and year(LAB_DATE)=$P{year}
           group by 
               EXA_DESC
           ) row_total, 
          
          (select 
               count(*)  
           from 
               OH_LABORATORY l
           where 
               l.LAB_EXA_ID_A = ex.EXA_ID_A
               and month(l.LAB_DATE)=$P{month} 
               and year(l.LAB_DATE)=$P{year}
               and (l.LAB_MATERIAL not in ('Blood' , 'Urine' , 'Stool' , 'Sputum' , 'CSF' , 'Swabs' , 'Tissues')
               or l.LAB_MATERIAL is null)     
           group by 
               EXA_DESC
           ) other_total       

        
        
        from OH_EXAM ex, OH_EXAMTYPE et
        where et.EXC_ID_A = ex.EXA_EXC_ID_A
        order by 1,2
) final]]>
	</queryString>
	<field name="blood_done" class="java.lang.Long"/>
