	</variable>
	<variable name="stool_positive" class="java.lang.Long">
		<variableExpression><![CDATA[new Long($F{stool_done}.longValue() - $F{stool_negative}.longValue())]]></variableExpression>
	</variable>
	<variable name="sputum_positive" class="java.lang.Long">
