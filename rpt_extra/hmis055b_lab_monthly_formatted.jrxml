		<variableExpression><![CDATA[$F{row_total}]]></variableExpression>
	</variable>
	<variable name="blood_positive" class="java.lang.Long">
		<variableExpression><![CDATA[new Long($F{blood_done}.longValue() -$F{blood_negative}.longValue())]]></variableExpression>
	</variable>
	<variable name="urine_positve" class="java.lang.Long">
