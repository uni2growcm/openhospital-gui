        h1_0.hvi_status 
    from
        oh_hiv_infant h1_0 
    where
        (
            ? is null 
            or h1_0.hvi_pat_id=?
        ) 
        and (
            ? is null 
            or h1_0.hvi_status=?
        ) 
        and (
            ? is null 
            or h1_0.hvi_feeding_type=?
