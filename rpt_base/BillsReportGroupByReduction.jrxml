	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="foumban.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="270"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="723"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="Hospital" class="java.lang.String"/>
	<parameter name="Address" class="java.lang.String"/>
	<parameter name="City" class="java.lang.String"/>
	<parameter name="Email" class="java.lang.String"/>
	<parameter name="Telephone" class="java.lang.String"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="reductionplan" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    BLL_ID,
    BLL_DATE,
    BLL_UPDATE,
    BLL_PAT_NAME,
    BLL_AMOUNT,
    PAID,
    IF(
        DATE(BLL_DATE) BETWEEN $P{fromdate} AND $P{todate},
        BLL_AMOUNT - IF(PAID IS NULL, 0, PAID),
        0
    ) AS BALANCE,
    BLL_STATUS,
    RP_DESCRIPTION,
    (
        SELECT SUM(ABS(blp1.BLP_AMOUNT))
        FROM OH_BILLPAYMENTS blp1
        JOIN OH_BILLS b1
            ON b1.BLL_ID = blp1.BLP_ID_BILL
        WHERE b1.BLL_PARENT_ID = BILLS1.BLL_ID
    ) AS REFUNDED_AMOUNT
FROM (
    SELECT
        BLL_ID,
        BLL_DATE,
        BLL_UPDATE,
        BLL_PAT_NAME,
        BLL_AMOUNT,
        IF(
            DATE(BLP_DATE) BETWEEN $P{fromdate} AND $P{todate},
            SUM(BLP_AMOUNT),
            0
        ) AS PAID,
        BLL_STATUS,
        IFNULL(RP_DESCRIPTION, 'AUCUNE REDUCTION') AS RP_DESCRIPTION
    FROM (
        SELECT *
        FROM OH_BILLS
        LEFT JOIN OH_BILLPAYMENTS
            ON BLL_ID = BLP_ID_BILL
        LEFT JOIN OH_REDUCTIONPLAN
            ON BLL_RP_ID = RP_ID
        WHERE BLL_STATUS <> 'D'
          AND BLL_PARENT_ID IS NULL
          AND (
                DATE(BLL_DATE) BETWEEN $P{fromdate} AND $P{todate}
                OR DATE(BLP_DATE) BETWEEN $P{fromdate} AND $P{todate}
              )
          AND (
                (
                    BLL_RP_ID IN (
                        SELECT RP_ID
                        FROM OH_REDUCTIONPLAN
                    )
                    AND $P{reductionplan} = 'A'
                )
                OR (
                    BLL_RP_ID IN (
                        SELECT RP_ID
                        FROM OH_REDUCTIONPLAN
                        WHERE RP_ID =$P{reductionplan}
                    )
                    AND $P{reductionplan} <> 'A'
                    AND $P{reductionplan} <> 'S'
                )
                OR (
                    BLL_RP_ID NOT IN (
                        SELECT RP_ID
                        FROM OH_REDUCTIONPLAN
                    )
                    AND $P{reductionplan} = 'S'
                )
              )
    ) OH_PAYMENTS
    GROUP BY BLL_ID
) BILLS1
ORDER BY
    RP_DESCRIPTION,
    BLL_DATE;]]>
	</queryString>
