				<textFieldExpression><![CDATA["HomeVisit".equals($F{TYPE}) ? 
	($R{Status} + 
		("PLANNED".equals($F{DETAILS_1}) ? $R{Status.planned} :
		 "COMPLETED".equals($F{DETAILS_1}) ? $R{Status.completed} :
		 "CANCELLED".equals($F{DETAILS_1}) ? $R{Status.cancelled} :
		 "POSTPONED".equals($F{DETAILS_1}) ? $R{Status.postponed} : $F{DETAILS_1})) :
("FamilyPlanning".equals($F{TYPE}) ?
	($R{Status} + 
		("ACTIVE".equals($F{DETAILS_1}) ? $R{FP.status.active} :
		 "STOPPED".equals($F{DETAILS_1}) ? $R{FP.status.stopped} :
		 "CHANGED".equals($F{DETAILS_1}) ? $R{FP.status.changed} :
		 "LOST_TO_FOLLOWUP".equals($F{DETAILS_1}) ? $R{FP.status.lost} : $F{DETAILS_1})) :
("HIV".equals($F{TYPE}) ?
	($R{Status} + 
		("ACTIVE".equals($F{DETAILS_1}) ? $R{HIV.status.active} :
		 "LOST".equals($F{DETAILS_1}) ? $R{HIV.status.lost} :
		 "DECEASED".equals($F{DETAILS_1}) ? $R{HIV.status.deceased} :
		 "TRANSFERRED".equals($F{DETAILS_1}) ? $R{HIV.status.transferred} : $F{DETAILS_1})) :
("Maternity".equals($F{TYPE}) ?
	($R{Status} + 
		("ONGOING".equals($F{DETAILS_1}) ? $R{Pregnancy.status.ongoing} :
		 "COMPLETED".equals($F{DETAILS_1}) ? $R{Pregnancy.status.completed} :
		 "TERMINATED".equals($F{DETAILS_1}) ? $R{Pregnancy.status.terminated} : $F{DETAILS_1})) :
("OPD".equals($F{DETAILS_1}) ? $R{OPD} : $F{DETAILS_1}))))]]></textFieldExpression>
