"Tuberculosis".equals($F{TYPE}) ? $R{Tuberculosis} :
"Maternity".equals($F{TYPE}) ? $R{Maternity} :
"FamilyPlanning".equals($F{TYPE}) ? $R{FamilyPlanning} :
"HIV".equals($F{TYPE}) ? $R{HIV} :
"Vaccines".equals($F{TYPE}) ? $R{Vaccines} :
$F{TYPE}]]></textFieldExpression>
