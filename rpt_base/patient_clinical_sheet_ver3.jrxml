	<parameter name="patientID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["./rpt_base/"]]></defaultValueExpression>
	</parameter>
	<parameter name="Type" class="java.lang.String"/>
	<parameter name="Date_from" class="java.lang.String"/>
	<parameter name="Date_to" class="java.lang.String"/>
	<parameter name="Opd" class="java.lang.Boolean"/>
	<parameter name="Admission" class="java.lang.Boolean"/>
	<parameter name="Drugs" class="java.lang.Boolean"/>
	<parameter name="Examination" class="java.lang.Boolean"/>
	<parameter name="All" class="java.lang.Boolean"/>
	<parameter name="Laboratory" class="java.lang.Boolean"/>
	<parameter name="Operations" class="java.lang.Boolean"/>
	<parameter name="Vaccines" class="java.lang.Boolean"/>
	<parameter name="HomeVisit" class="java.lang.Boolean"/>
	<parameter name="Tuberculosis" class="java.lang.Boolean"/>
	<parameter name="Maternity" class="java.lang.Boolean"/>
	<parameter name="FamilyPlanning" class="java.lang.Boolean"/>
	<parameter name="HIV" class="java.lang.Boolean"/>
	<parameter name="PATIENT_PHOTO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="Hospital" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="HOSPITAL_LOGO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./rsc/images/logo_hospital.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="OH_LOGO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./rsc/images/logo_report.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="HEADER_BUNDLE" class="java.util.ResourceBundle" isForPrompting="false">
		<defaultValueExpression><![CDATA[java.util.ResourceBundle.getBundle("ReportHeader", $P{REPORT_LOCALE} != null ? $P{REPORT_LOCALE} : java.util.Locale.getDefault())]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT TYPE, DATE, IDS, NOTE, DETAILS_1, DETAILS_2, DETAILS_3, DETAILS_4
FROM (
	SELECT CONCAT("Opd", " (", OPD_PROG_YEAR, ")") AS TYPE,
	   OPD_DATE AS DATE, OPD_ID AS IDS,
	   IF(OPD_NEW_PAT='N','New Attendance','Re-Attendance') AS DETAILS_1,
	   CONCAT((SELECT DIS_DESC FROM OH_DISEASE WHERE DIS_ID_A = OPD_DIS_ID_A)) AS DETAILS_2,
	   CONCAT(" + ", (SELECT DIS_DESC FROM OH_DISEASE WHERE DIS_ID_A = OPD_DIS_ID_A_2), " & ", (SELECT DIS_DESC FROM OH_DISEASE WHERE DIS_ID_A = OPD_DIS_ID_A_3)) AS DETAILS_3,
	   "" AS DETAILS_4,
	   OPD_NOTE AS NOTE
	FROM 
		OH_OPD
		LEFT JOIN OH_PATIENT ON (OPD_PAT_ID = PAT_ID)
	WHERE OPD_PAT_ID = $P{patientID} AND (DATE(OPD_DATE) BETWEEN $P{Date_from} AND $P{Date_to})
	
UNION

	SELECT CONCAT("ADM", " (", ADM_YPROG, ")") AS TYPE,
	   ADM_DATE_ADM AS DATE, ADM_ID AS IDS,
	   WRD_NAME AS DETAILS_1,
	   (SELECT DIS_DESC FROM OH_DISEASE WHERE DIS_ID_A = ADM_IN_DIS_ID_A) AS DETAILS_2,
	   CONCAT(DIST_DESC, " - ", (SELECT DIS_DESC FROM OH_DISEASE WHERE DIS_ID_A = ADM_OUT_DIS_ID_A), " - ", DATE_FORMAT(ADM_DATE_DIS, '%d/%m/%Y %H:%i')) AS DETAILS_3,
	   "" AS DETAILS_4,
	   ADM_NOTE AS NOTE
	FROM 
		OH_ADMISSION
		LEFT JOIN OH_WARD ON (WRD_ID_A = ADM_WRD_ID_A)
		LEFT JOIN OH_ADMISSIONTYPE ON (ADMT_ID_A = ADM_ADMT_ID_A_ADM)
		LEFT JOIN OH_DISCHARGETYPE ON (DIST_ID_A = ADM_DIST_ID_A)
	WHERE ADM_DELETED = 'N'
		AND ADM_PAT_ID = $P{patientID} AND (DATE(ADM_DATE_ADM) BETWEEN $P{Date_from} AND $P{Date_to})

UNION
    SELECT "Examination" AS TYPE,
	PEX_DATE AS DATE, PEX_NOTE AS IDS, 
    CONCAT(" Height:  ", PEX_HEIGHT, " - Weight: " , PEX_WEIGHT) AS DETAILS_1,
		CONCAT(" AP:  ", PEX_AP_MIN, "/ " , PEX_AP_MAX) AS DETAILS_2,
	    CONCAT(" Temperature:  ", PEX_TEMP)  AS DETAILS_3,
	    CONCAT(" O:  ", PEX_SAT)  AS DETAILS_4, PEX_NOTE AS NOTE
	FROM 
		OH_PATIENTEXAMINATION
	WHERE PEX_PAT_ID = $P{patientID} AND (DATE(PEX_DATE) BETWEEN $P{Date_from} AND $P{Date_to})
	
UNION

	SELECT "Drugs" AS TYPE,
	   MMVN_DATE AS DATE, MDSR_DESC AS IDS,
	   GROUP_CONCAT(CONCAT(MDSR_DESC, " - ", CAST(QTY AS CHAR), " ", MMVN_MDSR_UNITS) SEPARATOR '\n') AS DETAILS_1,
	   "" AS DETAILS_2,
	   "" AS DETAILS_3,
	   "" AS DETAILS_4,
	   "" AS NOTE
	FROM(
		SELECT MMVN_DATE,
			MDSR_DESC, SUM(MMVN_MDSR_QTY) AS QTY, MMVN_MDSR_UNITS
		FROM 
			OH_MEDICALDSRSTOCKMOVWARD
			LEFT JOIN OH_MEDICALDSR ON (MMVN_MDSR_ID = MDSR_ID)
		WHERE MMVN_PAT_ID = $P{patientID} AND (DATE(MMVN_DATE) BETWEEN $P{Date_from} AND $P{Date_to})
		GROUP BY DATE(MMVN_DATE), MMVN_MDSR_ID
	) AS MEDICALS_TABLE
GROUP BY DATE(DATE)

UNION

	SELECT "Operations" AS TYPE,
	   OPER_OPDATE AS DATE, OPE_DESC AS IDS,
	   "OPD" AS DETAILS_1,
	   CONCAT(OPE_DESC, " - ", OPER_RESULT) AS DETAILS_2,
	   "" AS DETAILS_3,
	   "" AS DETAILS_4,
	   OPER_REMARKS AS NOTE
	FROM(
		SELECT OPER_OPDATE, OPE_DESC, OPER_RESULT, OPER_REMARKS, OPER_OPD_ID
		FROM OH_OPERATIONROW
			LEFT JOIN OH_OPERATION ON (OPE_ID_A = OPER_ID_A)
			LEFT JOIN OH_OPD ON (OPER_OPD_ID = OPD_ID)
		WHERE OPD_PAT_ID = $P{patientID}
		  AND (DATE(OPER_OPDATE) BETWEEN $P{Date_from} AND $P{Date_to})
		-- GROUP BY DATE(OPER_OPDATE)
	) AS OPERATIONS_TABLE

UNION

	SELECT "Operations" AS TYPE,
	   OPER_OPDATE AS DATE, OPE_DESC AS IDS,
	   WRD_NAME AS DETAILS_1,
	   CONCAT(OPE_DESC, " - ", OPER_RESULT) AS DETAILS_2,
	   "" AS DETAILS_3,
	   "" AS DETAILS_4,
	   OPER_REMARKS AS NOTE
	FROM(
		SELECT OPER_OPDATE, OPE_DESC, OPER_RESULT, OPER_REMARKS, OPER_ADMISSION_ID, WRD_NAME
		FROM OH_OPERATIONROW
			LEFT JOIN OH_OPERATION ON (OPE_ID_A = OPER_ID_A)
			LEFT JOIN OH_ADMISSION ON (OPER_ADMISSION_ID = ADM_ID)
			LEFT JOIN OH_WARD ON (ADM_WRD_ID_A = WRD_ID_A)
		WHERE ADM_PAT_ID = $P{patientID}
		  AND (DATE(OPER_OPDATE) BETWEEN $P{Date_from} AND $P{Date_to})
		-- GROUP BY DATE(OPER_OPDATE)
	) AS OPERATIONS_TABLE
	
UNION

	SELECT "Laboratory" AS TYPE,
	   LAB_DATE AS DATE, LAB_RES AS IDS,
	   EXA_DESC DETAILS_1,
	   LAB_RES AS DETAILS_2,
	   "" AS DETAILS_3,
	   "" AS DETAILS_4,
	   LAB_NOTE AS NOTE
	FROM 
		OH_LABORATORY
		LEFT JOIN OH_EXAM ON (EXA_ID_A = LAB_EXA_ID_A)
		LEFT JOIN OH_LABORATORYROW ON LABR_LAB_ID = LAB_ID
	WHERE LAB_PAT_ID = $P{patientID} AND (DATE(LAB_DATE) BETWEEN $P{Date_from} AND $P{Date_to})
    AND EXA_PROC = 1
    
UNION

	SELECT "Laboratory" AS TYPE,
	   LAB_DATE AS DATE, LAB_ID AS IDS,
	   EXA_DESC DETAILS_1,
	   GROUP_CONCAT(LABR_DESC SEPARATOR ", " ) AS DETAILS_2,
	   "" AS DETAILS_3,
	   "" AS DETAILS_4,
	   LAB_NOTE AS NOTE
	FROM 
		OH_LABORATORY
		LEFT JOIN OH_EXAM ON (EXA_ID_A = LAB_EXA_ID_A)
		LEFT JOIN OH_LABORATORYROW ON LABR_LAB_ID = LAB_ID
	WHERE LAB_PAT_ID = $P{patientID} AND (DATE(LAB_DATE) BETWEEN $P{Date_from} AND $P{Date_to})
	AND EXA_PROC = 2
GROUP BY LABR_LAB_ID

UNION

	SELECT "Laboratory" AS TYPE,
	   LAB_DATE AS DATE, LAB_RES AS IDS,
	   EXA_DESC DETAILS_1,
	   LAB_RES AS DETAILS_2,
	   "" AS DETAILS_3,
	   "" AS DETAILS_4,
	   LAB_NOTE AS NOTE
	FROM 
		OH_LABORATORY
		LEFT JOIN OH_EXAM ON (EXA_ID_A = LAB_EXA_ID_A)
		LEFT JOIN OH_LABORATORYROW ON LABR_LAB_ID = LAB_ID
	WHERE LAB_PAT_ID = $P{patientID} AND (DATE(LAB_DATE) BETWEEN $P{Date_from} AND $P{Date_to})
    AND EXA_PROC = 3
    
UNION

	SELECT "Vaccines" AS TYPE,
	   PAV_DATE AS DATE, CAST(PAV_ID AS CHAR) AS IDS,
	   (SELECT VAC_DESC FROM OH_VACCINE WHERE VAC_ID_A = PAV_VAC_ID_A) AS DETAILS_1,
	   IFNULL((SELECT VACT_DESC FROM OH_VACCINETYPE WHERE VACT_ID_A = (SELECT VAC_VACT_ID_A FROM OH_VACCINE WHERE VAC_ID_A = PAV_VAC_ID_A)), "") AS DETAILS_2,
	   "" AS DETAILS_3,
	   "" AS DETAILS_4,
	   "" AS NOTE
	FROM 
		OH_PATIENTVACCINE
	WHERE PAV_ACTIVE = 1 AND PAV_PAT_ID = $P{patientID} AND (DATE(PAV_DATE) BETWEEN $P{Date_from} AND $P{Date_to})

UNION

	SELECT "HomeVisit" AS TYPE,
	   HV_VISIT_START_DATE AS DATE, CAST(HV_ID AS CHAR) AS IDS,
	   HV_STATUS AS DETAILS_1,
	   IFNULL((SELECT CONCAT(STF_FIRST_NAME, ' ', STF_LAST_NAME) FROM OH_STAFF WHERE STF_ID = HV_STAFF_ID), "") AS DETAILS_2,
	   IFNULL(HV_PURPOSE, "") AS DETAILS_3,
	   IFNULL(HV_OBSERVATIONS, "") AS DETAILS_4,
	   IFNULL(HV_CLINICAL_NOTES, "") AS NOTE
	FROM 
		OH_HOME_VISIT
	WHERE HV_DELETE = 1 AND HV_PAT_ID = $P{patientID} AND (DATE(HV_VISIT_START_DATE) BETWEEN $P{Date_from} AND $P{Date_to})

UNION

	SELECT "Tuberculosis" AS TYPE,
	   TBT_REG_DATE AS DATE, CAST(TBT_ID AS CHAR) AS IDS,
	   CONCAT("Class: ", TBT_CLASSIFICATION, " - Loc: ", TBT_DISEASE_LOCATION) AS DETAILS_1,
	   CONCAT("Regimen: ", IFNULL(TBT_REGIMEN_CODE, "-"), " - Status: ", TBT_STATUS) AS DETAILS_2,
	   IFNULL(CONCAT("Outcome: ", TBT_OUTCOME), "") AS DETAILS_3,
	   "" AS DETAILS_4,
	   IFNULL(TBT_NOTES, "") AS NOTE
	FROM 
		OH_TB_TREATMENT
	WHERE TBT_ACTIVE = 1 AND TBT_PAT_ID = $P{patientID} AND (DATE(TBT_REG_DATE) BETWEEN $P{Date_from} AND $P{Date_to})

UNION

	SELECT "Maternity" AS TYPE,
	   IFNULL(PRG_DATE, PRG_LMP) AS DATE, CAST(PRG_ID AS CHAR) AS IDS,
	   PRG_STATUS AS DETAILS_1,
	   CONCAT("LMP: ", IFNULL(DATE_FORMAT(PRG_LMP, '%d/%m/%Y'), "-"), " - EDD: ", IFNULL(DATE_FORMAT(PRG_EDD_LMP, '%d/%m/%Y'), "-")) AS DETAILS_2,
	   CONCAT("G: ", IFNULL(PRG_GRAVIDITY, 0), " / P: ", IFNULL(PRG_PARITY, 0)) AS DETAILS_3,
	   IFNULL(CONCAT("Risk: ", PRG_RISK_LEVEL), "") AS DETAILS_4,
	   "" AS NOTE
	FROM 
		OH_PREGNANCY
	WHERE PRG_ACTIVE = 1 AND PRG_PAT_ID = $P{patientID} AND (DATE(IFNULL(PRG_DATE, PRG_LMP)) BETWEEN $P{Date_from} AND $P{Date_to})

UNION

	SELECT "FamilyPlanning" AS TYPE,
	   FP_REGISTRATION_DATE AS DATE, CAST(FP_ID AS CHAR) AS IDS,
	   FP_STATUS AS DETAILS_1,
	   IFNULL((SELECT TYPO_DESCRIPTION FROM OH_TYPOLOGIES WHERE TYPO_CODE = FP_CURRENT_METHOD_CODE), IFNULL(FP_CURRENT_METHOD_CODE, "-")) AS DETAILS_2,
	   "" AS DETAILS_3,
	   "" AS DETAILS_4,
	   IFNULL(FP_NOTES, "") AS NOTE
	FROM 
		OH_FAMILYPLANNING
	WHERE FP_ACTIVE = 1 AND FP_PAT_ID = $P{patientID} AND (DATE(FP_REGISTRATION_DATE) BETWEEN $P{Date_from} AND $P{Date_to})

UNION

	SELECT "HIV" AS TYPE,
	   HVI_REG_DATE AS DATE, CAST(HVI_ID AS CHAR) AS IDS,
	   HVI_STATUS AS DETAILS_1,
	   CONCAT("Feeding: ", IFNULL(HVI_FEEDING_TYPE, "-"), " - Weight: ", IFNULL(HVI_BIRTH_WEIGHT, "-")) AS DETAILS_2,
	   CONCAT("Follow-up: ", DATE_FORMAT(HVI_FOLLOWUP_START, '%d/%m/%Y'), IF(HVI_FOLLOWUP_END IS NOT NULL, CONCAT(" to ", DATE_FORMAT(HVI_FOLLOWUP_END, '%d/%m/%Y')), "")) AS DETAILS_3,
	   "" AS DETAILS_4,
	   IFNULL(HVI_NOTES, "") AS NOTE
	FROM 
		OH_HIV_INFANT
	WHERE HVI_ACTIVE = 1 AND HVI_PAT_ID = $P{patientID} AND (DATE(HVI_REG_DATE) BETWEEN $P{Date_from} AND $P{Date_to})
    
) 
AS DETAILS

WHERE TYPE LIKE IF ($P!{Opd},'%Opd%','') 
   OR TYPE LIKE IF ($P!{Admission},'%ADM%','') 
   OR TYPE LIKE IF ($P!{Drugs},'%Drugs%','') 
   OR TYPE LIKE IF ($P!{Examination},'%Examination%','') 
   OR TYPE LIKE IF ($P!{Laboratory},'%Laboratory%','') 
   OR TYPE LIKE IF ($P!{Operations},'%Operations%','') 
   OR TYPE LIKE IF ($P!{Vaccines},'%Vaccines%','') 
   OR TYPE LIKE IF ($P!{HomeVisit},'%HomeVisit%','') 
   OR TYPE LIKE IF ($P!{Tuberculosis},'%Tuberculosis%','') 
   OR TYPE LIKE IF ($P!{Maternity},'%Maternity%','') 
   OR TYPE LIKE IF ($P!{FamilyPlanning},'%FamilyPlanning%','') 
   OR TYPE LIKE IF ($P!{HIV},'%HIV%','') 
   OR TYPE LIKE IF ($P!{All}, '%%','')
ORDER BY DATE DESC]]>
	</queryString>
