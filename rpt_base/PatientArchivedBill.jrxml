	<queryString>
		<![CDATA[SELECT BLL_ID, BLL_ID_PAT, BLL_PAT_NAME, BLL_UPDATE, BLL_USR_ID_A, BLI_ID_PRICE, BLI_ITEM_DESC, BLI_ITEM_AMOUNT, BLI_QTY, BLP_USR_ID_A, BLL_STATUS
FROM oh_archived_bills B
JOIN oh_archived_billitems I ON B.BLL_ID = I.BLI_ID_BILL
LEFT JOIN (SELECT BLP_ID_BILL, BLP_USR_ID_A FROM oh_archived_billpayments WHERE BLP_ID_BILL = $P{billID} ORDER BY BLP_DATE DESC LIMIT 1) AS P ON B.BLL_ID = P.BLP_ID_BILL
WHERE BLL_ID = $P{billID}]]>
	</queryString>
