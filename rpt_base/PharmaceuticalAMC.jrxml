	<style name="CritivalValue" forecolor="#FF0000">
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean (
$F{MDSR_MIN_STOCK_QTI}.doubleValue() / $V{AVG}.doubleValue() >= 1.5
)]]></conditionExpression>
