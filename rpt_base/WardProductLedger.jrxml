	<parameter name="num_fiche" class="java.lang.String" isForPrompting="false"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="productID" class="java.lang.String"/>
	<parameter name="Currency" class="java.lang.String"/>
	<parameter name="WardCode" class="java.lang.String"/>
	<parameter name="WardName" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT t.*,
       h.HOS_NAME AS HOS_NAME,
       h.HOS_ADDR AS HOS_ADDRESS,
       h.HOS_CITY AS HOS_CITY,
       h.HOS_TELE AS HOS_TELEPHONE,
       h.HOS_EMAIL AS HOS_EMAIL
FROM (
    -- Opening Stock
    SELECT 
        '1' AS ORDERING_FIELD,
        NULL AS MMVN_ID,
        DATE($P{fromdate}) AS MMVN_DATE,
        (SELECT MDSR_CODE FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_CODE,
        (SELECT MDSR_DESC FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_DESC,
        (SELECT MDSRT_DESC FROM OH_MEDICALDSR JOIN OH_MEDICALDSRTYPE ON MDSR_MDSRT_ID_A = MDSRT_ID_A WHERE MDSR_ID = $P{productID}) AS MDSRT_DESC,
        NULL AS ORIGIN_DESTINATION,
        NULL AS MMVN_LT_ID,
        NULL AS LT_DUE_DATE,
        NULL AS LT_COST,
        NULL AS WRD_NAME,
        NULL AS REFERENCE,
        NULL AS QTY_INPUT,
        NULL AS QTY_OUTPUT,
        NULL AS MOVT_TYPE,
        NULL AS VALUE,
        NULL AS START_VALUE,
        (SELECT COALESCE(SUM(MMV_QTY), 0)
         FROM OH_MEDICALDSRSTOCKMOV
         WHERE MMV_MDSR_ID = $P{productID}
           AND MMV_WRD_ID_A = $P{WardCode}
           AND DATE(MMV_DATE) < DATE($P{fromdate})) 
        + (SELECT COALESCE(SUM(MMVN_MDSR_QTY), 0)
         FROM OH_MEDICALDSRSTOCKMOVWARD
         WHERE MMVN_MDSR_ID = $P{productID}
           AND MMVN_WRD_ID_A = $P{WardCode}
           AND DATE(MMVN_DATE) < DATE($P{fromdate})) AS MMVN_MDSR_QTY

    UNION ALL

    -- Transactions from Ward
    SELECT 
        '2' AS ORDERING_FIELD,
        MMVN_ID,
        MMVN_DATE,
        MDSR_CODE,
        MDSR_DESC,
        MDSRT_DESC,
        MMVN_DESC AS ORIGIN_DESTINATION,
        MMVN_LT_ID,
        NULL AS LT_DUE_DATE,
        NULL AS LT_COST,
        (SELECT WRD_NAME FROM OH_WARD WHERE WRD_ID_A = MMVN_WRD_ID_A) AS WRD_NAME,
        REFERENCE,
        QTY_INPUT,
        QTY_OUTPUT,
        MOVT_TYPE,
        VALUE,
        NULL AS START_VALUE,
        NULL AS MMVN_MDSR_QTY
    FROM (
        SELECT 
            MMVN_ID,
            MMVN_DATE,
            MDSR_CODE,
            MDSR_DESC,
            MDSRT_DESC,
            MMVN_DESC,
            MMVN_LT_ID,
            MMVN_WRD_ID_A,
            MMVN_MDSR_QTY,
            CASE
                WHEN MMVN_IS_PATIENT = 1 AND MMVN_MDSR_QTY < 0 THEN 'Return by Patient'
                WHEN MMVN_IS_PATIENT = 1 AND MMVN_MDSR_QTY > 0 THEN 'Discharge to Patient'
                WHEN MMVN_WRD_ID_A_FROM IS NOT NULL THEN CONCAT('Transfer from Ward: ', (SELECT WRD_NAME FROM OH_WARD WHERE WRD_ID_A = MMVN_WRD_ID_A_FROM))
                WHEN MMVN_WRD_ID_A_TO IS NOT NULL THEN CONCAT('Transfer to Ward: ', (SELECT WRD_NAME FROM OH_WARD WHERE WRD_ID_A = MMVN_WRD_ID_A_TO))
                ELSE NULL
            END AS REFERENCE,
            CASE
                WHEN MMVN_WRD_ID_A_TO IS NOT NULL THEN MMVN_MDSR_QTY
                ELSE 0
            END AS QTY_INPUT,
            CASE
                WHEN MMVN_WRD_ID_A_FROM IS NOT NULL THEN MMVN_MDSR_QTY
                ELSE 0
            END AS QTY_OUTPUT,
            CASE
                WHEN MMVN_IS_PATIENT = 1 AND MMVN_MDSR_QTY > 0 THEN 'Patient'
                WHEN MMVN_WRD_ID_A_TO IS NOT NULL THEN 'Charge'
                WHEN MMVN_WRD_ID_A_FROM IS NOT NULL THEN 'Discharge'
                ELSE 'Rectify'
            END AS MOVT_TYPE,
            0 AS VALUE
        FROM OH_MEDICALDSRSTOCKMOVWARD
        JOIN OH_MEDICALDSR ON MDSR_ID = MMVN_MDSR_ID
        JOIN OH_MEDICALDSRTYPE ON MDSR_MDSRT_ID_A = MDSRT_ID_A
        WHERE DATE(MMVN_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
          AND MMVN_WRD_ID_A = $P{WardCode}
          AND MMVN_MDSR_ID = $P{productID}
    ) AS WARD_MOVEMENTS

    UNION ALL

    -- Transactions from Main Store
    SELECT 
        '2' AS ORDERING_FIELD,
        MMV_ID AS MMVN_ID,
        MMV_DATE AS MMVN_DATE,
        MDSR_CODE,
        MDSR_DESC,
        MDSRT_DESC,
        CONCAT('From MAINSTORE: ', MMVT_DESC) AS ORIGIN_DESTINATION,
        MMV_LT_ID_A AS MMVN_LT_ID,
        LT_DUE_DATE,
        LT_COST,
        (SELECT WRD_NAME FROM OH_WARD WHERE WRD_ID_A = MMV_WRD_ID_A) AS WRD_NAME,
        NULL AS REFERENCE,
        MMV_QTY AS QTY_INPUT,
        0 AS QTY_OUTPUT,
        'Charge' AS MOVT_TYPE,
        (LT_COST * MMV_QTY) AS VALUE,
        NULL AS START_VALUE,
        NULL AS MMVN_MDSR_QTY
    FROM OH_MEDICALDSRSTOCKMOV
    LEFT JOIN OH_MEDICALDSR ON MMV_MDSR_ID = MDSR_ID
    LEFT JOIN OH_MEDICALDSRTYPE ON MDSR_MDSRT_ID_A = MDSRT_ID_A
    LEFT JOIN OH_MEDICALDSRSTOCKMOVTYPE ON MMV_MMVT_ID_A = MMVT_ID_A
    LEFT JOIN OH_MEDICALDSRLOT ON MMV_LT_ID_A = LT_ID_A
    WHERE DATE(MMV_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
      AND MMV_WRD_ID_A = $P{WardCode}
      AND MMV_MDSR_ID = $P{productID}

    UNION ALL

    -- Closing Stock
    SELECT 
        '3' AS ORDERING_FIELD,
        NULL AS MMVN_ID,
        DATE($P{todate}) AS MMVN_DATE,
        (SELECT MDSR_CODE FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_CODE,
        (SELECT MDSR_DESC FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_DESC,
        (SELECT MDSRT_DESC FROM OH_MEDICALDSR JOIN OH_MEDICALDSRTYPE ON MDSR_MDSRT_ID_A = MDSRT_ID_A WHERE MDSR_ID = $P{productID}) AS MDSRT_DESC,
        NULL AS ORIGIN_DESTINATION,
        NULL AS MMVN_LT_ID,
        NULL AS LT_DUE_DATE,
        NULL AS LT_COST,
        NULL AS WRD_NAME,
        NULL AS REFERENCE,
        NULL AS QTY_INPUT,
        NULL AS QTY_OUTPUT,
        NULL AS MOVT_TYPE,
        NULL AS VALUE,
        NULL AS START_VALUE,
        (SELECT COALESCE(SUM(MMV_QTY), 0)
         FROM OH_MEDICALDSRSTOCKMOV
         WHERE MMV_MDSR_ID = $P{productID}
           AND MMV_WRD_ID_A = $P{WardCode}
           AND DATE(MMV_DATE) <= DATE($P{todate})) 
        + (SELECT COALESCE(SUM(MMVN_MDSR_QTY), 0)
         FROM OH_MEDICALDSRSTOCKMOVWARD
         WHERE MMVN_MDSR_ID = $P{productID}
           AND MMVN_WRD_ID_A = $P{WardCode}
           AND DATE(MMVN_DATE) <= DATE($P{todate})) AS MMVN_MDSR_QTY
) t
CROSS JOIN OH_HOSPITAL h
ORDER BY ORDERING_FIELD, MMVN_DATE]]>
	</queryString>
