<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ProductLedger" pageWidth="872" pageHeight="610" columnWidth="812" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" resourceBundle="WardProductLedger" whenResourceMissingType="Key" uuid="de31a0bf-4eb3-43f4-8b32-8ee425584a64">
