	<queryString>
		<![CDATA[SELECT	ITP_ITEM_DESC, SUM(ITP_AMOUNT) AS ITP_AMOUNT, ITP_ITEM_GROUP,
(
	SELECT SUM(ABS(ITP2.ITP_AMOUNT)) FROM OH_ITEMPAYMENTS ITP2
	WHERE (ITP2.ITP_BLL_ID = ITP.ITP_BLL_ID AND ITP2.ITP_ITEM_DESC = ITP.ITP_ITEM_DESC)
	AND DATE(ITP2.ITP_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate}) AND ITP2.IS_REFUND = 1
) AS ITP_REFUNDED_AMOUNT,
CASE 
	WHEN ITP.ITP_ITEM_GROUP = "MED" 
	THEN (SELECT MEDT.MDSRT_DESC FROM OH_MEDICALDSR MED JOIN OH_MEDICALDSRTYPE MEDT ON MEDT.MDSRT_ID_A = MED.MDSR_MDSRT_ID_A WHERE MED.MDSR_ID = ITP.ITP_ITEM_ID)
	WHEN ITP.ITP_ITEM_GROUP = "EXA" 
	THEN (SELECT EXAT.EXC_DESC FROM OH_EXAM EXA JOIN OH_EXAMTYPE EXAT ON EXAT.EXC_ID_A = EXA.EXA_EXC_ID_A WHERE EXA.EXA_ID_A = ITP.ITP_ITEM_ID)
	WHEN ITP.ITP_ITEM_GROUP = "OPE" 
	THEN (SELECT OPET.OCL_DESC FROM OH_OPERATION OPE JOIN OH_OPERATIONTYPE OPET ON OPET.OCL_ID_A = OPE.OPE_OCL_ID_A WHERE OPE.OPE_ID_A = ITP.ITP_ITEM_ID)
	ELSE "AUTRES"
END AS BLI_ITEM_TYPE
FROM OH_ITEMPAYMENTS ITP
WHERE DATE(ITP.ITP_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate}) AND IS_REFUND = 0
GROUP BY ITP_ITEM_DESC
ORDER BY ITP.ITP_ITEM_GROUP, BLI_ITEM_TYPE, ITP.ITP_ITEM_DESC asc]]>
	</queryString>
