<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HomeVisitStats" pageWidth="535" pageHeight="200" whenNoDataType="AllSectionsNoDetail" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" resourceBundle="HomeVisitStats" whenResourceMissingType="Key" uuid="c1000001-0001-0001-0001-000000000001">
	<property name="ireport.encoding" value="UTF-8"/>
	<parameter name="PeriodStart" class="java.sql.Timestamp"/>
	<parameter name="PeriodEnd" class="java.sql.Timestamp"/>
	<queryString>
		<![CDATA[SELECT
		COALESCE(COUNT(*), 0) AS TOTAL_VISITS,
		COALESCE(SUM(CASE WHEN HV_STATUS = 'PLANNED'   THEN 1 ELSE 0 END), 0) AS PLANNED_COUNT,
		COALESCE(SUM(CASE WHEN HV_STATUS = 'COMPLETED' THEN 1 ELSE 0 END), 0) AS COMPLETED_COUNT,
		COALESCE(SUM(CASE WHEN HV_STATUS = 'CANCELLED' THEN 1 ELSE 0 END), 0) AS CANCELLED_COUNT,
		COALESCE(SUM(CASE WHEN HV_STATUS = 'POSTPONED' THEN 1 ELSE 0 END), 0) AS POSTPONED_COUNT,
		COALESCE(COUNT(DISTINCT HV_PAT_ID), 0) AS PATIENT_COUNT
	FROM OH_HOME_VISIT
	WHERE HV_DELETE = 1
		AND HV_VISIT_START_DATE >= $P{PeriodStart}
		AND HV_VISIT_START_DATE <  $P{PeriodEnd}]]>
	</queryString>
	<field name="TOTAL_VISITS" class="java.lang.Long"/>
	<field name="PLANNED_COUNT" class="java.lang.Long"/>
	<field name="COMPLETED_COUNT" class="java.lang.Long"/>
	<field name="CANCELLED_COUNT" class="java.lang.Long"/>
