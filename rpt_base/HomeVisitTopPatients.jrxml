<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HomeVisitTopPatients" pageWidth="535" pageHeight="400" whenNoDataType="NoDataSection" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" resourceBundle="HomeVisitTopPatients" whenResourceMissingType="Key" uuid="c3000001-0003-0003-0003-000000000001">
	<property name="ireport.encoding" value="UTF-8"/>
	<parameter name="PeriodStart" class="java.util.Date"/>
	<parameter name="PeriodEnd" class="java.util.Date"/>
	<parameter name="TopN" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[500]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH visit_purpose_freq AS (
	SELECT
		HV.HV_PAT_ID,
		HV.HV_PURPOSE,
		COUNT(*) AS PURPOSE_FREQ
	FROM OH_HOME_VISIT HV
	WHERE HV.HV_DELETE = 1
		AND HV.HV_VISIT_START_DATE >= $P{PeriodStart}
		AND HV.HV_VISIT_START_DATE <  $P{PeriodEnd}
	GROUP BY HV.HV_PAT_ID, HV.HV_PURPOSE
),
purpose_ranked AS (
	SELECT
		HV_PAT_ID,
		HV_PURPOSE,
		ROW_NUMBER() OVER (PARTITION BY HV_PAT_ID ORDER BY PURPOSE_FREQ DESC, HV_PURPOSE) AS RN
	FROM visit_purpose_freq
),
patient_status_counts AS (
	SELECT
		HV.HV_PAT_ID,
		P.PAT_NAME,
		COUNT(*) AS TOTAL_COUNT,
		SUM(CASE WHEN HV.HV_STATUS = 'PLANNED'   THEN 1 ELSE 0 END) AS PLANNED_COUNT,
		SUM(CASE WHEN HV.HV_STATUS = 'COMPLETED' THEN 1 ELSE 0 END) AS COMPLETED_COUNT,
		SUM(CASE WHEN HV.HV_STATUS = 'CANCELLED' THEN 1 ELSE 0 END) AS CANCELLED_COUNT,
		SUM(CASE WHEN HV.HV_STATUS = 'POSTPONED' THEN 1 ELSE 0 END) AS POSTPONED_COUNT,
		COALESCE(SUM(TIMESTAMPDIFF(MINUTE, HV.HV_VISIT_START_DATE, HV.HV_VISIT_END_DATE)), 0) AS TOTAL_MINUTES
	FROM OH_HOME_VISIT HV
	JOIN OH_PATIENT P ON HV.HV_PAT_ID = P.PAT_ID
	WHERE HV.HV_DELETE = 1
		AND HV.HV_VISIT_START_DATE >= $P{PeriodStart}
		AND HV.HV_VISIT_START_DATE <  $P{PeriodEnd}
	GROUP BY HV.HV_PAT_ID, P.PAT_NAME
)
SELECT
	C.PAT_NAME,
	C.TOTAL_COUNT,
	C.PLANNED_COUNT,
	C.COMPLETED_COUNT,
	C.CANCELLED_COUNT,
	C.POSTPONED_COUNT,
	C.TOTAL_MINUTES,
	R.HV_PURPOSE AS PURPOSE
FROM patient_status_counts C
JOIN purpose_ranked R ON R.HV_PAT_ID = C.HV_PAT_ID AND R.RN = 1
ORDER BY C.TOTAL_COUNT DESC
LIMIT $P{TopN}]]>
	</queryString>
	<field name="PAT_NAME" class="java.lang.String"/>
	<field name="TOTAL_COUNT" class="java.lang.Long"/>
	<field name="PLANNED_COUNT" class="java.lang.Long"/>
	<field name="COMPLETED_COUNT" class="java.lang.Long"/>
	<field name="CANCELLED_COUNT" class="java.lang.Long"/>
	<field name="POSTPONED_COUNT" class="java.lang.Long"/>
	<field name="TOTAL_MINUTES" class="java.lang.Long"/>
	<field name="PURPOSE" class="java.lang.String"/>
