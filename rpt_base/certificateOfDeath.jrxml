					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{HEADER_BUNDLE}.getString("header.address") + " " + ($P{Address} != null ? $P{Address} : "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="header_structure" x="279" y="80" width="256" height="14" uuid="f505130a-0140-4adf-b1a9-08aa155e7042"/>
				<textElement textAlignment="Right">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{HEADER_BUNDLE}.getString("header.structure") + " " + ($P{Hospital} != null ? $P{Hospital} : "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="header_telephone" x="279" y="94" width="256" height="14" uuid="62046284-ff6d-4db7-b1fd-38c317ba1938"/>
				<textElement textAlignment="Right">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{HEADER_BUNDLE}.getString("header.telephone") + " " + ($P{Telephone} != null ? $P{Telephone} : "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="header_email" x="279" y="108" width="256" height="14" uuid="1bd97b65-6dd2-4be4-8666-e9bbf04428f2"/>
				<textElement textAlignment="Right">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{HEADER_BUNDLE}.getString("header.email") + " " + ($P{Email} != null ? $P{Email} : "")]]></textFieldExpression>
			</textField>
			<line>
				<reportElement key="header_line" x="0" y="126" width="535" height="1" uuid="3af92a46-97b9-4641-8ad5-c8e975eb402c"/>
				<graphicElement>
					<pen lineWidth="1.0"/>
				</graphicElement>
			</line>
		</band>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="238" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="5" width="535" height="18"/>
				<textElement><font size="10" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$R{label_number} + " " + java.util.Objects.toString($F{id}, "") + $R{certificate_suffix}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="28" width="535" height="18"/>
				<textElement><font size="10"/></textElement>
				<textFieldExpression><![CDATA[$R{certifier_line} + " " + ".".repeat(150)]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="0" y="51" width="535" height="36"/>
				<textElement markup="styled" verticalAlignment="Top"><font size="9"/></textElement>
				<textFieldExpression><![CDATA[$R{patient_certify} + " <style isBold=\"true\">" + ($F{patient} != null ? $F{patient}.getSex() == 'F' ? $R{female_prefix} : $R{male_prefix} : "") + " " + ($V{patientFullName}.isEmpty() ? "&#160;&#160;&#160;" : net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{patientFullName})) + "</style> " + $R{born_on} + " <style isBold=\"true\">" + ($V{patientBirthDate}.isEmpty() ? "&#160;&#160;&#160;" : net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{patientBirthDate})) + "</style> " + $R{born_at} + " <style isBold=\"true\">" + ($V{patientBirthPlace}.isEmpty() ? "&#160;&#160;&#160;" : net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{patientBirthPlace})) + "</style>, " + $R{died_on} + " <style isBold=\"true\">" + ($V{deathDate}.isEmpty() ? "&#160;&#160;&#160;" : net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{deathDate})) + "</style> " + $R{died_at} + " <style isBold=\"true\">" + ($V{deathPlace}.isEmpty() ? "&#160;&#160;&#160;" : net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{deathPlace})) + "</style>"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="83" width="535" height="1"/>
				<graphicElement><pen lineWidth="0.5" lineStyle="Dotted"/></graphicElement>
			</line>
			<line>
				<reportElement x="0" y="106" width="535" height="1"/>
				<graphicElement><pen lineWidth="0.5" lineStyle="Dotted"/></graphicElement>
			</line>
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="120" width="535" height="30"/>
				<textElement verticalAlignment="Top"><font size="9"/></textElement>
				<textFieldExpression><![CDATA[$R{closing_sentence}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="320" y="176" width="215" height="18"/>
				<textElement textAlignment="Left"><font size="10"/></textElement>
				<textFieldExpression><![CDATA[$R{issued_at} + " " + ($P{City} != null ? $P{City} : "") + ", " + $R{on_date} + " " + java.util.Objects.toString($P{CertificateDate}, "")]]></textFieldExpression>
			</textField>
