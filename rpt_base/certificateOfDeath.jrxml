					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{HEADER_BUNDLE}.getString("header.country.en")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="header_motto_en" x="304" y="16" width="231" height="14" uuid="9ca17306-e4f4-4c85-879a-9081be690d17"/>
				<textElement textAlignment="Right">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{HEADER_BUNDLE}.getString("header.motto.en")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="header_ministry_en" x="304" y="30" width="231" height="16" uuid="f0574b8b-9880-450f-a6c7-0eb0dd48bc82"/>
				<textElement textAlignment="Right">
					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{HEADER_BUNDLE}.getString("header.ministry.en")]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
				<reportElement key="header_logo" x="237" y="0" width="60" height="46" uuid="b7ab18b5-f7ab-42be-a073-8bf3d58e0ae8">
					<printWhenExpression><![CDATA[$P{HOSPITAL_LOGO} != null && new java.io.File($P{HOSPITAL_LOGO}).isFile()]]></printWhenExpression>
				</reportElement>
				<imageExpression><![CDATA[$P{HOSPITAL_LOGO}]]></imageExpression>
			</image>
			<textField>
				<reportElement x="0" y="52" width="535" height="24" mode="Transparent"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{cert_title}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="header_district" x="0" y="80" width="256" height="14" uuid="03bdef63-decb-48b5-86bd-a7bfb4b4a7df"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{HEADER_BUNDLE}.getString("header.district") + " " + ($P{City} != null ? $P{City} : "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="header_address" x="0" y="94" width="256" height="14" uuid="e7501ea2-7254-4be3-b114-3a212f95da1f"/>
