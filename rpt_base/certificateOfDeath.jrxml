				<textElement>
					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{HEADER_BUNDLE}.getString("header.country.fr")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="header_motto_fr" x="15" y="16" width="216" height="14" uuid="09a6e33f-9c39-4bb3-9d0c-018415131f21"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{HEADER_BUNDLE}.getString("header.motto.fr")]]></textFieldExpression>
			</textField>
