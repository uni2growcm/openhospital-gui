<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
	name="certificateOfDeath" pageWidth="595" pageHeight="842" whenNoDataType="NoPages"
	columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20"
	resourceBundle="certificateOfDeath" whenResourceMissingType="Key">
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="java.time.format.DateTimeFormatter"/>
	<parameter name="Hospital" class="java.lang.String"/>
	<parameter name="Address" class="java.lang.String"/>
	<parameter name="City" class="java.lang.String"/>
	<parameter name="Email" class="java.lang.String"/>
	<parameter name="Telephone" class="java.lang.String"/>
	<parameter name="CertificateDate" class="java.lang.String"/>
	<field name="id" class="java.lang.Integer"/>
	<field name="date" class="java.time.LocalDateTime"/>
	<field name="place" class="java.lang.String"/>
	<field name="patient" class="org.isf.patient.model.Patient"/>
	<field name="deathReason" class="org.isf.mortuary.model.DeathReason"/>
	<field name="declaringName" class="java.lang.String"/>
	<variable name="patientFullName" class="java.lang.String">
		<variableExpression><![CDATA[$F{patient} != null ? (($F{patient}.getFirstName() != null ? $F{patient}.getFirstName() : "") + ($F{patient}.getSecondName() != null ? " " + $F{patient}.getSecondName() : "")).trim() : ""]]></variableExpression>
	</variable>
	<variable name="patientBirthDate" class="java.lang.String">
		<variableExpression><![CDATA[$F{patient} != null && $F{patient}.getBirthDate() != null ? $F{patient}.getBirthDate().format(DateTimeFormatter.ofPattern("dd/MM/yyyy")) : ""]]></variableExpression>
	</variable>
	<variable name="patientBirthPlace" class="java.lang.String">
		<variableExpression><![CDATA[$F{patient} != null && $F{patient}.getBirthPlace() != null ? $F{patient}.getBirthPlace().trim() : ""]]></variableExpression>
	</variable>
	<variable name="deathDate" class="java.lang.String">
		<variableExpression><![CDATA[$F{date} != null ? $F{date}.format(DateTimeFormatter.ofPattern("dd/MM/yyyy")) : ""]]></variableExpression>
	</variable>
	<variable name="deathPlace" class="java.lang.String">
		<variableExpression><![CDATA[$F{place} != null ? $F{place}.trim() : ""]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band height="139" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="300" height="15"/>
				<textElement textAlignment="Left">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{republique_camerounf}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="30" y="14" width="300" height="11"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{paix_travail_patrief}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="30" width="300" height="20"/>
				<textElement textAlignment="Left">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{ministere_santef}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="355" y="0" width="180" height="15"/>
				<textElement textAlignment="Right">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{republique_cameroune}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="355" y="17" width="180" height="11"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{paix_travail_patriee}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="355" y="30" width="180" height="20"/>
				<textElement textAlignment="Right">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{ministere_santee}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="10" y="42" width="515" height="24"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{cert_title}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="88" width="300" height="14"/>
				<textElement><font fontName="SansSerif" size="10"/></textElement>
				<textFieldExpression><![CDATA[$R{label_district} + " " + ($P{City} != null ? $P{City} : "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="300" y="90" width="235" height="14"/>
				<textElement textAlignment="Right"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$R{label_structure} + " " + ($P{Hospital} != null ? $P{Hospital} : "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="104" width="300" height="14"/>
				<textElement><font fontName="SansSerif" size="10"/></textElement>
				<textFieldExpression><![CDATA[$R{label_adresse} + " " + ($P{Address} != null ? $P{Address} : "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="300" y="104" width="235" height="14"/>
				<textElement textAlignment="Right"><font fontName="SansSerif" size="10"/></textElement>
				<textFieldExpression><![CDATA[$R{label_telephone} + " " + ($P{Telephone} != null ? $P{Telephone} : "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="300" y="120" width="235" height="14"/>
				<textElement textAlignment="Right"><font fontName="SansSerif" size="10"/></textElement>
				<textFieldExpression><![CDATA[$R{label_email} + " " + ($P{Email} != null ? $P{Email} : "")]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="136" width="535" height="1"/>
				<graphicElement><pen lineWidth="1.5"/></graphicElement>
			</line>
		</band>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="280" splitType="Stretch">
			<textField>
				<reportElement x="0" y="5" width="535" height="18"/>
				<textElement><font size="10" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$R{label_number} + " " + $F{id} + $R{certificate_suffix}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="31" width="535" height="18"/>
				<textElement><font size="10"/></textElement>
				<textFieldExpression><![CDATA[$R{certifier_line} + " " + ".".repeat(150)]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="56" width="535" height="36"/>
				<textElement markup="styled" verticalAlignment="Top"><font size="9"/></textElement>
				<textFieldExpression><![CDATA[$R{patient_certify} + " <style isBold=\"true\">" + ($F{patient} != null ? $F{patient}.getSex() == 'F' ? $R{female_prefix} : $R{male_prefix} : "") + " " + ($V{patientFullName}.isEmpty() ? "&#160;&#160;&#160;" : net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{patientFullName})) + "</style> " + $R{born_on} + " <style isBold=\"true\">" + ($V{patientBirthDate}.isEmpty() ? "&#160;&#160;&#160;" : net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{patientBirthDate})) + "</style> " + $R{born_at} + " <style isBold=\"true\">" + ($V{patientBirthPlace}.isEmpty() ? "&#160;&#160;&#160;" : net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{patientBirthPlace})) + "</style>, " + $R{died_on} + " <style isBold=\"true\">" + ($V{deathDate}.isEmpty() ? "&#160;&#160;&#160;" : net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{deathDate})) + "</style> " + $R{died_at} + " <style isBold=\"true\">" + ($V{deathPlace}.isEmpty() ? "&#160;&#160;&#160;" : net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($V{deathPlace})) + "</style>"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="108" width="535" height="1"/>
				<graphicElement><pen lineWidth="0.5" lineStyle="Dotted"/></graphicElement>
			</line>
			<line>
				<reportElement x="0" y="131" width="535" height="1"/>
				<graphicElement><pen lineWidth="0.5" lineStyle="Dotted"/></graphicElement>
			</line>
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="160" width="535" height="30"/>
				<textElement verticalAlignment="Top"><font size="9"/></textElement>
				<textFieldExpression><![CDATA[$R{closing_sentence}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="320" y="218" width="215" height="18"/>
				<textElement textAlignment="Left"><font size="10"/></textElement>
				<textFieldExpression><![CDATA[$R{issued_at} + " " + ($P{City} != null ? $P{City} : "") + ", " + $R{on_date} + " " + $P{CertificateDate}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="320" y="252" width="215" height="18"/>
				<textElement textAlignment="Left"><font size="10"/></textElement>
				<textFieldExpression><![CDATA[$R{chief_physician}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
</jasperReport>
