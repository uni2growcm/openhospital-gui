	<queryString>
		<![CDATA[SELECT 
    SUM(MMV.MMV_QTY) AS ITEM_QTY,
    SUM(LT.LT_COST) AS ITEM_COST,
    WRD.WRD_NAME AS MMV_WRD_NAME,
    SUM(MMV.MMV_QTY * LT.LT_COST) AS ITEM_AMOUNT,
    AF.AFM_DESC AS MMV_FA_DESC
FROM 
    OH_MEDICALDSRSTOCKMOV MMV
    JOIN OH_MEDICALDSRLOT LT ON MMV.MMV_LT_ID_A = LT.LT_ID_A
    JOIN OH_WARD WRD ON MMV.MMV_WRD_ID_A = WRD.WRD_ID_A
    LEFT JOIN OH_MEDICALDSR MDSR ON MMV.MMV_MDSR_ID = MDSR.MDSR_ID
    LEFT JOIN OH_ARTICLE_FAMILIES AF ON MDSR.MDSR_AFM_ID = AF.AFM_ID
WHERE 
    MMV.MMV_MMVT_ID_A = 'discharge' 
    AND DATE(MMV.MMV_DATE) BETWEEN STR_TO_DATE($P{fromdate}, '%Y-%m-%d') AND STR_TO_DATE($P{todate}, '%Y-%m-%d')
GROUP BY 
    AF.AFM_DESC, 
    WRD.WRD_NAME
ORDER BY 
    WRD.WRD_NAME ASC;]]>
	</queryString>
