	<parameter name="idPatient" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="opdDate" class="java.lang.String" isForPrompting="false"/>
	<parameter name="idOpd" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[select  GROUP_CONCAT(MDSR_DESC) 
from    oh_medicaldsr
where   MDSR_ID IN (
		      select THR_MDSR_ID
		      from oh_therapies
                      where  THR_PAT_ID = $P{idPatient} 
                             and DATE_FORMAT(THR_CREATED_DATE, '%d/%m/%Y') = $P{opdDate}
		     )]]>
	</queryString>
	<field name="GROUP_CONCAT(MDSR_DESC)" class="java.lang.String"/>
