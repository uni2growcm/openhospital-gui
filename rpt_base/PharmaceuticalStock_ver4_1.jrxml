	<queryString>
		<![CDATA[SELECT * FROM (
    SELECT MDSR_ID, MDSRT_DESC, MDSR_CODE, MDSR_DESC, MDSR_MIN_STOCK_QTI, SUM(QTY_INPUT - QTY_OUTPUT) AS STOCK,
           COALESCE(SUM(CHARGE - DISCHARGE) / NULLIF(SUM(QTY_INPUT - QTY_OUTPUT), 0), 0.0) AS AVG_COST,
           COALESCE(SUM(CHARGE - DISCHARGE), 0.0) AS TOTAL
    FROM (
        SELECT MDSR_ID, MDSRT_DESC, MDSR_CODE, MDSR_DESC, MDSR_MIN_STOCK_QTI, LT_ID_A, LT_COST, SUM(INPUT) AS QTY_INPUT, SUM(OUTPUT) AS QTY_OUTPUT, COALESCE(LT_COST, 0.0) * SUM(INPUT) AS CHARGE, COALESCE(LT_COST, 0.0) * SUM(OUTPUT) AS DISCHARGE
        FROM (
            SELECT MDSR_ID, MDSRT_DESC, MDSR_CODE, MDSR_DESC, MDSR_MIN_STOCK_QTI, MMV_LT_ID_A, MMV_MMVT_ID_A, SUM(IF(MMVT_TYPE LIKE '%+%',MMV_QTY,0)) AS INPUT, SUM(IF(MMVT_TYPE LIKE '%-%', MMV_QTY, 0)) AS OUTPUT		
            FROM OH_MEDICALDSR
            LEFT JOIN OH_MEDICALDSRSTOCKMOV ON MDSR_ID = MMV_MDSR_ID
            LEFT JOIN OH_MEDICALDSRTYPE ON MDSRT_ID_A = MDSR_MDSRT_ID_A
            LEFT JOIN OH_MEDICALDSRSTOCKMOVTYPE ON MMV_MMVT_ID_A = MMVT_ID_A
            WHERE DATE(MMV_DATE) <= $P{todate}
            AND (MDSR_DESC LIKE $P{filter} OR MDSR_CODE LIKE $P{filter})
            GROUP BY MDSR_ID, MMV_LT_ID_A, MMV_MMVT_ID_A
        ) AS QUANTITY
        JOIN OH_MEDICALDSRLOT ON MMV_LT_ID_A = LT_ID_A
        GROUP BY LT_ID_A
    ) AS VALUE
    WHERE MDSRT_DESC LIKE $P{groupBy}
    GROUP BY MDSRT_DESC, MDSR_ID
    
    UNION ALL 
    
    SELECT MDSR_ID, MDSRT_DESC, MDSR_CODE, MDSR_DESC, MDSR_MIN_STOCK_QTI, 0 AS STOCK, 0.0 AS AVG_COST, 0 AS TOTAL	
    FROM OH_MEDICALDSR
    LEFT JOIN OH_MEDICALDSRTYPE ON MDSRT_ID_A = MDSR_MDSRT_ID_A
    LEFT JOIN OH_MEDICALDSRSTOCKMOV ON MDSR_ID = MMV_MDSR_ID
    WHERE MMV_MDSR_ID IS NULL
    AND MDSR_DESC LIKE $P{filter}
    AND MDSRT_DESC LIKE $P{groupBy}
) AS FINAL_RESULT
WHERE STOCK != 0
ORDER BY $P!{sortBy}]]>
	</queryString>
