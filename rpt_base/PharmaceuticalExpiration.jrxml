		<conditionalStyle>
			<conditionExpression><![CDATA[$F{LT_DUE_DATE} != null && $F{LT_DUE_DATE}.toLocalDateTime().toLocalDate().isBefore(java.time.LocalDate.now())]]></conditionExpression>
