	<parameter name="todate" class="java.util.Date"/>
	<parameter name="fromdateshort" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fromdate})]]></defaultValueExpression>
	</parameter>
	<parameter name="todateshort" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{todate})]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT BLL_ID, BLP_DATE, BLL_PAT_NAME, REFUNDED, BLP_USR_ID_A 
FROM ( 
	SELECT BLL_ID, BLP_DATE, BLL_PAT_NAME, 
	IF(DATE(BLP_DATE) BETWEEN $P{fromdate} AND $P{todate}, SUM(ABS(BLP_AMOUNT)), 0) REFUNDED, BLP_USR_ID_A 
	FROM ( 
		SELECT * 
		FROM OH_BILLS bl 
		INNER JOIN OH_BILLPAYMENTS 
		ON bl.BLL_ID = BLP_ID_BILL 
		WHERE bl.BLL_STATUS <> 'D' 
		AND bl.BLL_PARENT_ID IS NOT NULL 
		AND DATE(BLP_DATE) BETWEEN $P{fromdate} AND $P{todate}
	) OH_PAYMENTS 
	GROUP BY BLL_ID, BLP_DATE, BLL_PAT_NAME
	) OH_BILLS 
ORDER BY BLP_USR_ID_A, BLP_DATE]]>
	</queryString>
	<field name="BLL_ID" class="java.lang.Integer"/>
	<field name="BLP_DATE" class="java.sql.Timestamp"/>
	<field name="BLL_PAT_NAME" class="java.lang.String"/>
	<field name="REFUNDED" class="java.lang.Double"/>
	<field name="BLP_USR_ID_A" class="java.lang.String"/>
	<variable name="REFUNDED_USER" class="java.lang.Double" resetType="Group" resetGroup="User" calculation="Sum">
