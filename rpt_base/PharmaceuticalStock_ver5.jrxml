	<style name="UnderCriticalLevel">
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean( $V{MEDICAL_SUM}.floatValue() < $F{MDSR_MIN_STOCK_QTI}.floatValue() )]]></conditionExpression>
