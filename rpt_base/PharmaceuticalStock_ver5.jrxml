	<parameter name="Date" class="java.lang.String" isForPrompting="false"/>
	<parameter name="todate" class="java.lang.String"/>
	<parameter name="groupBy" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["%"]]></defaultValueExpression>
	</parameter>
	<parameter name="sortBy" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["MDSRT_DESC, MDSR_DESC, LT_ID_A"]]></defaultValueExpression>
	</parameter>
	<parameter name="filter" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["%"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT MDSR_ID, MDSRT_DESC, MDSR_CODE, MDSR_DESC, MDSR_MIN_STOCK_QTI, LT_ID_A, LT_DUE_DATE, STOCK,
       COALESCE(VALUE, 0.0) AS VALUE,
       COALESCE(VALUE / NULLIF(STOCK, 0), 0.0) AS AVG_COST
FROM (
	SELECT MDSR_ID, MDSRT_DESC, MDSR_CODE, MDSR_DESC, MDSR_MIN_STOCK_QTI, LT_ID_A, LT_DUE_DATE, SUM(QTY_INPUT - QTY_OUTPUT) AS STOCK, COALESCE(SUM(CHARGE - DISCHARGE), 0.0) AS VALUE
	FROM (
		SELECT MDSR_ID, MDSRT_DESC, MDSR_CODE, MDSR_DESC, MDSR_MIN_STOCK_QTI, LT_ID_A, LT_DUE_DATE, LT_COST, SUM(INPUT) AS QTY_INPUT, SUM(OUTPUT) AS QTY_OUTPUT, COALESCE(LT_COST, 0.0) * SUM(INPUT) AS CHARGE, COALESCE(LT_COST, 0.0) * SUM(OUTPUT) AS DISCHARGE
		FROM (
			SELECT MDSR_ID, MDSRT_DESC, MDSR_CODE, MDSR_DESC, MDSR_MIN_STOCK_QTI, MMV_LT_ID_A, MMV_MMVT_ID_A, SUM(IF(MMVT_TYPE LIKE '%+%',MMV_QTY,0)) AS INPUT, SUM(IF(MMVT_TYPE LIKE '%-%', MMV_QTY, 0)) AS OUTPUT		
			FROM OH_MEDICALDSR
			LEFT JOIN OH_MEDICALDSRSTOCKMOV ON MDSR_ID = MMV_MDSR_ID
			LEFT JOIN OH_MEDICALDSRTYPE ON MDSRT_ID_A = MDSR_MDSRT_ID_A
			LEFT JOIN OH_MEDICALDSRSTOCKMOVTYPE ON MMV_MMVT_ID_A = MMVT_ID_A
			WHERE DATE(MMV_DATE) <= $P{todate}
			AND (MDSR_DESC LIKE $P{filter} OR MDSR_CODE LIKE $P{filter})
			GROUP BY MDSR_ID, MMV_LT_ID_A, MMV_MMVT_ID_A) AS QUANTITY
		JOIN OH_MEDICALDSRLOT ON MMV_LT_ID_A = LT_ID_A
		GROUP BY LT_ID_A) AS VALUE
	WHERE MDSRT_DESC LIKE $P{groupBy}
	GROUP BY MDSRT_DESC, LT_ID_A, MDSR_ID) AS LOTS
WHERE STOCK > 0

UNION ALL 

SELECT MDSR_ID, MDSRT_DESC, MDSR_CODE, MDSR_DESC, MDSR_MIN_STOCK_QTI, NULL AS LT_ID_A, NULL AS LT_DUE_DATE, 0 AS STOCK, 0 AS VALUE, 0.0 AS AVG_COST	
FROM OH_MEDICALDSR
LEFT JOIN OH_MEDICALDSRTYPE ON MDSRT_ID_A = MDSR_MDSRT_ID_A
LEFT JOIN OH_MEDICALDSRSTOCKMOV ON MDSR_ID = MMV_MDSR_ID
WHERE MMV_MDSR_ID IS NULL
AND MDSR_DESC LIKE $P{filter}
AND MDSRT_DESC LIKE $P{groupBy}
            
ORDER BY $P!{sortBy}]]>
	</queryString>
