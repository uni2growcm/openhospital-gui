	<parameter name="Nbn_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT 
    PAT2.PAT_ID AS CHILD_ID,
    PAT2.PAT_SEX,
    PAT2.PAT_NAME AS CHILD_NAME,

    PDEL.PRGDLV_DATE,
    PDEL.PRGDLV_FATHER_BIRTHPLACE,
    PDEL.PRGDLV_FATHER_AGE,
    PDEL.PRGDLV_FATHER_ADDRESS,
    PDEL.PRGDLV_FATHER_PROFESSION,
    PDEL.PRGDLV_FATHER_NAME,

    PAT1.PAT_ID AS MOTHER_ID,
    PAT1.PAT_NAME AS MOTH_NAME,
    PAT1.PAT_BIRTH_PLACE,

    IF(
        PAT1.PAT_BDATE IS NOT NULL,
        ROUND(DATEDIFF(CURDATE(), DATE(PAT1.PAT_BDATE)) / 365, 0),
        PAT1.PAT_AGE
    ) AS age,

    PAT1.PAT_CITY,
    PAT1.PAT_ADDR,
    PAT1.PAT_PROFESSION,
    PAT1.PAT_TELE

FROM OH_PREGNANCYDELIVERY PDEL

INNER JOIN OH_PREGNANCY OP
    ON PDEL.PRGDLV_PRG_ID = OP.PRG_ID

INNER JOIN OH_PATIENT PAT1
    ON OP.PRG_PAT_ID = PAT1.PAT_ID

INNER JOIN OH_NEWBORN T
    ON T.NBN_DLV_ID = PDEL.PRGDLV_ID

INNER JOIN OH_PATIENT PAT2
    ON T.NBN_PAT_ID = PAT2.PAT_ID

WHERE T.NBN_ID = $P{Nbn_id};]]>
	</queryString>
