	<parameter name="Nbn_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT 
	PAT2.PAT_SEX,
	PAT2.PAT_NAME as CHILD_NAME,
	PDEL.PRGDLV_DATE,
	PDEL.PRGDLV_FATHER_BIRTHPLACE ,
	PDEL.PRGDLV_FATHER_AGE,
	PDEL.PRGDLV_FATHER_ADDRESS ,
	PDEL.PRGDLV_FATHER_PROFESSION ,
	PDEL.PRGDLV_FATHER_NAME,
	PAT1.PAT_NAME,
	PAT1.PAT_BIRTH_PLACE,
	IF(PAT1.PAT_BDATE is not null, ROUND(DATEDIFF(CURDATE(), DATE(PAT1.PAT_BDATE)) / 365,0),PAT1.PAT_AGE) as age,
	PAT1.PAT_CITY, 
    PAT1.PAT_ADDR,
    PAT1.PAT_PROFESSION,
    PAT1.PAT_TELE
FROM oh_pregnancydelivery PDEL
JOIN oh_pregnancy OP ON PDEL.PRGDLV_PRG_ID = OP.PRG_ID 
JOIN oh_patient PAT1 ON OP.PRG_PAT_ID = PAT1.PAT_ID 
JOIN oh_newborn t ON t.NBN_DLV_ID = PDEL.PRGDLV_ID 
JOIN oh_patient PAT2 ON t.NBN_PAT_ID = PAT2.PAT_ID 
WHERE t.NBN_ID = $P{Nbn_id}]]>
	</queryString>
