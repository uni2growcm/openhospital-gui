<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PatientBillBalance" pageWidth="535" pageHeight="100" whenNoDataType="AllSectionsNoDetail" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" resourceBundle="PatientBill" uuid="75918233-30dd-4eff-b56b-010c7540aa17">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="OH DB"/>
	<parameter name="billID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
            (SELECT COALESCE(SUM(BLI_ITEM_AMOUNT * BLI_QTY), 0)
             FROM OH_BILLITEMS WHERE BLI_ID_BILL = $P{billID})
            -
            (SELECT COALESCE(SUM(BLP_AMOUNT), 0)
             FROM OH_BILLPAYMENTS WHERE BLP_ID_BILL = $P{billID})
            AS BALANCE]]>
	</queryString>
	<field name="BALANCE" class="java.lang.Double"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="30" splitType="Stretch">
			<textField>
