	<field name="BLI_ITEM_GROUP" class="java.lang.String"/>
	<field name="BLI_SALES_AMOUNT" class="java.lang.Double"/>
	<field name="BLI_REFUNDED_AMOUNT" class="java.lang.Double"/>
	<field name="BLI_PAYEMENTS_AMOUNT" class="java.lang.Double"/>
	<field name="BLI_REFUNDED_PAYMENTS" class="java.lang.Double"/>
