	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="state" class="java.lang.String" isForPrompting="false"/>
	<parameter name="state2" class="java.lang.String" isForPrompting="false"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT BLI.BLI_ITEM_DESC, 
    BLI.BLI_ITEM_GROUP,
    SUM(
        BLI.BLI_QTY * (IF(IFNULL(BLI.BLI_ITEM_AMOUNT,0) > IFNULL(BLI.BLI_ITEM_AMOUNT_BRUT,0), IFNULL(BLI.BLI_ITEM_AMOUNT,0), IFNULL(BLI.BLI_ITEM_AMOUNT_BRUT,0)))
    ) AS BLI_SALES_AMOUNT,
    (
        SELECT SUM(BLI2.BLI_QTY * (IF(IFNULL(BLI2.BLI_ITEM_AMOUNT,0) > IFNULL(BLI2.BLI_ITEM_AMOUNT_BRUT,0), IFNULL(BLI_ITEM_AMOUNT,0), IFNULL(BLI_ITEM_AMOUNT_BRUT,0)))) 
        FROM OH_BILLITEMS BLI2 
        INNER JOIN OH_BILLS B1 ON (B1.BLL_ID = BLI2.BLI_ID_BILL AND B1.BLL_PARENT_ID IS NOT NULL)
        WHERE BLI2.BLI_ITEM_DESC = BLI.BLI_ITEM_DESC
        AND DATE(BLI2.BLI_DATE) BETWEEN $P{fromdate} AND $P{todate}
    ) AS BLI_REFUNDED_AMOUNT,
    (
        SELECT SUM(ITP1.ITP_AMOUNT) FROM OH_ITEMPAYMENTS ITP1
        WHERE DATE(ITP1.ITP_DATE) BETWEEN $P{fromdate} AND $P{todate}
        AND ITP1.ITP_ITEM_DESC = BLI.BLI_ITEM_DESC AND IS_REFUND = 0
    ) AS BLI_PAYEMENTS_AMOUNT,
    (
        SELECT SUM(ABS(ITP2.ITP_AMOUNT)) FROM OH_ITEMPAYMENTS ITP2
        WHERE DATE(ITP2.ITP_DATE) BETWEEN $P{fromdate} AND $P{todate}
        AND ITP2.ITP_ITEM_DESC = BLI.BLI_ITEM_DESC AND IS_REFUND = 1
    ) AS BLI_REFUNDED_PAYMENTS
FROM OH_BILLITEMS BLI
INNER JOIN OH_BILLS B ON (B.BLL_ID = BLI.BLI_ID_BILL AND B.BLL_PARENT_ID IS NULL) 
WHERE DATE(BLI.BLI_DATE) BETWEEN $P{fromdate} AND $P{todate}
GROUP BY BLI.BLI_ITEM_DESC
ORDER BY BLI.BLI_ITEM_GROUP, BLI.BLI_ITEM_DESC]]>
	</queryString>
