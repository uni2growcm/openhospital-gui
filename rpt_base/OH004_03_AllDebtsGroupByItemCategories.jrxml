		<variableExpression><![CDATA[$F{BLI_REFUNDED_AMOUNT} == null ? $F{BLI_SALES_AMOUNT} : new java.lang.Double(  ($F{BLI_SALES_AMOUNT}.doubleValue()) -($F{BLI_REFUNDED_AMOUNT}.doubleValue()) )]]></variableExpression>
