	<variable name="INC_VALUE" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{VALUE} == null ? new Double(0) : $F{VALUE}]]></variableExpression>
	</variable>
	<variable name="AVG_COST" class="java.lang.Double">
		<variableExpression><![CDATA[new Double ( $F{VALUE}.doubleValue() / $F{MMV_QTY}.doubleValue() )]]></variableExpression>
	</variable>
	<variable name="OUT_QTY" class="java.lang.Double">
		<variableExpression><![CDATA[$F{MMV_FROM} == null ?
$F{MMV_QTY} == null ? new Double(0) : $F{MMV_QTY} : new Double(0)]]></variableExpression>
	</variable>
	<variable name="IN_QTY" class="java.lang.Double">
		<variableExpression><![CDATA[$F{MMV_FROM} == null ?
new Double(0) :
	$F{MMV_QTY} == null ? new Double(0) : $F{MMV_QTY}]]></variableExpression>
	</variable>
	<variable name="BALANCE" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[new Double( $V{IN_QTY}.doubleValue() - $V{OUT_QTY}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="TOT_IN" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{ORDERING_FIELD}.equals("2") ?
$V{IN_QTY}.doubleValue() == 0 ? null : $V{IN_QTY} :
 	new Double(0)]]></variableExpression>
	</variable>
	<variable name="TOT_OUT" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{ORDERING_FIELD}.equals("2") ?
	$V{OUT_QTY}.doubleValue() == 0 ?
null : $V{OUT_QTY} :
	new Double(0)]]></variableExpression>
	</variable>
