	<parameter name="City" class="java.lang.String"/>
	<parameter name="Email" class="java.lang.String"/>
	<parameter name="Telephone" class="java.lang.String"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="fromdateshort" class="java.lang.String" isForPrompting="false"/>
	<parameter name="todateshort" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT US_ID_A, USR_PAYMENTS, USR_REFUNDS
FROM (
	SELECT US_ID_A,
	(SELECT SUM(IF(BLP_AMOUNT > 0, BLP_AMOUNT, 0)) FROM OH_BILLPAYMENTS BLP1 WHERE (DATE(BLP1.BLP_DATE) BETWEEN $P{fromdate} AND $P{todate}) AND BLP_USR_ID_A = US_ID_A) AS USR_PAYMENTS,
	(SELECT SUM(IF(BLP_AMOUNT < 0, ABS(BLP_AMOUNT), 0)) FROM OH_BILLPAYMENTS BLP2 WHERE (DATE(BLP2.BLP_DATE) BETWEEN $P{fromdate} AND $P{todate}) AND BLP_USR_ID_A = US_ID_A) AS USR_REFUNDS
	FROM OH_USER
) USERS 
WHERE (USR_PAYMENTS > 0 OR USR_REFUNDS > 0)]]>
	</queryString>
	<field name="US_ID_A" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="US_ID_A"/>
		<property name="com.jaspersoft.studio.field.label" value="US_ID_A"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="USERS"/>
	</field>
	<field name="USR_PAYMENTS" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.name" value="USR_PAYMENTS"/>
		<property name="com.jaspersoft.studio.field.label" value="USR_PAYMENTS"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="USERS"/>
	</field>
	<field name="USR_REFUNDS" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.name" value="USR_REFUNDS"/>
		<property name="com.jaspersoft.studio.field.label" value="USR_REFUNDS"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="USERS"/>
	</field>
	<variable name="PAID" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{USR_PAYMENTS} != null ? $F{USR_PAYMENTS} : new Double(0)]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="REFUNDS" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{USR_REFUNDS} != null ? $F{USR_REFUNDS} : new Double(0)]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="DEPOSIT" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[new java.lang.Double((($F{USR_PAYMENTS} != null ? $F{USR_PAYMENTS} : new Double(0)).doubleValue()) -(($F{USR_REFUNDS} != null ? $F{USR_REFUNDS} : new Double(0)).doubleValue()))]]></variableExpression>
	</variable>
