                        ? ""
                        : $F{visit_duration} < 60
                            ? $F{visit_duration} + " " + $R{minute_abbr}
                            : $F{visit_duration} % 60 == 0
                                ? ($F{visit_duration} / 60) + " " + $R{hour_abbr}
                                : ($F{visit_duration} / 60) + " " + $R{hour_abbr} + " "
                                    + ($F{visit_duration} % 60) + " " + $R{minute_abbr}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement x="650" y="0" width="182" height="18" uuid="aa6a04ca-ba48-493e-9bc4-6e1d65b59a3d"/>
				<box>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{patient_city} != null ? $F{patient_city} : ""]]></textFieldExpression>
			</textField>
		</band>
