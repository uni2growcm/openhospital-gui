<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="VisitReport" pageWidth="892" pageHeight="800" columnWidth="832" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" resourceBundle="VisitReport" whenResourceMissingType="Key" uuid="66b2c768-54a2-4700-b487-306031f7a6d2">
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="net.sf.jasperreports.export.page.count" value="true"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="allDoctors" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[Boolean.FALSE]]></defaultValueExpression>
	</parameter>
	<parameter name="doctorIds" class="java.util.Collection"/>
	<queryString>
		<![CDATA[SELECT
  v.VST_ID,
  v.VST_PAT_ID,
  p.PAT_ID AS patient_code,
  p.PAT_NAME AS patient_name,
  p.PAT_SNAME AS patient_second_name,
  p.PAT_AGE AS patient_age,
  p.PAT_SEX AS patient_sex,
  p.PAT_ADDR AS patient_address,
  p.PAT_CITY AS patient_city,
  p.PAT_TELE AS patient_telephone,
  v.VST_DATE AS visit_date,
  v.VST_DURATION AS visit_duration,
  v.VST_SERVICE AS visit_service,
  v.VST_NOTE AS visit_notes,
  v.VST_CREATED_BY AS doctor_id,
  COALESCE(NULLIF(u.US_DESC, ''), u.US_ID_A) AS doctor_name,
  w.WRD_NAME AS ward_name,
  h.HOS_NAME AS structure_name,
  h.HOS_CITY AS district_name,
  h.HOS_ADDR AS hos_address,
  h.HOS_TELE AS hos_telephone,
  h.HOS_EMAIL AS hos_email
FROM OH_VISITS v
INNER JOIN OH_PATIENT p ON p.PAT_ID = v.VST_PAT_ID
INNER JOIN OH_USER u ON u.US_ID_A = v.VST_CREATED_BY
LEFT JOIN OH_WARD w ON w.WRD_ID_A = v.VST_WRD_ID_A
CROSS JOIN OH_HOSPITAL h
WHERE v.VST_ACTIVE = 1
  AND v.VST_DATE >= $P{fromdate}
  AND v.VST_DATE < DATE_ADD($P{todate}, INTERVAL 1 DAY)
  AND (
    $P{allDoctors} = TRUE
    OR $X{IN, v.VST_CREATED_BY, doctorIds}
  )
ORDER BY doctor_name ASC, v.VST_DATE ASC, p.PAT_NAME ASC]]>
	</queryString>
