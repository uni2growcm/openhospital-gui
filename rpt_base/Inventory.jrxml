	<queryString>
		<![CDATA[SELECT
    DATE_FORMAT(LT_DUE_DATE, '%d/%m/%Y') AS LT_DUE_DATE,
    LT_DUE_DATE,
    MDSR_CODE,
    MDSR_DESC,
    LT_ID_A,
    MINVTR_THEORETIC_QTY,
    MINVTR_REAL_QTY,
    LT_COST AS PU
FROM oh_medicaldsrinventoryrow
JOIN oh_medicaldsrinventory
    ON MINVTR_INVT_ID = MINVT_ID
JOIN oh_medicaldsr
    ON MINVTR_MDSR_ID = MDSR_ID
LEFT JOIN oh_medicaldsrlot
    ON MINVTR_LT_ID_A = LT_ID_A
WHERE MINVTR_INVT_ID = $P{inventoryId}
ORDER BY MDSR_DESC asc]]>
	</queryString>
	<field name="LT_DUE_DATE" class="java.lang.String"/>
	<field name="MDSR_CODE" class="java.lang.String"/>
	<field name="MDSR_DESC" class="java.lang.String"/>
	<field name="LT_ID_A" class="java.lang.String"/>
	<field name="MINVTR_THEORETIC_QTY" class="java.lang.Float"/>
	<field name="PU" class="java.lang.Double"/>
	<field name="MINVTR_REAL_QTY" class="java.lang.Float"/>
	<variable name="total_final" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{calcul_total}.plus()]]></variableExpression>
	</variable>
	<variable name="calcul_total" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal(Double.toString($F{MINVTR_REAL_QTY}.doubleValue() * $F{PU}.doubleValue()))]]></variableExpression>
	</variable>
	<variable name="STOCK_TOTAL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[new BigDecimal(Double.toString($F{MINVTR_REAL_QTY}.doubleValue() * $F{PU}.doubleValue()))]]></variableExpression>
	</variable>
