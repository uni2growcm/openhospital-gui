              whenResourceMissingType="Key" 
              uuid="bb720af0-a19c-4020-9487-e2cf3b50ac5f">
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="java.text.SimpleDateFormat"/>
	<import value="java.util.Date"/>
	<parameter name="Hospital" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="PregId" class="java.lang.Object"/>
	<parameter name="PathLogoImage" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
    pr.PRG_ID,
    CONCAT('Grossesse ', DENSE_RANK() OVER (PARTITION BY pr.PRG_PAT_ID ORDER BY pr.PRG_DATE ASC)) AS PREGNANCY_NUM,
    DATE_FORMAT(pr.PRG_DATE, '%d/%m/%Y') AS PRG_DATE_STR,
    DATE_FORMAT(pr.PRG_LMP, '%d/%m/%Y') AS PRG_LMP_STR,
    DATE_FORMAT(COALESCE(pr.PRG_EDD_LMP, pr.PRG_EDD_SCAN), '%d/%m/%Y') AS PRG_EDD_STR,
    CONCAT('G', COALESCE(pr.PRG_GRAVIDITY, 0), ' P', COALESCE(pr.PRG_PARITY, 0), ' A', COALESCE(pr.PRG_MISSCARRIAGES, 0), ' EV', COALESCE(pr.PRG_LIVING_CHILDREN, 0)) AS OBS_FORMULA,
    COALESCE(pr.PRG_RISK_LEVEL, 'LOW') AS PRG_RISK_LEVEL,
    COALESCE(pr.PRG_STATUS, 'ONGOING') AS PRG_STATUS,
    pat.PAT_ID,
    pat.PAT_NAME,
    IF(pat.PAT_BDATE IS NOT NULL, TIMESTAMPDIFF(YEAR, pat.PAT_BDATE, CURDATE()), pat.PAT_AGE) AS PAT_AGE,
    COALESCE(NULLIF(pat.PAT_BTYPE, ''), '-') AS PAT_BLOOD_TYPE,
    COALESCE(pat.PAT_TELE, '-') AS PAT_TELEPHONE,
    COALESCE(pat.PAT_CITY, '-') AS PAT_CITY,
    COALESCE(pat.PAT_ADDR, '-') AS PAT_ADDRESS,
    pv.PRGV_ID,
    DATE_FORMAT(pv.PRGV_DATE, '%d/%m/%Y') AS VISIT_DATE_STR,
    COALESCE(ty.TYPO_DESCRIPTION, pv.PRGV_TYPE_ID, 'CPN') AS VISIT_TYPE,
    IF(pr.PRG_LMP IS NOT NULL, CONCAT(TIMESTAMPDIFF(WEEK, pr.PRG_LMP, pv.PRGV_DATE), ' SA'), '-') AS GESTATIONAL_AGE,
    IF(pv.PRGV_MATERNAL_WEIGHT IS NOT NULL, CONCAT(ROUND(pv.PRGV_MATERNAL_WEIGHT, 1), ' kg'), '-') AS MATERNAL_WEIGHT,
    IF(pv.PRGV_SYSTOLIC_BP IS NOT NULL AND pv.PRGV_DIASTOLIC_BP IS NOT NULL, CONCAT(pv.PRGV_SYSTOLIC_BP, '/', pv.PRGV_DIASTOLIC_BP), '-') AS BLOOD_PRESSURE,
    IF(pv.PRGV_FUNDAL_HEIGHT IS NOT NULL, CONCAT(ROUND(pv.PRGV_FUNDAL_HEIGHT, 0), ' cm'), '-') AS FUNDAL_HEIGHT,
    IF(pv.PRGV_FETAL_HEART_RATE IS NOT NULL, CONCAT(pv.PRGV_FETAL_HEART_RATE, ' bpm'), '-') AS FETAL_HEART_RATE,
    COALESCE(pv.PRGV_FETAL_PRESENTATION, '-') AS FETAL_PRESENTATION,
    CONCAT(COALESCE(pv.PRGV_URINE_PROTEIN, '-'), ' / ', COALESCE(pv.PRGV_URINE_GLUCOSE, '-')) AS URINE_TEST,
    DATE_FORMAT(pv.PRGV_NEXT_APPOINTMENT_DATE, '%d/%m/%Y') AS NEXT_APP_STR,
    COALESCE(pv.PRGV_CLINICAL_NOTES, '-') AS CLINICAL_NOTES
FROM OH_PREGNANCY pr
JOIN OH_PATIENT pat ON pat.PAT_ID = pr.PRG_PAT_ID
LEFT JOIN OH_PREGNANCYVISIT pv ON pv.PRGV_PRG_ID = pr.PRG_ID AND (pv.PRGV_ACTIVE = 1 OR pv.PRGV_ACTIVE IS TRUE)
LEFT JOIN OH_TYPOLOGIES ty ON ty.TYPO_CODE = pv.PRGV_TYPE_ID
WHERE pr.PRG_PAT_ID = (SELECT PRG_PAT_ID FROM OH_PREGNANCY WHERE PRG_ID = $P{PregId})
ORDER BY pr.PRG_DATE ASC, pr.PRG_ID ASC, pv.PRGV_DATE ASC, pv.PRGV_ID ASC;]]>
	</queryString>
