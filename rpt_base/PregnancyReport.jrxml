	<parameter name="PathLogoImage" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    CONCAT('Pregnancy ', DENSE_RANK() OVER (PARTITION BY PR.PRG_PAT_ID ORDER BY PR.PRG_DATE ASC)) AS PREGNANCY_NUM,

    COUNT(PR.PRG_ID) OVER (PARTITION BY PR.PRG_PAT_ID) AS TOTAL_PREGNANCY,

    PR.*,
    PA.PAT_NAME,
    VI.PRGV_ID,
    VI.PRGV_DATE,
    IF(VI.PRGV_DATE > VID.PRGDLV_DATE, 'Postnatal', 'Prenatal') AS PRGV_TYPE,
    LAB.LAB_NOTE,
    LAB.LAB_RES,
    EX.EXA_DESC
FROM OH_PREGNANCY PR
LEFT JOIN OH_PATIENT PA ON PR.PRG_PAT_ID = PA.PAT_ID
LEFT JOIN OH_PREGNANCYVISIT VI ON VI.PRGV_PRG_ID = PR.PRG_ID
LEFT JOIN OH_PREGNANCYDELIVERY VID ON PR.PRG_ID = VID.PRGDLV_PRG_ID
LEFT JOIN OH_LABORATORY LAB ON LAB.LAB_PAT_ID = PA.PAT_ID
LEFT JOIN OH_EXAM EX ON EX.EXA_ID_A = LAB.LAB_EXA_ID_A
WHERE PR.PRG_ID = $P{PregId}
  AND LAB.LAB_DATE <= PR.PRG_DATE
ORDER BY PR.PRG_DATE ASC, VI.PRGV_ID DESC;]]>
	</queryString>
