	<parameter name="HEADER_BUNDLE" class="java.util.ResourceBundle" isForPrompting="false">
		<defaultValueExpression><![CDATA[java.util.ResourceBundle.getBundle("ReportHeader", $P{REPORT_LOCALE} != null ? $P{REPORT_LOCALE} : java.util.Locale.getDefault())]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT M.*, SUM(MDSR_INI_STOCK_QTI + MDSR_IN_QTI - MDSR_OUT_QTI) AS QTY 
FROM OH_MEDICALDSR M
GROUP BY MDSR_ID
HAVING (
    $P{includeNonZeroQty} = false 
    OR (
        SUM(MDSR_INI_STOCK_QTI + MDSR_IN_QTI - MDSR_OUT_QTI) <= COALESCE(MDSR_MIN_STOCK_QTI, 0)
        AND MDSR_MIN_STOCK_QTI IS NOT NULL 
        AND MDSR_MIN_STOCK_QTI > 0
    )
    OR SUM(MDSR_INI_STOCK_QTI + MDSR_IN_QTI - MDSR_OUT_QTI) = 0
)
ORDER BY MDSR_DESC]]>
	</queryString>
	<field name="MDSR_ID" class="java.lang.Integer"/>
	<field name="MDSR_MDSRT_ID_A" class="java.lang.String"/>
	<field name="MDSR_CODE" class="java.lang.String"/>
	<field name="MDSR_DESC" class="java.lang.String"/>
	<field name="MDSR_MIN_STOCK_QTI" class="java.lang.Float"/>
	<field name="MDSR_INI_STOCK_QTI" class="java.lang.Float"/>
	<field name="MDSR_PCS_X_PCK" class="java.lang.Integer"/>
	<field name="MDSR_IN_QTI" class="java.lang.Float"/>
	<field name="MDSR_OUT_QTI" class="java.lang.Float"/>
	<field name="MDSR_LOCK" class="java.lang.Integer"/>
	<field name="QTY" class="java.lang.Double"/>
	<variable name="ORDER" class="java.lang.Double">
		<variableExpression><![CDATA[new Double ($F{QTY}.doubleValue() - $F{MDSR_MIN_STOCK_QTI}.doubleValue())]]></variableExpression>
	</variable>
