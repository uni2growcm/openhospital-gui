	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="billID" class="java.lang.String"/>
	<parameter name="cashierName" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
			BLP_DATE,
			BLP_AMOUNT,
			BLP_USR_ID_A,
			(SELECT COALESCE(SUM(BLI_ITEM_AMOUNT * BLI_QTY), 0)
			 FROM OH_BILLITEMS WHERE BLI_ID_BILL = $P{billID})
			-
			(SELECT COALESCE(SUM(BLP_AMOUNT), 0)
			 FROM OH_BILLPAYMENTS WHERE BLP_ID_BILL = $P{billID})
			AS BALANCE
		FROM OH_BILLPAYMENTS
		WHERE BLP_ID_BILL = $P{billID}
		ORDER BY BLP_DATE ASC]]>
	</queryString>
	<field name="BLP_DATE" class="java.sql.Timestamp"/>
	<field name="BLP_AMOUNT" class="java.lang.Double"/>
	<field name="BLP_USR_ID_A" class="java.lang.String"/>
	<field name="BALANCE" class="java.lang.Double"/>
	<variable name="PAID" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{BLP_AMOUNT}]]></variableExpression>
	</variable>
