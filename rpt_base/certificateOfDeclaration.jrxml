	<parameter name="Prg_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT  	
	DATE_FORMAT(PDEL.PRGDLV_DATE, '%d/%m/%Y') as PRGDLV_DATE,
	PAT_NAME,
	PAT_BIRTH_PLACE,
	PAT_TAXCODE,
	PAT_NAME,        
	DATE_FORMAT(PAT_BDATE, '%d/%m/%Y') as PAT_BDATE		
FROM oh_pregnancydelivery PDEL
	JOIN oh_pregnancy OP ON PDEL.PRGDLV_PRG_ID = OP.PRG_ID 
	JOIN oh_patient PAT ON OP.PRG_PAT_ID = PAT.PAT_ID 
WHERE OP.PRG_ID = $P{Prg_id} limit 1]]>
	</queryString>
