	<parameter name="Hospital" class="java.lang.String">
		<defaultValueExpression><![CDATA["HOPITAL HELVETIQUE DE MADA"]]></defaultValueExpression>
	</parameter>
	<parameter name="Prg_id" class="java.lang.Long">
