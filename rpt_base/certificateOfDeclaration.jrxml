	<queryString>
		<![CDATA[SELECT  	
		DATE_FORMAT(PDEL.PRGDLV_DATE, '%d/%m/%Y') as PRGDLV_DATE,
		PAT.PAT_NAME,
		PAT.PAT_BIRTH_PLACE,
		PAT.PAT_TAXCODE,       
		DATE_FORMAT(PAT.PAT_BDATE, '%d/%m/%Y') as PAT_BDATE		
		FROM oh_pregnancydelivery PDEL
		JOIN oh_pregnancy OP ON PDEL.PRGDLV_PRG_ID = OP.PRG_ID 
		JOIN oh_patient PAT ON OP.PRG_PAT_ID = PAT.PAT_ID 
		WHERE OP.PRG_ID = $P{Prg_id} LIMIT 1]]>
	</queryString>
	<field name="PRGDLV_DATE" class="java.lang.String"/>
	<field name="PAT_NAME" class="java.lang.String"/>
	<field name="PAT_BIRTH_PLACE" class="java.lang.String"/>
