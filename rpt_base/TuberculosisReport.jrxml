<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TuberculosisReport" pageWidth="1000" pageHeight="800" columnWidth="940" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" resourceBundle="TuberculosisReport" whenResourceMissingType="Key" uuid="9c03dc86-cc1d-43b8-a7ec-2f5a22f23b2a">
