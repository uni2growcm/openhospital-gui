    <parameter name="num_fiche" class="java.lang.String" isForPrompting="false"/>
    <parameter name="Region" class="java.lang.String" isForPrompting="false"/>
    <parameter name="District" class="java.lang.String" isForPrompting="false"/>
    <parameter name="AireSante" class="java.lang.String" isForPrompting="false"/>
    <parameter name="Structure" class="java.lang.String" isForPrompting="false"/>
    <parameter name="fromdate" class="java.util.Date"/>
    <parameter name="todate" class="java.util.Date"/>
    <parameter name="classification" class="java.lang.String"/>
    <parameter name="statut" class="java.lang.String"/>
    <parameter name="sexe" class="java.lang.String"/>
    <queryString>
        <![CDATA[SELECT
    p.PAT_ID AS patient_code,
    p.PAT_NAME AS patient_name,
    p.PAT_SEX AS sex,
    p.PAT_AGE AS age,

    DATE_FORMAT(tbt.TBT_REG_DATE, '%d/%m/%Y') AS registration_date,
    tbt.TBT_REG_DATE AS registration_date_sort,

    tbt.TBT_CLASSIFICATION AS classification,

    CASE
        WHEN tbt.TBT_DIAGNOSIS_DATE IS NULL THEN '—'
        ELSE DATE_FORMAT(tbt.TBT_DIAGNOSIS_DATE, '%d/%m/%Y')
    END AS diagnosis_date,

    DATE_FORMAT(tbt.TBT_TREATMENT_START_DATE, '%d/%m/%Y') AS treatment_start_date,

    tbt.TBT_STATUS AS status,
    tbt.TBT_ACTIVE AS active,
    CASE
        WHEN tbt.TBT_ACTIVE = 1 THEN 'Oui'
        ELSE 'Non'
    END AS active_display,

    CASE
        WHEN (
            SELECT MAX(tbv.TBV_VISIT_DATE)
            FROM OH_TB_VISIT tbv
            WHERE tbv.TBV_TBT_ID = tbt.TBT_ID
              AND tbv.TBV_ACTIVE = 1
        ) IS NULL THEN '—'
        ELSE DATE_FORMAT(
            (
                SELECT MAX(tbv.TBV_VISIT_DATE)
                FROM OH_TB_VISIT tbv
                WHERE tbv.TBV_TBT_ID = tbt.TBT_ID
                  AND tbv.TBV_ACTIVE = 1
            ),
            '%d/%m/%Y'
        )
    END AS last_visit_date,

    (
        SELECT COUNT(*)
        FROM OH_TB_VISIT tbv
        WHERE tbv.TBV_TBT_ID = tbt.TBT_ID
          AND tbv.TBV_ACTIVE = 1
    ) AS visit_count,

    (
        SELECT COUNT(*)
        FROM OH_TB_CONTACT tbc
        WHERE tbc.TBC_TBT_ID = tbt.TBT_ID
          AND tbc.TBC_ACTIVE = 1
    ) AS contact_count,

    h.HOS_NAME AS structure_name,
    h.HOS_CITY AS district_name,
    h.HOS_ADDR AS hos_address,
    h.HOS_TELE AS hos_telephone,
    h.HOS_EMAIL AS hos_email

FROM
    OH_TB_TREATMENT tbt
    INNER JOIN OH_PATIENT p
        ON tbt.TBT_PAT_ID = p.PAT_ID
    CROSS JOIN OH_HOSPITAL h

WHERE
    1 = 1
    AND ($P{fromdate} IS NULL OR DATE(tbt.TBT_REG_DATE) >= DATE($P{fromdate}))
    AND ($P{todate} IS NULL OR DATE(tbt.TBT_REG_DATE) <= DATE($P{todate}))
    AND ($P{classification} IS NULL OR $P{classification} = 'ALL'
         OR tbt.TBT_CLASSIFICATION = $P{classification})
    AND ($P{statut} IS NULL OR $P{statut} = 'ALL'
         OR tbt.TBT_STATUS = $P{statut})
    AND ($P{sexe} IS NULL OR $P{sexe} = 'ALL'
         OR p.PAT_SEX = $P{sexe})

ORDER BY
    tbt.TBT_REG_DATE DESC,
    p.PAT_NAME ASC]]>
    </queryString>
