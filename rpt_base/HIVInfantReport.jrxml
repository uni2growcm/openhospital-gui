	<field name="followup_start_date" class="java.lang.String"/>
	<field name="last_visit_date" class="java.lang.String"/>
	<field name="visit_count" class="java.lang.Long"/>
	<field name="status" class="java.lang.String"/>
	<field name="status_display" class="java.lang.String"/>
	<field name="feeding_type" class="java.lang.String"/>
	<field name="birth_weight" class="java.lang.Double"/>
	<field name="gestational_age" class="java.lang.Integer"/>
	<field name="active" class="java.lang.Boolean"/>
	<field name="active_display" class="java.lang.String"/>
	<field name="structure_name" class="java.lang.String"/>
	<field name="district_name" class="java.lang.String"/>
	<field name="hos_address" class="java.lang.String"/>
	<field name="hos_telephone" class="java.lang.String"/>
	<field name="hos_email" class="java.lang.String"/>
	<variable name="TOTAL_INFANTS" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{patient_code}]]></variableExpression>
	</variable>
	<variable name="TOTAL_ACTIVE" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{active} == true ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="TOTAL_INACTIVE" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{active} == false ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="TOTAL_VISITS" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{visit_count}]]></variableExpression>
	</variable>
	<variable name="TOTAL_IN_FOLLOWUP" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{status} != null && $F{status}.equals("ACTIVE") ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="TOTAL_EXITED" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{status} != null && $F{status}.equals("EXITED") ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="TOTAL_DECEASED" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{status} != null && $F{status}.equals("DECEASED") ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="TOTAL_LOST" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{status} != null && $F{status}.equals("LOST") ? 1 : 0]]></variableExpression>
	</variable>
