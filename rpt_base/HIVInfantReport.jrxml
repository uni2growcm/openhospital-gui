	<parameter name="num_fiche" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Region" class="java.lang.String" isForPrompting="false"/>
	<parameter name="District" class="java.lang.String" isForPrompting="false"/>
	<parameter name="AireSante" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Structure" class="java.lang.String" isForPrompting="false"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="statut" class="java.lang.String"/>
	<parameter name="feedingType" class="java.lang.String"/>
	<parameter name="actif" class="java.lang.Boolean"/>
	<parameter name="sexe" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    child.PAT_ID AS patient_code,
    child.PAT_NAME AS infant_name,
    child.PAT_SEX AS sex,
    child.PAT_AGE AS age,
    mother.PAT_NAME AS mother_name,

    DATE_FORMAT(hvi.HVI_REG_DATE, '%d/%m/%Y') AS registration_date,
    hvi.HVI_REG_DATE AS registration_date_sort,

    DATE_FORMAT(hvi.HVI_FOLLOWUP_START, '%d/%m/%Y') AS followup_start_date,

    hvi.HVI_STATUS AS status,
    CASE
        WHEN hvi.HVI_STATUS = 'ACTIVE' THEN 'En suivi'
        WHEN hvi.HVI_STATUS = 'EXITED' THEN 'Sorti'
        WHEN hvi.HVI_STATUS = 'DECEASED' THEN 'Décédé'
        WHEN hvi.HVI_STATUS = 'LOST' THEN 'Perdu de vue'
        ELSE hvi.HVI_STATUS
    END AS status_display,

    hvi.HVI_FEEDING_TYPE AS feeding_type,
    hvi.HVI_BIRTH_WEIGHT AS birth_weight,
    hvi.HVI_GESTATIONAL_AGE AS gestational_age,

    DATE_FORMAT(
        (SELECT MAX(v.HVV_VISIT_DATE)
         FROM OH_HIV_VISIT v
         WHERE v.HVV_HVI_ID = hvi.HVI_ID
           AND v.HVV_ACTIVE = 1),
        '%d/%m/%Y'
    ) AS last_visit_date,

    (SELECT COUNT(*)
     FROM OH_HIV_VISIT v
     WHERE v.HVV_HVI_ID = hvi.HVI_ID
       AND v.HVV_ACTIVE = 1) AS visit_count,

    hvi.HVI_ACTIVE AS active,
    CASE
        WHEN hvi.HVI_ACTIVE = 1 THEN 'Oui'
        ELSE 'Non'
    END AS active_display,

    h.HOS_NAME AS structure_name,
    h.HOS_CITY AS district_name,
    h.HOS_ADDR AS hos_address,
    h.HOS_TELE AS hos_telephone,
    h.HOS_EMAIL AS hos_email

FROM
    OH_HIV_INFANT hvi
    INNER JOIN OH_PATIENT child ON hvi.HVI_PAT_ID = child.PAT_ID
    LEFT JOIN OH_PATIENT mother ON hvi.HVI_MOTHER_PAT_ID = mother.PAT_ID
    CROSS JOIN OH_HOSPITAL h

WHERE
    1 = 1
    AND ($P{fromdate} IS NULL OR DATE(hvi.HVI_REG_DATE) >= DATE($P{fromdate}))
    AND ($P{todate} IS NULL OR DATE(hvi.HVI_REG_DATE) <= DATE($P{todate}))
    AND ($P{statut} IS NULL OR $P{statut} = 'ALL' OR hvi.HVI_STATUS = $P{statut})
    AND ($P{feedingType} IS NULL OR $P{feedingType} = 'ALL' OR hvi.HVI_FEEDING_TYPE = $P{feedingType})
    AND ($P{actif} IS NULL OR hvi.HVI_ACTIVE = $P{actif})
    AND ($P{sexe} IS NULL OR $P{sexe} = 'ALL' OR child.PAT_SEX = $P{sexe})

ORDER BY
    hvi.HVI_REG_DATE DESC,
    child.PAT_NAME ASC]]>
	</queryString>
	<field name="patient_code" class="java.lang.Integer"/>
	<field name="infant_name" class="java.lang.String"/>
	<field name="sex" class="java.lang.String"/>
	<field name="age" class="java.lang.Integer"/>
	<field name="mother_name" class="java.lang.String"/>
	<field name="registration_date" class="java.lang.String"/>
