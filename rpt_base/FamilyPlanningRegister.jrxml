	<queryString>
		<![CDATA[SELECT 
   
   p.PAT_ID AS patient_code,
    
    p.PAT_NAME AS patient,
    
    DATE_FORMAT(fp.FP_REGISTRATION_DATE, '%d/%m/%Y') AS date_inscription,
    fp.FP_REGISTRATION_DATE AS date_inscription_sort,
    
    fp.FP_STATUS AS statut,
    CASE 
        WHEN fp.FP_ACTIVE = 1 AND fp.FP_STATUS = 'ACTIVE' THEN 'Active'
        WHEN fp.FP_ACTIVE = 0 THEN 'Inactive'
        ELSE fp.FP_STATUS
    END AS statut_affichage,
    
    t.TYPO_DESCRIPTION AS methode_actuelle,
    fp.FP_CURRENT_METHOD_CODE AS methode_code,
    
    (SELECT MAX(FPV_VISIT_DATE) 
     FROM OH_FAMILYPLANNINGVISIT 
     WHERE FPV_FP_ID = fp.FP_ID 
       AND FPV_ACTIVE = 1) AS derniere_visite,
    DATE_FORMAT(
        (SELECT MAX(FPV_VISIT_DATE) 
         FROM OH_FAMILYPLANNINGVISIT 
         WHERE FPV_FP_ID = fp.FP_ID 
           AND FPV_ACTIVE = 1),
        '%d/%m/%Y'
    ) AS derniere_visite_format,
    
    (SELECT FPV_NEXT_APP_DATE 
     FROM OH_FAMILYPLANNINGVISIT 
     WHERE FPV_FP_ID = fp.FP_ID 
       AND FPV_ACTIVE = 1 
     ORDER BY FPV_VISIT_DATE DESC 
     LIMIT 1) AS prochain_rdv,
    CASE 
        WHEN (SELECT FPV_NEXT_APP_DATE 
              FROM OH_FAMILYPLANNINGVISIT 
              WHERE FPV_FP_ID = fp.FP_ID 
                AND FPV_ACTIVE = 1 
              ORDER BY FPV_VISIT_DATE DESC 
              LIMIT 1) IS NULL THEN '—'
        ELSE DATE_FORMAT(
            (SELECT FPV_NEXT_APP_DATE 
             FROM OH_FAMILYPLANNINGVISIT 
             WHERE FPV_FP_ID = fp.FP_ID 
               AND FPV_ACTIVE = 1 
             ORDER BY FPV_VISIT_DATE DESC 
             LIMIT 1),
            '%d/%m/%Y'
        )
    END AS prochain_rdv_format,
    
    (SELECT COUNT(*) 
     FROM OH_FAMILYPLANNINGVISIT 
     WHERE FPV_FP_ID = fp.FP_ID 
       AND FPV_ACTIVE = 1) AS nb_visites,
    
    fp.FP_ACTIVE AS actif,
    CASE 
        WHEN fp.FP_ACTIVE = 1 THEN 'Oui'
        ELSE 'Non'
    END AS actif_affichage,
    
    h.HOS_NAME AS structure_name,
    h.HOS_CITY AS district_name,
    h.HOS_ADDR AS hos_address,
    h.HOS_TELE AS hos_telephone,
    h.HOS_EMAIL AS hos_email

FROM 
    OH_FAMILYPLANNING fp
    INNER JOIN OH_PATIENT p ON fp.FP_PAT_ID = p.PAT_ID
    LEFT JOIN OH_TYPOLOGIES t ON fp.FP_CURRENT_METHOD_CODE = t.TYPO_CODE
    CROSS JOIN oh_hospital h

WHERE 
    1=1
    AND ($P{fromdate} IS NULL OR DATE(fp.FP_REGISTRATION_DATE) >= DATE($P{fromdate}))
    AND ($P{todate} IS NULL OR DATE(fp.FP_REGISTRATION_DATE) <= DATE($P{todate}))
    AND ($P{statut} IS NULL OR $P{statut} = 'ALL' OR fp.FP_STATUS = $P{statut})
    AND ($P{methodCode} IS NULL OR $P{methodCode} = 'ALL' OR fp.FP_CURRENT_METHOD_CODE = $P{methodCode})
    AND ($P{actif} IS NULL OR fp.FP_ACTIVE = $P{actif})
    AND ($P{sexe} IS NULL OR $P{sexe} = 'ALL' OR p.PAT_SEX = $P{sexe})

ORDER BY 
    fp.FP_REGISTRATION_DATE DESC,
    p.PAT_NAME ASC]]>
	</queryString>
