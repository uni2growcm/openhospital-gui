	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="java.text.SimpleDateFormat"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="Hospital" class="java.lang.String"/>
	<parameter name="Address" class="java.lang.String"/>
	<parameter name="City" class="java.lang.String"/>
	<parameter name="Email" class="java.lang.String"/>
	<parameter name="Telephone" class="java.lang.String"/>
	<parameter name="fromdate" class="java.lang.String"/>
	<parameter name="todate" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    LEFT(BI.BLI_ID_PRICE, 3) AS FAMILY_CODE,
    BI.BLI_ITEM_DESC,
    SUM(BI.BLI_QTY) AS TOTAL_QTY_ITEM,
    SUM(BI.BLI_ITEM_AMOUNT * BI.BLI_QTY) AS TOTAL_AMOUNT_ITEM
FROM OH_BILLITEMS BI
JOIN OH_BILLS B ON BI.BLI_ID_BILL = B.BLL_ID
WHERE B.BLL_STATUS = 'C'
  AND DATE(B.BLL_UPDATE) BETWEEN STR_TO_DATE($P{fromdate}, '%Y-%m-%d') AND STR_TO_DATE($P{todate}, '%Y-%m-%d')
GROUP BY FAMILY_CODE, BI.BLI_ITEM_DESC
ORDER BY
    CASE FAMILY_CODE
        WHEN 'EXA' THEN 1
        WHEN 'MED' THEN 2
        WHEN 'OPE' THEN 3
        WHEN 'OTH' THEN 4
        ELSE 5
    END,
    BI.BLI_ITEM_DESC]]>
	</queryString>
	<field name="FAMILY_CODE" class="java.lang.String"/>
	<field name="BLI_ITEM_DESC" class="java.lang.String"/>
	<field name="TOTAL_QTY_ITEM" class="java.lang.Long"/>
	<field name="TOTAL_AMOUNT_ITEM" class="java.lang.Double"/>
	<variable name="FAMILY_LABEL" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{FAMILY_CODE}.equals("EXA") ? $R{famille_exa} :
$F{FAMILY_CODE}.equals("MED") ? $R{famille_med} :
$F{FAMILY_CODE}.equals("OPE") ? $R{famille_ope} :
$F{FAMILY_CODE}.equals("OTH") ? $R{famille_oth} :
$R{famille_autre}]]></variableExpression>
	</variable>
	<variable name="TOTAL_AMOUNT" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_AMOUNT_ITEM}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="TOTAL_QTY" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_QTY_ITEM}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="TOTAL_AMOUNT_FAMILY" class="java.lang.Double" resetType="Group" resetGroup="Family Group" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_AMOUNT_ITEM}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="TOTAL_QTY_FAMILY" class="java.lang.Double" resetType="Group" resetGroup="Family Group" calculation="Sum">
