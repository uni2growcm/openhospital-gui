	<style name="UnderCriticalLevel">
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean( $F{STOCK}.floatValue() < $F{MDSR_MIN_STOCK_QTI}.floatValue() )]]></conditionExpression>
			<style forecolor="#FF0000"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean( $F{STOCK}.floatValue() >= $F{MDSR_MIN_STOCK_QTI}.floatValue() )]]></conditionExpression>
			<style forecolor="#000000"/>
		</conditionalStyle>
	</style>
	<parameter name="Hospital" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Date" class="java.lang.String" isForPrompting="false"/>
	<parameter name="todate" class="java.lang.String"/>
	<parameter name="groupBy" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["%"]]></defaultValueExpression>
	</parameter>
	<parameter name="sortBy" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["MDSRT_DESC, MDSR_DESC"]]></defaultValueExpression>
	</parameter>
	<parameter name="filter" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["%"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    MDSR_ID,
    MDSRT_DESC,
    MDSR_CODE,
    MDSR_DESC,
    MDSR_MIN_STOCK_QTI,
    SUM(QTY_INPUT - QTY_OUTPUT) AS STOCK,
    COALESCE(SUM(CHARGE - DISCHARGE), 0.0) AS VALUE,
    COALESCE(SUM(CHARGE - DISCHARGE) / NULLIF(SUM(QTY_INPUT - QTY_OUTPUT), 0), 0.0) AS AVG_COST
FROM (
    
    SELECT 
        MDSR_ID,
        MDSRT_DESC,
        MDSR_CODE,
        MDSR_DESC,
        MDSR_MIN_STOCK_QTI,
        LT_ID_A,
        LT_COST,
        SUM(INPUT) AS QTY_INPUT,
        SUM(OUTPUT) AS QTY_OUTPUT,
        COALESCE(LT_COST, 0.0) * SUM(INPUT) AS CHARGE,
        COALESCE(LT_COST, 0.0) * SUM(OUTPUT) AS DISCHARGE
        
    FROM (
        
        SELECT 
            MDSR_ID,
            MDSRT_DESC,
            MDSR_CODE,
            MDSR_DESC,
            MDSR_MIN_STOCK_QTI,
            MMV_LT_ID_A,
            MMV_MMVT_ID_A,
            
            SUM(IF(MMVT_TYPE LIKE '%+%', MMV_QTY, 0)) AS INPUT,
            SUM(IF(MMVT_TYPE LIKE '%-%', MMV_QTY, 0)) AS OUTPUT
        
        FROM OH_MEDICALDSR
        
        LEFT JOIN OH_MEDICALDSRSTOCKMOV 
            ON MDSR_ID = MMV_MDSR_ID
            
        LEFT JOIN OH_MEDICALDSRTYPE 
            ON MDSRT_ID_A = MDSR_MDSRT_ID_A
            
        LEFT JOIN OH_MEDICALDSRSTOCKMOVTYPE 
            ON MMV_MMVT_ID_A = MMVT_ID_A
            
        WHERE DATE(MMV_DATE) <= $P{todate}
          AND (
                MDSR_DESC LIKE $P{filter} 
                OR MDSR_CODE LIKE $P{filter}
              )
              
        GROUP BY 
            MDSR_ID,
            MDSRT_DESC,
            MDSR_CODE,
            MDSR_DESC,
            MDSR_MIN_STOCK_QTI,
            MMV_LT_ID_A,
            MMV_MMVT_ID_A
            
    ) AS QUANTITY
    
    JOIN OH_MEDICALDSRLOT 
        ON MMV_LT_ID_A = LT_ID_A
        
    GROUP BY 
        MDSR_ID,
        MDSRT_DESC,
        MDSR_CODE,
        MDSR_DESC,
        MDSR_MIN_STOCK_QTI,
        LT_ID_A,
        LT_COST
        
) AS VALUE

WHERE MDSRT_DESC LIKE $P{groupBy}

GROUP BY 
    MDSR_ID,
    MDSRT_DESC,
    MDSR_CODE,
    MDSR_DESC,
    MDSR_MIN_STOCK_QTI

UNION ALL 

SELECT 
    MDSR_ID,
    MDSRT_DESC,
    MDSR_CODE,
    MDSR_DESC,
    MDSR_MIN_STOCK_QTI,
    0 AS STOCK,
    0 AS VALUE,
    0.0 AS AVG_COST
    
FROM OH_MEDICALDSR

LEFT JOIN OH_MEDICALDSRTYPE 
    ON MDSRT_ID_A = MDSR_MDSRT_ID_A
    
LEFT JOIN OH_MEDICALDSRSTOCKMOV 
    ON MDSR_ID = MMV_MDSR_ID
    
WHERE MMV_MDSR_ID IS NULL
  AND MDSR_DESC LIKE $P{filter}
  AND MDSRT_DESC LIKE $P{groupBy}

ORDER BY $P!{sortBy}]]>
	</queryString>
