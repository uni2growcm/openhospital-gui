<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HomeVisitByStaff" pageWidth="535" pageHeight="400" whenNoDataType="NoDataSection" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" resourceBundle="HomeVisitByStaff" whenResourceMissingType="Key" uuid="c2000001-0002-0002-0002-000000000001">
	<property name="ireport.encoding" value="UTF-8"/>
	<parameter name="PeriodStart" class="java.util.Date"/>
	<parameter name="PeriodEnd" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT
	CONCAT(S.STF_FIRST_NAME, ' ', S.STF_LAST_NAME) AS STAFF_NAME,
	COUNT(*) AS TOTAL_COUNT,
	SUM(CASE WHEN HV.HV_STATUS = 'PLANNED'   THEN 1 ELSE 0 END) AS PLANNED_COUNT,
	SUM(CASE WHEN HV.HV_STATUS = 'COMPLETED' THEN 1 ELSE 0 END) AS COMPLETED_COUNT,
	SUM(CASE WHEN HV.HV_STATUS = 'CANCELLED' THEN 1 ELSE 0 END) AS CANCELLED_COUNT,
	SUM(CASE WHEN HV.HV_STATUS = 'POSTPONED' THEN 1 ELSE 0 END) AS POSTPONED_COUNT,
	COALESCE(SUM(TIMESTAMPDIFF(MINUTE, HV.HV_VISIT_START_DATE, HV.HV_VISIT_END_DATE)), 0) AS TOTAL_MINUTES
FROM OH_HOME_VISIT HV
JOIN OH_STAFF S ON HV.HV_STAFF_ID = S.STF_ID
WHERE HV.HV_DELETE = 1
	AND HV.HV_VISIT_START_DATE >= $P{PeriodStart}
	AND HV.HV_VISIT_START_DATE <  $P{PeriodEnd}
GROUP BY S.STF_ID, STAFF_NAME
ORDER BY TOTAL_COUNT DESC]]>
	</queryString>
	<field name="STAFF_NAME" class="java.lang.String"/>
	<field name="TOTAL_COUNT" class="java.lang.Long"/>
	<field name="PLANNED_COUNT" class="java.lang.Long"/>
	<field name="COMPLETED_COUNT" class="java.lang.Long"/>
	<field name="CANCELLED_COUNT" class="java.lang.Long"/>
	<field name="POSTPONED_COUNT" class="java.lang.Long"/>
	<field name="TOTAL_MINUTES" class="java.lang.Long"/>
