	<parameter name="exam" class="java.lang.String" isForPrompting="false"/>
	<parameter name="resultFilter" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="patientCode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="userCode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="name" class="java.lang.String" isForPrompting="false"/>
	<parameter name="patientname" class="java.lang.String" isForPrompting="false"/>
	<parameter name="paidCode" class="java.lang.String" isForPrompting="false"/>
	<parameter name="lab_auto_enabled" class="java.lang.String" isForPrompting="false"/>
	<parameter name="LOGO_PATH" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT DATE_FORMAT(LAB_DATE, "%d/%m/%Y") AS DATE, LAB_PAT_NAME,
LAB_PRESCRIBER, LAB_NOTE, EXA_PROC, EXA_DESC,
IF(EXA_PROC=1, LAB_RES, (
	SELECT GROUP_CONCAT(CONCAT(LABR_DESC, " - ", LABR_RES_VALUE) SEPARATOR ", ")
	  FROM OH_LABORATORYROW WHERE LABR_LAB_ID=LAB_ID
    )
) AS RES_VALUE
FROM OH_LABORATORY lab
INNER JOIN OH_EXAM E ON E.EXA_ID_A=LAB_EXA_ID_A
WHERE DATE(LAB_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
AND ((LAB_PRESCRIBER = $P{userCode} ) or ($P{userCode}="all"))
	 AND ((LAB_PAT_ID = $P{patientCode} and $P{patientCode} <> "all") or ( $P{patientCode} = "all" ))
	 AND ((EXA_DESC = $P{exam} and $P{exam} <> "all") or ( $P{exam} = "all" ))
	 AND ((LAB_RES <> "" and $P{resultFilter}=1) or (LAB_RES = "" and $P{resultFilter} = 0 ) or ($P{resultFilter}=-1))
 ORDER BY DATE(LAB_DATE), LAB_PAT_NAME;]]>
	</queryString>
