	<field name="LAB_PAT_NAME" class="java.lang.String"/>
	<field name="LAB_PRESCRIBER" class="java.lang.String"/>
	<field name="LAB_NOTE" class="java.lang.String"/>
	<field name="EXA_PROC" class="java.lang.Integer"/>
	<field name="EXA_DESC" class="java.lang.String"/>
	<field name="RES_VALUE" class="java.lang.String"/>
