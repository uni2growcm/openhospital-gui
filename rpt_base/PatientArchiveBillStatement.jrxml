	<queryString>
		<![CDATA[SELECT 	BLL_ID, 
	BLL_DATE, 
	BLL_UPDATE, 
	CONCAT(BLL_ID_PAT, " - ", BLL_PAT_NAME) AS PAT_NAME, 
	BLL_AMOUNT, 
    BLL_AMOUNT AS BILLED,
	SUM(BLP_AMOUNT) AS INCOME,
	BLL_BALANCE AS RECEIVABLES,
	BLL_BALANCE, 
	BLL_STATUS
	FROM (
		SELECT * FROM OH_ARCHIVEBILLS LEFT JOIN OH_ARCHIVEBILLPAYMENTS ON BLL_ID = BLP_ID_BILL
		AND BLL_ID_PAT = $P{patientID}
	) AS BILLS_PLUS_PAYMENTS

GROUP BY BLL_ID
ORDER BY BLL_DATE]]>
	</queryString>
