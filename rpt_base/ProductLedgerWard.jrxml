	<parameter name="num_fiche" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Region" class="java.lang.String" isForPrompting="false"/>
	<parameter name="District" class="java.lang.String" isForPrompting="false"/>
	<parameter name="AireSante" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Structure" class="java.lang.String" isForPrompting="false"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="productID" class="java.lang.String"/>
	<parameter name="Currency" class="java.lang.String"/>
	<parameter name="WardCode" class="java.lang.String"/>
	<parameter name="WardName" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    t.*,
    h.HOS_NAME as STRUCTURE_NAME, 
    h.HOS_CITY as DISTRICT_NAME,
    h.HOS_ADDR as HOS_ADDRESS,
    h.HOS_TELE as HOS_TELEPHONE,
    h.HOS_EMAIL as HOS_EMAIL
FROM (
    SELECT * FROM (
        -- Opening
        SELECT "1" AS ORDERING_FIELD,
               null AS MOVE_ID,
               DATE($P{fromdate}) AS MOV_DATE,
               (SELECT MDSR_CODE FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_CODE,
               (SELECT MDSR_DESC FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_DESC,
               (SELECT MDSRT_DESC FROM OH_MEDICALDSR JOIN OH_MEDICALDSRTYPE ON MDSR_MDSRT_ID_A = MDSRT_ID_A WHERE MDSR_ID = $P{productID}) AS MDSRT_DESC,
               0 AS IS_PATIENT,
               "Opening" AS MOV_TYPE,
               "Opening Balance" AS REASON,
               (SELECT SUM(MMV_QTY) 
                FROM OH_MEDICALDSRSTOCKMOV 
                WHERE MMV_MDSR_ID = $P{productID} 
                  AND MMV_WRD_ID_A = $P{WardCode}) AS IN_QTY,
               SUM(MMVN_MDSR_QTY) AS OUT_QTY,
               (SELECT AVG(LT_COST) 
                FROM OH_MEDICALDSRLOT 
                WHERE LT_MDSR_ID = $P{productID}) AS COST
        FROM OH_MEDICALDSRSTOCKMOVWARD
        WHERE DATE(MMVN_DATE) < DATE($P{fromdate})
          AND MMVN_WRD_ID_A = $P{WardCode}
          AND MMVN_MDSR_ID = $P{productID}
        GROUP BY MDSR_CODE, MDSR_DESC, MDSRT_DESC

        UNION

        SELECT "2" AS ORDERING_FIELD,
               MOVE_ID,
               MOV_DATE,
               MDSR_CODE,
               MDSR_DESC,
               MDSRT_DESC,
               IS_PATIENT,
               MOV_TYPE,
               REASON,
               SUM(IF(IN_QTY - OUT_QTY > 0, IN_QTY, 0)) AS IN_QTY,
               SUM(IF(IN_QTY - OUT_QTY > 0, 0, OUT_QTY)) AS OUT_QTY,
               COST
        FROM (
            SELECT * FROM (
                SELECT
                    MMVN_ID AS MOVE_ID,
                    MMVN_DATE AS MOV_DATE,
                    (SELECT MDSR_CODE FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_CODE,
                    (SELECT MDSR_DESC FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_DESC,
                    (SELECT MDSRT_DESC FROM OH_MEDICALDSR JOIN OH_MEDICALDSRTYPE ON MDSR_MDSRT_ID_A = MDSRT_ID_A WHERE MDSR_ID = $P{productID}) AS MDSRT_DESC,
                    MMVN_IS_PATIENT AS IS_PATIENT,
                    IF (MMVN_IS_PATIENT = 1 AND MMVN_MDSR_QTY < 0, "Return",
                        IF(MMVN_IS_PATIENT = 1 AND MMVN_MDSR_QTY > 0, "Patient",
                            IF(MMVN_WRD_ID_A_FROM IS NOT NULL OR MMVN_WRD_ID_A_TO IS NOT NULL, "Ward",
                                "Rectify"))) AS MOV_TYPE,
                    IF (MMVN_IS_PATIENT = 1 AND MMVN_MDSR_QTY < 0, "Return by Patient",
                        IF(MMVN_IS_PATIENT = 1 AND MMVN_MDSR_QTY > 0, "Discharge to Patient",
                            IF(MMVN_WRD_ID_A_FROM IS NOT NULL, CONCAT("Transfer from Ward: ", (SELECT WRD_NAME FROM OH_WARD WHERE WRD_ID_A = MMVN_WRD_ID_A_FROM)),
                                 IF(MMVN_WRD_ID_A_TO IS NOT NULL, CONCAT("Transfer to Ward: ", (SELECT WRD_NAME FROM OH_WARD WHERE WRD_ID_A = MMVN_WRD_ID_A_TO)),
                            "Rectify / Inventory")))) AS REASON,
                    IF (MMVN_MDSR_QTY < 0, -MMVN_MDSR_QTY, 0) AS IN_QTY,
                    IF (MMVN_MDSR_QTY > 0, MMVN_MDSR_QTY, 0) AS OUT_QTY,
                    null AS COST
                FROM OH_MEDICALDSRSTOCKMOVWARD
                    LEFT JOIN OH_WARD ON MMVN_WRD_ID_A = WRD_ID_A
                    LEFT JOIN OH_MEDICALDSR ON MMVN_MDSR_ID = MDSR_ID
                WHERE DATE(MMVN_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
                    AND MMVN_WRD_ID_A = $P{WardCode}
                    AND MMVN_MDSR_ID = $P{productID}
                UNION
                SELECT
                    MMV_ID AS MOVE_ID,
                    MMV_DATE AS MOV_DATE,
                    (SELECT MDSR_CODE FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_CODE,
                    (SELECT MDSR_DESC FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_DESC,
                    (SELECT MDSRT_DESC FROM OH_MEDICALDSR JOIN OH_MEDICALDSRTYPE ON MDSR_MDSRT_ID_A = MDSRT_ID_A WHERE MDSR_ID = $P{productID}) AS MDSRT_DESC,
                    0 AS IS_PATIENT,
                    "Income" AS MOV_TYPE,
                    CONCAT("From MAINSTORE: ", MMVT_DESC) AS REASON,
                    MMV_QTY AS IN_QTY,
                    0 AS OUT_QTY,
                    LT_COST AS COST
                FROM OH_MEDICALDSRSTOCKMOV
                    LEFT JOIN OH_WARD ON MMV_WRD_ID_A = WRD_ID_A
                    LEFT JOIN OH_MEDICALDSR ON MMV_MDSR_ID = MDSR_ID
                    LEFT JOIN OH_MEDICALDSRSTOCKMOVTYPE ON MMV_MMVT_ID_A = MMVT_ID_A
                    LEFT JOIN OH_MEDICALDSRLOT ON MMV_LT_ID_A = LT_ID_A
                WHERE DATE(MMV_DATE) BETWEEN DATE($P{fromdate}) AND DATE($P{todate})
                    AND MMV_WRD_ID_A = $P{WardCode}
                    AND MMV_MDSR_ID = $P{productID}
            ) AS MOVEMENTS
            ORDER BY MOV_DATE
        ) AS MOVEMENTS_ORDERED
        GROUP BY YEAR(MOV_DATE), MONTH(MOV_DATE), DAY(MOV_DATE), MOV_TYPE

        UNION

        -- Closing
        SELECT "3" AS ORDERING_FIELD,
               null AS MOVE_ID,
               DATE($P{todate}) AS MOV_DATE,
               (SELECT MDSR_CODE FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_CODE,
               (SELECT MDSR_DESC FROM OH_MEDICALDSR WHERE MDSR_ID = $P{productID}) AS MDSR_DESC,
               (SELECT MDSRT_DESC FROM OH_MEDICALDSR JOIN OH_MEDICALDSRTYPE ON MDSR_MDSRT_ID_A = MDSRT_ID_A WHERE MDSR_ID = $P{productID}) AS MDSRT_DESC,
               0 AS IS_PATIENT,
               "Closing" AS MOV_TYPE,
               "Closing Balance" AS REASON,
               (SELECT SUM(MMV_QTY) 
                FROM OH_MEDICALDSRSTOCKMOV 
                WHERE MMV_MDSR_ID = $P{productID} 
                  AND MMV_WRD_ID_A = $P{WardCode}) AS IN_QTY,
               SUM(MMVN_MDSR_QTY) AS OUT_QTY,
               null AS COST
        FROM OH_MEDICALDSRSTOCKMOVWARD
        WHERE DATE(MMVN_DATE) <= DATE($P{todate})
          AND MMVN_WRD_ID_A = $P{WardCode}
          AND MMVN_MDSR_ID = $P{productID}
        GROUP BY MDSR_CODE, MDSR_DESC, MDSRT_DESC
    ) AS BEGIN_MOV_END
) t
CROSS JOIN oh_hospital h
ORDER BY t.ORDERING_FIELD ASC, t.MOV_DATE ASC]]>
	</queryString>
