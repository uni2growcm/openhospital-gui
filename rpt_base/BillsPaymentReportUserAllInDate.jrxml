					<font fontName="SansSerif" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression><![CDATA[$V{PAID} != null ? $V{PAID} : 0d]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
