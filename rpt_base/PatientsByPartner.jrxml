	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<parameter name="Hospital" class="java.lang.String"/>
	<parameter name="Address" class="java.lang.String"/>
	<parameter name="City" class="java.lang.String"/>
	<parameter name="Email" class="java.lang.String"/>
	<parameter name="Telephone" class="java.lang.String"/>
	<parameter name="partnerId" class="java.lang.Integer"/>
	<parameter name="reductionPlanId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
  prt.PRT_ID AS partner_id,
  prt.PRT_NAME AS partner_name,
  prt.PRT_PRIORITY AS partner_priority,
  t.TYPO_DESCRIPTION AS partner_type,
  p.PAT_ID AS patient_code,
  p.PAT_NAME AS patient_name,
  p.PAT_AGE AS patient_age,
  p.PAT_SEX AS patient_sex,
  p.PAT_TELE AS patient_telephone,
  p.PAT_CITY AS patient_city,
  (SELECT GROUP_CONCAT(rp.RP_DESCRIPTION ORDER BY rp.RP_DESCRIPTION SEPARATOR ', ')
     FROM OH_PATIENT_REDUCTIONPLANS prp
     INNER JOIN OH_REDUCTIONPLAN rp ON rp.RP_ID = prp.PRP_RP_ID
    WHERE prp.PRP_PAT_ID = p.PAT_ID
      AND prp.PRP_ACTIVE = 1
      AND rp.RP_DELETED = 0
      AND rp.RP_PRT_ID = prt.PRT_ID) AS reduction_plans,
  (SELECT f.RP_DESCRIPTION FROM OH_REDUCTIONPLAN f WHERE f.RP_ID = $P{reductionPlanId}) AS filter_plan
FROM OH_PATIENT_PARTNERS pp
INNER JOIN OH_PARTNERS prt ON prt.PRT_ID = pp.PP_PRT_ID
INNER JOIN OH_PATIENT p ON p.PAT_ID = pp.PP_PAT_ID
LEFT JOIN OH_TYPOLOGIES t ON t.TYPO_CODE = prt.PRT_TYPE
WHERE prt.PRT_ACTIVE = 1
  AND (p.PAT_DELETED = 'N' OR p.PAT_DELETED IS NULL)
  AND ($P{partnerId} IS NULL OR prt.PRT_ID = $P{partnerId})
  AND ($P{reductionPlanId} IS NULL OR EXISTS (
        SELECT 1 FROM OH_PATIENT_REDUCTIONPLANS x
         WHERE x.PRP_PAT_ID = p.PAT_ID
           AND x.PRP_RP_ID = $P{reductionPlanId}
           AND x.PRP_ACTIVE = 1))
ORDER BY prt.PRT_PRIORITY ASC, prt.PRT_NAME ASC, p.PAT_NAME ASC]]>
	</queryString>
