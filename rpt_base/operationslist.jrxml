	<queryString>
		<![CDATA[select OCL_DESC, OPE_DESC, 
		case
			when OPE_FOR = 1 then 'OPD/IPD' 
			when OPE_FOR = 2 then 'IPD'
			when OPE_FOR = 3 then 'OPD'
			else ''
		end as OPEFOR		
		from OH_OPERATION, OH_OPERATIONTYPE
		where OPE_OCL_ID_A = OCL_ID_A
		order by OCL_DESC, OPE_DESC]]>
	</queryString>
	<field name="OCL_DESC" class="java.lang.String"/>
	<field name="OPE_DESC" class="java.lang.String"/>
	<field name="OPEFOR" class="java.lang.String"/>
